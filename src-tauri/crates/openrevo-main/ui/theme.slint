export global AppTheme {
    // 0: Dark (Default), 1: Light, 2: Mono (Geek High-Contrast)
    in-out property <int> theme_mode: 0;

    // Helper checks
    out property <bool> is_dark: theme_mode != 1;
    out property <bool> is_mono: theme_mode == 2;
    out property <bool> is_light: theme_mode == 1;

    // --- 1. Surfaces & Backgrounds ---
    in-out property <color> bg_root: #0b0e14;
    in-out property <color> surface_base: #10141d;
    in-out property <color> surface_card: #161b24;
    in-out property <color> surface_card_hover: #1f2633;
    in-out property <color> surface_pill: #202736;
    in-out property <color> surface_elevated: #1b212c;
    in-out property <color> surface_sunken: #080a0f;

    // --- 2. Borders & Dividers ---
    in-out property <color> border_subtle: #1f2736;
    in-out property <color> border_medium: #2e384d;
    in-out property <color> border_highlight: #475569;

    // --- 3. Typography ---
    in-out property <color> text_primary: #f8fafc;
    in-out property <color> text_secondary: #cbd5e1;
    in-out property <color> text_muted: #64748b;
    in-out property <string> font_family: "";

    // --- 4. Semantic Accents (Mode / Fans / Hardware) ---
    in-out property <color> accent_brand: #6366f1;
    in-out property <color> mode_office: #10b981;
    in-out property <color> mode_balance: #3b82f6;
    in-out property <color> mode_beast: #f43f5e;
    in-out property <color> accent_fan: #06b6d4;
    in-out property <color> accent_gold: #f59e0b;

    // --- 5. Interactive & Navigation States ---
    in-out property <color> accent_active: #38bdf8;
    in-out property <color> accent_active_bg: #38bdf81a;
    in-out property <color> accent_active_border: #38bdf860;

    in-out property <color> accent_heart: #f43f5e;
    in-out property <color> accent_heart_bg: #f43f5e18;
    in-out property <color> accent_heart_border: #f43f5e60;

    in-out property <color> tag_brand_text: #ffffff;

    // --- 6. Geometry Standards ---
    in-out property <length> radius_xs: 4px;
    in-out property <length> radius_sm: 6px;
    in-out property <length> radius_md: 8px;
    in-out property <length> radius_lg: 12px;

    // --- 7. Background Image ---
    in-out property <image> bg_image;
    in-out property <float> bg_image_opacity: 0.30;
}
