        set_water_led_color(r, g, b) => { root.set_water_led_color(r, g, b); }

        open_water_device_selector => { root.open_water_device_selector(); }
        close_water_device_selector => { root.close_water_device_selector(); }
        refresh_water_devices => { root.refresh_water_devices(); }
        select_water_device(mac) => { root.select_water_device(mac); }

        // System Settings Bindings
        autostart: root.autostart;
        toggle_autostart => { root.autostart_toggled(); }

        osd_config: root.osd_config;
        change_osd_theme(t) => { root.change_osd_theme(t); }
        change_osd_scale(s) => { root.change_osd_scale(s); }
        change_osd_position(p) => { root.change_osd_position(p); }
        toggle_osd_enabled(en) => { root.toggle_osd_enabled(en); }
        trigger_osd_preview => { root.trigger_osd_preview(); }

        unlock_battery_limit: root.unlock_battery_limit;
        show_unlock_battery_confirm <=> root.show_unlock_battery_confirm;
        toggling_unlock_battery: root.toggling_unlock_battery;
        confirm_unlock_battery => { root.confirm_unlock_battery(); }
        disable_unlock_battery => { root.disable_unlock_battery(); }

        wake_window_mode: root.wake_window_mode;
        change_wake_window_mode(m) => { root.change_wake_window_mode(m); }

        mini_auto_hide: root.mini_auto_hide;
        toggle_mini_auto_hide(en) => { root.toggle_mini_auto_hide(en); }

        use_classic_webview: root.use_classic_webview;
        toggle_classic_webview(en) => { root.toggle_classic_webview(en); }
        restart_openrevo => { root.restart_openrevo(); }

        data_dir_info: root.data_dir_info;
        show_clear_confirm <=> root.show_clear_confirm;
        clearing_data: root.clearing_data;
        show_migrate_modal <=> root.show_migrate_modal;
        migrating_data: root.migrating_data;
        open_user_data_dir => { root.open_user_data_dir(); }
        confirm_clear_user_data => { root.confirm_clear_user_data(); }
        confirm_migrate_user_data(path) => { root.confirm_migrate_user_data(path); }

        power_schemes: root.power_schemes;
        active_power_scheme_name: root.active_power_scheme_name;
        restore_plan_msg: root.restore_plan_msg;
        show_restore_plan_confirm <=> root.show_restore_plan_confirm;
        restoring_power_plan: root.restoring_power_plan;
        switch_power_scheme(guid) => { root.switch_power_scheme(guid); }
        refresh_power_schemes => { root.refresh_power_schemes(); }
        confirm_restore_power_plan => { root.confirm_restore_power_plan(); }

        is_checking_update: root.is_checking_update;
        show_update_modal <=> root.show_update_modal;
        update_data: root.update_data;
        change_update_channel(c) => { root.change_update_channel(c); }
        check_for_updates => { root.check_for_updates(); }
        start_download_update => { root.start_download_update(); }
    }
}
