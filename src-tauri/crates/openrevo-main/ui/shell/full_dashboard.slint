                gpu_name: root.gpu_name;

                // Profiles & Presets
                active_preset_name <=> root.active_preset_name;
                preset_ids <=> root.preset_ids;
                preset_names <=> root.preset_names;
                select_preset(id) => { root.tuning_select_preset(id); }

                // CPU
                temp_wall <=> root.temp_wall;
                temp_wall_enabled <=> root.temp_wall_enabled;
                temp_wall_max <=> root.temp_wall_max;
                pl1 <=> root.pl1;
                pl1_max <=> root.pl1_max;
                pl2 <=> root.pl2;
                pl2_max <=> root.pl2_max;
                pl4 <=> root.pl4;
                pl4_max <=> root.pl4_max;
                bios_oc_enabled <=> root.bios_oc_enabled;

                // GPU
                super_perf <=> root.super_perf;
                core_offset <=> root.core_offset;
                mem_offset <=> root.mem_offset;
                db_enabled <=> root.db_enabled;
                db_watts <=> root.db_watts;
                base_tgp <=> root.base_tgp;

                // Fan
                smooth_transition <=> root.smooth_transition;
                smooth_time <=> root.smooth_time;
                fan_isolated_output <=> root.fan_isolated_output;
                active_fan_tab <=> root.active_fan_tab;
                fan_linked <=> root.fan_linked;
                cpu_curve <=> root.cpu_curve;
                gpu_curve <=> root.gpu_curve;
                bld_rpm_cap <=> root.bld_rpm_cap;
                bld_boost <=> root.bld_boost;

                // Callbacks
                back_to_overview => {
                    root.is_in_tuning_view = false;
                    root.tuning_back_to_overview();
                }
                create_preset => { root.tuning_create_preset(); }
                reset_preset => { root.tuning_reset_preset(); }
                rename_preset => { root.tuning_rename_preset(); }
                export_preset => { root.tuning_export_preset(); }
                import_preset => { root.tuning_import_preset(); }
                open_preset_dir => { root.tuning_open_preset_dir(); }
                delete_preset => { root.tuning_delete_preset(); }

                // CPU
                toggle_temp_wall => {
                    root.tuning_toggle_temp_wall();
                }
                change_temp_wall(t) => {
                    root.tuning_change_temp_wall(t);
                }
                adjust_temp_wall_max(delta) => {
                    root.tuning_adjust_temp_wall_max(delta);
                }
                change_pl1(w) => {
                    root.tuning_change_pl1(w);
                }
                adjust_pl1_max(delta) => {
                    root.tuning_adjust_pl1_max(delta);
                }
                change_pl2(w) => {
                    root.tuning_change_pl2(w);
                }
                adjust_pl2_max(delta) => {
                    root.tuning_adjust_pl2_max(delta);
                }
                change_pl4(w) => {
                    root.tuning_change_pl4(w);
                }
                adjust_pl4_max(delta) => {
                    root.tuning_adjust_pl4_max(delta);
                }
                toggle_bios_oc => {
                    root.tuning_toggle_bios_oc();
                }

                // GPU
                toggle_super_perf => {
                    root.tuning_toggle_super_perf();
                }
                change_core_offset(o) => {
                    root.tuning_change_core_offset(o);
                }
                change_mem_offset(o) => {
                    root.tuning_change_mem_offset(o);
                }
                toggle_db => {
                    root.tuning_toggle_db();
                }
                change_db_watts(w) => {
                    root.tuning_change_db_watts(w);
                }

                // Fan
                toggle_smooth => {
                    root.smooth_transition = !root.smooth_transition;
                    root.tuning_toggle_smooth();
                }
                toggle_isolated => {
                    root.fan_isolated_output = !root.fan_isolated_output;
                    root.tuning_toggle_isolated();
                }
                toggle_link => {
                    root.fan_linked = !root.fan_linked;
                    root.tuning_toggle_link();
                }
                select_fan_tab(tab) => {
                    root.active_fan_tab = tab;
                    root.tuning_select_fan_tab(tab);
                }
                adjust_point(idx, delta) => {
                    root.tuning_adjust_point(idx, delta);
                }
                set_point(idx, duty) => {
                    root.tuning_set_point(idx, duty);
                }
                toggle_bld_boost => {
                    root.bld_boost = !root.bld_boost;
                    root.tuning_toggle_bld_boost();
                }
                change_bld_cap(rpm) => {
                    root.bld_rpm_cap = rpm;
                    root.tuning_change_bld_cap(rpm);
                }
                restore_bld_auto => {
                    root.bld_boost = false;
                    root.tuning_restore_bld_auto();
                }
            }

            // Tab 1: 显卡模式
            if root.active_tab == 1 && root.active_plugin_id == "": DashboardGpuView {
                vertical-stretch: 1;
                gpu_mode: root.gpu_mode;
                gpu_name: root.gpu_name;
                cpu_name: root.cpu_name;
                gpu_temp: root.gpu_temp;
                gpu_usage: root.gpu_usage;
                gpu_watts_text: root.gpu_watts_text;
                brightness: root.brightness;
                refresh_rate: root.refresh_rate;
                auto_min_hz: root.auto_min_hz;
                monitor_name: root.monitor_name;
                rates_row1: root.rates_row1;
                rates_row2: root.rates_row2;

                tuning_enabled: root.tuning_enabled;
                active_preset_id: root.active_preset_id;
                active_preset_name: root.active_display_preset_name;
                tuning_temp_k: root.tuning_temp_k;
                tuning_saturation: root.tuning_saturation;
                tuning_contrast: root.tuning_contrast;
                tuning_gamma: root.tuning_gamma;
                tuning_gain_r: root.tuning_gain_r;
                tuning_gain_g: root.tuning_gain_g;
                tuning_gain_b: root.tuning_gain_b;
                tuning_is_modified: root.tuning_is_modified;
                tuning_toast: root.tuning_toast;

                active_color_profile: root.active_color_profile;
                active_color_profile_id: root.active_color_profile_id;
                color_profiles_list: root.color_profiles_list;
                color_profiles_ids: root.color_profiles_ids;
                is_color_dirty: root.is_color_dirty;

                set_gpu_mode(mode, restart) => {
                    root.gpu_mode = mode;
                    root.gpu_mode_clicked(mode);
                }
                change_brightness(b) => {
                    root.brightness = b;
                    root.brightness_changed(b);
                }
                switch_hz(hz) => { root.switch_hz(hz); }
                toggle_auto_min_hz => { root.toggle_auto_min_hz(); }
                select_monitor(m) => { root.select_monitor(m); }
                select_monitor_index(idx) => { root.select_monitor_index(idx); }
                set_tuning_enabled(en) => {
                    root.tuning_enabled = en;
                    root.set_tuning_enabled(en);
                }
                toggle_tuning_enabled => { root.toggle_tuning_enabled(); }
                apply_tuning_preset(id) => {
                    root.active_preset_id = id;
                    root.apply_tuning_preset(id);
                }
                update_tuning_slider(key, val) => { root.update_tuning_slider(key, val); }
                reset_tuning_preset => { root.reset_tuning_preset(); }
                import_tuning_file => { root.import_tuning_file(); }
                export_tuning_file => { root.export_tuning_file(); }
                import_color_profile => { root.import_color_profile(); }
                apply_color_profile(p) => { root.apply_color_profile(p); }
                is_cloud_icc_modal_open <=> root.is_cloud_icc_modal_open;
                cloud_icc_panel_pnp: root.cloud_icc_panel_pnp;
                cloud_icc_panel_sn: root.cloud_icc_panel_sn;
                cloud_icc_bios_sn: root.cloud_icc_bios_sn;
                cloud_icc_mac: root.cloud_icc_mac;
                cloud_icc_arch: root.cloud_icc_arch;
                cloud_icc_recommended: root.cloud_icc_recommended;
                cloud_icc_mode: root.cloud_icc_mode;
                cloud_icc_is_searching: root.cloud_icc_is_searching;
                cloud_icc_status: root.cloud_icc_status;
                cloud_icc_hit_found: root.cloud_icc_hit_found;
                cloud_icc_hit_file_name: root.cloud_icc_hit_file_name;
                cloud_icc_hit_meta: root.cloud_icc_hit_meta;
                cloud_icc_hit_profiles: root.cloud_icc_hit_profiles;
                cloud_icc_selected_profile_idx <=> root.cloud_icc_selected_profile_idx;
                cloud_icc_toast: root.cloud_icc_toast;

                open_cloud_icc => { root.open_cloud_icc(); }
                refresh_cloud_icc_identity => { root.refresh_cloud_icc_identity(); }
                start_cloud_icc_search(mode) => { root.start_cloud_icc_search(mode); }
                apply_cloud_icc_profile(idx) => { root.apply_cloud_icc_profile(idx); }
                apply_all_cloud_icc_profiles => { root.apply_all_cloud_icc_profiles(); }

            }

            // Tab 2: 电源管理
            if root.active_tab == 2 && root.active_plugin_id == "": DashboardPowerView {
                vertical-stretch: 1;
                battery_percent: root.battery_percent;
                is_ac_online: root.is_ac_online;
                battery_mode: root.battery_mode;
                battery_limit: root.battery_limit;
                usb_charge_enabled: root.usb_charge_enabled;
                ac_recovery_enabled: root.ac_recovery_enabled;
                high_perf_scheme: root.high_perf_scheme;
                sleep_guard_enabled: root.sleep_guard_enabled;
                sleep_disconnect_net: root.sleep_disconnect_net;
                sleep_block_away: root.sleep_block_away;
                sleep_ignore_sysreq: root.sleep_ignore_sysreq;
                sleep_disable_wake_timers: root.sleep_disable_wake_timers;
                sleep_deep_sleep: root.sleep_deep_sleep;
                sleep_hibernate_30m: root.sleep_hibernate_30m;
                sleep_auto_office: root.sleep_auto_office;

                toggle_sleep_auto_office => { root.toggle_sleep_auto_office(); }
                toggle_master_sleep_guard => { root.toggle_master_sleep_guard(); }
                toggle_sleep_guard_option(opt) => { root.toggle_sleep_guard_option(opt); }
                toggle_power_option(opt) => { root.toggle_power_option(opt); }
                select_battery_mode(mode) => { root.select_battery_mode(mode); }
            }

            // Tab 3: RGB 灯效工坊
            if root.active_tab == 3 && root.active_plugin_id == "": DashboardLightingView {
                vertical-stretch: 1;

                sub_tab <=> root.lighting_sub_tab;
                has_lightbar: root.has_lightbar;
                has_hinge: root.has_hinge;
                has_logo: root.has_logo;
                kb_hw_desc: root.kb_hw_desc;
                lb_hw_desc: root.lb_hw_desc;
                hinge_hw_desc: root.hinge_hw_desc;
                logo_hw_desc: root.logo_hw_desc;
                is_ec_logo: root.is_ec_logo;

                sleep_minutes <=> root.sleep_minutes;
                ceremony_enabled <=> root.ceremony_enabled;
                is_previewing_ceremony: root.is_previewing_ceremony;
                save_success: root.lighting_save_success;

                kb_enabled <=> root.kb_enabled;
                kb_engine <=> root.kb_engine;
                kb_fps <=> root.kb_fps;
                kb_effect <=> root.kb_effect;
                kb_direction <=> root.kb_direction;
                kb_brightness <=> root.kb_brightness;
                kb_speed <=> root.kb_speed;
                kb_color_hex <=> root.kb_color_hex;
                kb_color <=> root.kb_color;

                lb_enabled <=> root.lb_enabled;
                lb_effect <=> root.lb_effect;
                lb_brightness <=> root.lb_brightness;
                lb_speed <=> root.lb_speed;
                lb_color_hex <=> root.lb_color_hex;
                lb_color <=> root.lb_color;

                hinge_enabled <=> root.hinge_enabled;
                hinge_effect <=> root.hinge_effect;
                hinge_brightness <=> root.hinge_brightness;
                hinge_speed <=> root.hinge_speed;
                hinge_color_hex <=> root.hinge_color_hex;
                hinge_color <=> root.hinge_color;

                logo_enabled <=> root.logo_enabled;
                logo_effect <=> root.logo_effect;
                logo_brightness <=> root.logo_brightness;
                logo_color_hex <=> root.logo_color_hex;
                logo_color <=> root.logo_color;

                topology_override_enabled <=> root.topology_override_enabled;
                topology_kb_idx <=> root.topology_kb_idx;
                topology_lb_idx <=> root.topology_lb_idx;
                topology_ambient_idx <=> root.topology_ambient_idx;
                topology_logo_idx <=> root.topology_logo_idx;

                set_sleep_timer(mins) => { root.set_lighting_sleep_timer(mins); }
                toggle_ceremony => { root.toggle_ceremony(); }
                preview_ceremony => { root.preview_ceremony(); }
                save_as_startup => { root.save_lighting_as_startup(); }
                reset_defaults(tab) => { root.reset_lighting_defaults(tab); }

                toggle_kb_enabled => { root.toggle_kb_enabled(); }
                set_kb_engine(eng) => { root.set_kb_engine(eng); }
                set_kb_fps(fps) => { root.set_kb_fps(fps); }
                set_kb_effect(eff) => { root.set_kb_effect(eff); }
                set_kb_direction(dir) => { root.set_kb_direction(dir); }
                set_kb_brightness(b) => { root.set_kb_brightness(b); }
                set_kb_speed(s) => { root.set_kb_speed(s); }
                set_kb_color(hex, c) => { root.set_kb_color(hex, c); }

                toggle_lb_enabled => { root.toggle_lb_enabled(); }
                set_lb_effect(eff) => { root.set_lb_effect(eff); }
                set_lb_brightness(b) => { root.set_lb_brightness(b); }
                set_lb_speed(s) => { root.set_lb_speed(s); }
                set_lb_color(hex, c) => { root.set_lb_color(hex, c); }

                toggle_hinge_enabled => { root.toggle_hinge_enabled(); }
                set_hinge_effect(eff) => { root.set_hinge_effect(eff); }
                set_hinge_brightness(b) => { root.set_hinge_brightness(b); }
                set_hinge_speed(s) => { root.set_hinge_speed(s); }
                set_hinge_color(hex, c) => { root.set_hinge_color(hex, c); }

                toggle_logo_enabled => { root.toggle_logo_enabled(); }
                set_logo_effect(eff) => { root.set_logo_effect(eff); }
                set_logo_brightness(b) => { root.set_logo_brightness(b); }
                set_logo_color(hex, c) => { root.set_logo_color(hex, c); }

                apply_topology(en, kb, lb, amb, logo) => { root.apply_lighting_topology(en, kb, lb, amb, logo); }
                reset_topology => { root.reset_lighting_topology(); }
            }

            // Tab 4: 水冷魔盒 (BLE)
            if root.active_tab == 4 && root.active_plugin_id == "": DashboardWaterView {
                vertical-stretch: 1;

                is_connected: root.is_water_connected;
                is_connecting: root.is_water_connecting;
                is_pairing: root.is_water_pairing;
                is_priming: root.is_water_priming;
                mac_address: root.water_mac_address;
                is_flow_ok: root.water_flow_ok;
                meter_state: root.water_meter_state;
                live_max_temp: Math.max(root.cpu_temp, root.gpu_temp);
                cpu_temp: root.cpu_temp;
                gpu_temp: root.gpu_temp;
                pump_tier: root.water_pump_tier;
                pump_voltage: root.water_pump_voltage;
                fan_duty: root.water_fan_duty;
                pump_rpm: root.water_pump_rpm;
                fan_rpm: root.water_fan_rpm;

                strategy: root.water_strategy;
                curve_template: root.water_curve_template;
                curve_temps <=> root.water_curve_temps;
                curve_duties <=> root.water_curve_duties;
                pump_start_temp <=> root.water_pump_start_temp;
                pump_turbo_temp <=> root.water_pump_turbo_temp;
                live_fan_duty: root.water_live_fan_duty;
                is_curve_dragging <=> root.is_water_curve_dragging;

                led_on: root.water_led_on;
                led_mode: root.water_led_mode;
                led_r: root.water_led_r;
                led_g: root.water_led_g;
                led_b: root.water_led_b;

                is_device_modal_open <=> root.is_water_device_modal_open;
                is_scanning_devices: root.is_water_scanning_devices;
                devices: root.water_devices;
                modal_error_msg: root.water_modal_error_msg;

                connect_cooler => { root.connect_water_cooler(); }
                disconnect_cooler => { root.disconnect_water_cooler(); }
                pair_cooler => { root.pair_water_cooler(); }
                fill_water => { root.fill_water_cooler(); }
                reset_default => { root.reset_water_cooler(); }

                update_strategy(strat) => { root.update_water_strategy(strat); }
                set_cooler_speed(tier, fan) => { root.set_water_cooler_speed(tier, fan); }
                set_curve_point(idx, t, d) => { root.set_water_curve_point(idx, t, d); }
                commit_curve => { root.commit_water_curve(); }
                pump_thresholds_changing(st, tb) => { root.water_pump_thresholds_changing(st, tb); }
                commit_pump_thresholds(st, tb) => { root.commit_water_pump_thresholds(st, tb); }
                apply_curve_template(tpl) => { root.apply_water_curve_template(tpl); }

                set_led_enabled(en) => { root.set_water_led_enabled(en); }
                set_led_mode(m) => { root.set_water_led_mode(m); }
                set_led_color(r, g, b) => { root.set_water_led_color(r, g, b); }

                open_device_selector => { root.open_water_device_selector(); }
                close_device_selector => { root.close_water_device_selector(); }
                refresh_devices => { root.refresh_water_devices(); }
                select_device(mac) => { root.select_water_device(mac); }
            }

            // Tab 5: 插件中心
            if root.active_tab == 5 && root.active_plugin_id == "": DashboardPluginsView {
                vertical-stretch: 1;
                is_overview_enabled <=> root.is_overview_enabled;
                is_gpu_enabled <=> root.is_gpu_enabled;
                is_tuning_enabled <=> root.is_tuning_enabled;
                is_lighting_enabled <=> root.is_lighting_enabled;
                is_water_enabled <=> root.is_water_enabled;
                custom_plugins <=> root.custom_plugins;

                toggle_builtin_module(id, en) => { root.toggle_builtin_module(id, en); }
                toggle_custom_plugin(id, en) => { root.toggle_custom_plugin(id, en); }
                open_plugins_dir => { root.open_plugins_dir(); }
                reload_plugins => { root.reload_plugins(); }
            }

            // Tab 6: 系统设置
            if root.active_tab == 6 && root.active_plugin_id == "": DashboardSystemView {
                vertical-stretch: 1;
                win_locked: root.win_locked;
                fn_locked: root.fn_locked;
                osd_enabled: root.osd_enabled;
                keep_awake: root.keep_awake;
                toggle_osd => { root.toggle_osd(); }
                toggle_theme => { root.toggle_theme(); }
            }

            // Tab 7: 支持作者
            if root.active_tab == 7 && root.active_plugin_id == "": DashboardSponsorView {
                vertical-stretch: 1;
            }

            // Custom Active Plugin Workspace View
            if root.active_plugin_id != "": Rectangle {
                vertical-stretch: 1;
                background: #0c1017;

                VerticalLayout {
                    spacing: 0px;
                    padding: 0px;
                    // Top Action Strip for Active Embedded Plugin
                    Rectangle {
                        height: 38px;
                        background: AppTheme.surface_card;

                        // Bottom border line
                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            background: AppTheme.border_subtle;
                        }

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            alignment: space-between;

                            // Left: Plugin Info Pill
                            HorizontalLayout {
                                alignment: start;
                                spacing: 8px;

                                Image {
                                    source: @image-url("../assets/icons/layers.svg");
                                    width: 14px;
                                    height: 14px;
                                    colorize: AppTheme.accent_active;
                                    y: (parent.height - self.height) / 2;
                                }

                                Text {
                                    text: "扩展视窗";
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: AppTheme.text_primary;
                                    vertical-alignment: center;
                                }

                                // Plugin ID Pill
                                Rectangle {
                                    height: 20px;
                                    border-radius: 4px;
                                    background: AppTheme.accent_active.with-alpha(0.12);
                                    border-width: 1px;
                                    border-color: AppTheme.accent_active.with-alpha(0.25);
                                    y: (parent.height - self.height) / 2;

                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        Text {
                                            text: root.active_plugin_id;
                                            font-size: 11px;
                                            font-weight: 600;
                                            color: AppTheme.accent_active;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Sandboxed / Running Badge
                                Rectangle {
                                    height: 20px;
                                    border-radius: 4px;
                                    background: AppTheme.surface_pill;
                                    border-width: 1px;
                                    border-color: AppTheme.border_subtle;
                                    y: (parent.height - self.height) / 2;

                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        spacing: 4px;

                                        Rectangle {
                                            width: 6px;
                                            height: 6px;
                                            border-radius: 3px;
                                            background: #10b981;
                                            y: (parent.height - self.height) / 2;
                                        }

                                        Text {
                                            text: "沙箱运行中";
                                            font-size: 10.5px;
                                            font-weight: 500;
                                            color: AppTheme.text_muted;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            // Right: Compact Action Buttons
                            HorizontalLayout {
                                alignment: end;
                                spacing: 8px;

                                // Launch Popout Window
                                Rectangle {
                                    height: 26px;
                                    border-radius: 6px;
                                    background: t_launch.has-hover ? AppTheme.accent_active.darker(10%) : AppTheme.accent_active;
                                    border-width: 1px;
                                    border-color: AppTheme.accent_active_border;
                                    y: (parent.height - self.height) / 2;

                                    animate background { duration: 100ms; }

                                    t_launch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.launch_plugin_window(root.active_plugin_id);
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 5px;

                                        Image {
                                            source: @image-url("../assets/icons/maximize2.svg");
                                            width: 12px;
                                            height: 12px;
                                            colorize: #ffffff;
                                            y: (parent.height - self.height) / 2;
                                        }

                                        Text {
                                            text: "独立视窗";
                                            font-size: 11px;
                                            font-weight: 600;
                                            color: #ffffff;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Open Plugin Dir
                                Rectangle {
                                    height: 26px;
                                    border-radius: 6px;
                                    background: t_dir.has-hover ? AppTheme.surface_card_hover : AppTheme.surface_pill;
                                    border-width: 1px;
                                    border-color: t_dir.has-hover ? AppTheme.border_highlight : AppTheme.border_subtle;
                                    y: (parent.height - self.height) / 2;

                                    animate background { duration: 100ms; }

                                    t_dir := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.open_plugin_dir(root.active_plugin_id);
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 5px;

                                        Image {
                                            source: @image-url("../assets/icons/folder.svg");
                                            width: 12px;
                                            height: 12px;
                                            colorize: AppTheme.text_secondary;
                                            y: (parent.height - self.height) / 2;
                                        }

                                        Text {
                                            text: "插件目录";
                                            font-size: 11px;
                                            font-weight: 500;
                                            color: AppTheme.text_secondary;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Reload Plugin
                                Rectangle {
                                    height: 26px;
                                    border-radius: 6px;
                                    background: t_reload.has-hover ? AppTheme.surface_card_hover : AppTheme.surface_pill;
                                    border-width: 1px;
                                    border-color: t_reload.has-hover ? AppTheme.border_highlight : AppTheme.border_subtle;
                                    y: (parent.height - self.height) / 2;

                                    animate background { duration: 100ms; }

                                    t_reload := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.reload_plugins();
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 5px;

                                        Image {
                                            source: @image-url("../assets/icons/refresh-cw.svg");
                                            width: 11px;
                                            height: 11px;
                                            colorize: AppTheme.text_secondary;
                                            y: (parent.height - self.height) / 2;
                                        }

                                        Text {
                                            text: "重新加载";
                                            font-size: 11px;
                                            font-weight: 500;
                                            color: AppTheme.text_secondary;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Return to Plugins Tab
                                Rectangle {
                                    height: 26px;
                                    border-radius: 6px;
                                    background: t_back.has-hover ? AppTheme.surface_card_hover : AppTheme.surface_pill;
                                    border-width: 1px;
                                    border-color: t_back.has-hover ? AppTheme.border_highlight : AppTheme.border_subtle;
                                    y: (parent.height - self.height) / 2;

                                    animate background { duration: 100ms; }

                                    t_back := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.active_plugin_id = "";
                                            root.active_tab = 5;
                                            root.select_plugin_tab("");
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 5px;

                                        Image {
                                            source: @image-url("../assets/icons/arrow-left.svg");
                                            width: 11px;
                                            height: 11px;
                                            colorize: AppTheme.text_muted;
                                            y: (parent.height - self.height) / 2;
                                        }

                                        Text {
                                            text: "返回列表";
                                            font-size: 11px;
                                            font-weight: 500;
                                            color: AppTheme.text_muted;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Embedded Area Host (Clean dark backdrop for WebView2 child)
                    Rectangle {
                        vertical-stretch: 1;
                        background: #0c1017;
                    }
                }
            }
        }
    }
}
