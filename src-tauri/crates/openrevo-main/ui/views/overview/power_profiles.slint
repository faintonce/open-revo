import { AppTheme } from "../../theme.slint";

export component DashboardPowerProfiles inherits Rectangle {
    background: AppTheme.surface_card;
    border-radius: 8px;
    border-width: 1px;
    border-color: AppTheme.border_subtle;
    height: 150px;

    in-out property <int> power_mode: 2; // 1: Office, 2: Balance, 3: Beast, 4: Custom
    in-out property <int> pl1_target: 75;
    in-out property <int> tgp_target: 175;
    in-out property <string> power_target_text: "";
    in-out property <bool> is_restricted: false; // Power gating: true when on battery/Type-C without unlock
    in-out property <bool> turbo_submode_supported: false;
    in-out property <bool> turbo_silent: false;
    in-out property <bool> gpu_oc_on: false;

    callback set_power_mode(int);
    // 狂暴子模式：左段固定 silent=true，右段固定 silent=false（不做取反）
    callback apply_turbo_silent(bool);
    // 复用既有 GPU OC 快捷开关（对齐 ModeSelector.tsx:108-118 的 mode-oc-chip）
    callback toggle_gpu_oc();
    callback open_custom_tuning();

    VerticalLayout {
        padding: 14px;
        spacing: 12px;

        // Header Row: Title & Subtitle + PL1/TGP Badge
        HorizontalLayout {
            alignment: space-between;

            VerticalLayout {
                spacing: 3px;
                alignment: center;
                Text {
                    text: "性能释放模式 (Power Profiles)";
                    font-size: 13.5px;
                    font-weight: 700;
                    color: AppTheme.text_primary;
                }
                Text {
                    text: power_mode == 1 ? "当前配置：办公模式 (QUIET / OFFICE) - 极致静音，适合低负载文档办公与省电环境" :
                          (power_mode == 2 ? "当前配置：均衡模式 (BALANCE / GAMING) - 日常娱乐与工作，平稳释放兼顾流畅散热" :
                          (power_mode == 3 ? "当前配置：狂暴模式 (TURBO / PERFORMANCE) - 极限性能全开，风扇高转速压榨硬件极限" :
                          "当前配置：极客自定义调校 (CUSTOM TUNING) - 用户自定义 PL1/PL2/TGP 功耗与温控策略"));
                    font-size: 10px;
                    color: AppTheme.text_muted;
                }
            }

            // Power Targets Badge
            Rectangle {
                border-radius: 6px;
                background: power_mode == 1 ? #10b98118 :
                            (power_mode == 2 ? #0284c718 :
                            (power_mode == 3 ? #f43f5e18 : #a855f718));
                border-width: 1px;
                border-color: power_mode == 1 ? #10b98150 :
                              (power_mode == 2 ? #0284c750 :
                              (power_mode == 3 ? #f43f5e50 : #a855f750));
                height: 26px;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    Text {
                        text: power_target_text != "" ? power_target_text : ("原厂目标 PL1: " + pl1_target + "W | TGP: " + tgp_target + "W");
                        font-size: 10.5px;
                        font-weight: 700;
                        color: power_mode == 1 ? #10b981 :
                               (power_mode == 2 ? #38bdf8 :
                               (power_mode == 3 ? #f43f5e : #c084fc));
                        vertical-alignment: center;
                    }
                }
            }
        }

        // 4 Profile Cards Grid (Height 76px)
        HorizontalLayout {
            spacing: 10px;
            height: 76px;

            // 1. Office (办公)
            card_off := Rectangle {
                horizontal-stretch: 1;
                border-radius: 6px;
                background: power_mode == 1 ? #10b98125 : (t_off.has-hover ? AppTheme.surface_card_hover : AppTheme.surface_pill);
                border-width: power_mode == 1 ? 1.5px : 1px;
                border-color: power_mode == 1 ? #10b981 : AppTheme.border_subtle;

                t_off := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { set_power_mode(1); }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 4px;
                    HorizontalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../../assets/icons/shield.svg");
                            width: 18px;
                            height: 18px;
                            colorize: power_mode == 1 ? #10b981 : AppTheme.text_secondary;
                        }
                    }
                    Text {
                        text: "办公";
                        font-size: 12px;
                        font-weight: power_mode == 1 ? 800 : 600;
                        color: power_mode == 1 ? #10b981 : AppTheme.text_primary;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "静音";
                        font-size: 9.5px;
                        color: power_mode == 1 ? #10b981 : AppTheme.text_muted;
                        horizontal-alignment: center;
                    }
                }
            }

            // 2. Balance (均衡)
            card_bal := Rectangle {
                horizontal-stretch: 1;
                border-radius: 6px;
                background: power_mode == 2 ? #38bdf825 : (t_bal.has-hover ? AppTheme.surface_card_hover : AppTheme.surface_pill);
                border-width: power_mode == 2 ? 1.5px : 1px;
                border-color: power_mode == 2 ? #38bdf8 : AppTheme.border_subtle;

                t_bal := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { set_power_mode(2); }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 4px;
                    HorizontalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../../assets/icons/zap.svg");
                            width: 18px;
                            height: 18px;
                            colorize: power_mode == 2 ? #38bdf8 : AppTheme.text_secondary;
                        }
                    }
                    Text {
                        text: "均衡";
                        font-size: 12px;
                        font-weight: power_mode == 2 ? 800 : 600;
                        color: power_mode == 2 ? #38bdf8 : AppTheme.text_primary;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: power_mode == 2 ? "● 当前" : "标准";
                        font-size: 9.5px;
                        color: power_mode == 2 ? #38bdf8 : AppTheme.text_muted;
                        horizontal-alignment: center;
                    }
                }
            }

            // 3. Beast (狂暴)
            //    支持子模式的机型：单一 Turbo 外框内「左静音狂暴 / 右高能狂暴」两个独立分段，
            //    与 ModeSelector.tsx:159-193 一致；不支持时保持原来的单卡。
            if root.turbo_submode_supported: card_bst_seg := Rectangle {
                horizontal-stretch: 1;
                border-radius: 6px;
                opacity: is_restricted ? 0.45 : 1.0;
                // 外框只表达「狂暴组」归属：mode 3 时整组泛红，具体激活段由内部两段各自高亮
                background: power_mode == 3 ? #f43f5e12 : AppTheme.surface_pill;
                border-width: power_mode == 3 ? 1.5px : 1px;
                border-color: power_mode == 3 ? #f43f5e80 : AppTheme.border_subtle;

                HorizontalLayout {
                    padding: 3px;
                    spacing: 3px;

                    // 左段：静音狂暴（点击固定 silent=true）
                    seg_bst_silent := Rectangle {
                        horizontal-stretch: 1;
                        border-radius: 4px;
                        background: (power_mode == 3 && root.turbo_silent)
                            ? #f43f5e25
                            : (t_seg_silent.has-hover && !is_restricted ? AppTheme.surface_card_hover : AppTheme.surface_card);
                        border-width: (power_mode == 3 && root.turbo_silent) ? 1px : 0px;
                        border-color: #f43f5e;

                        t_seg_silent := TouchArea {
                            mouse-cursor: is_restricted ? default : pointer;
                            clicked => {
                                if (!is_restricted) {
                                    set_power_mode(3);
                                    root.apply_turbo_silent(true);
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            HorizontalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("../../assets/icons/snowflake.svg");
                                    width: 16px;
                                    height: 16px;
                                    colorize: is_restricted ? AppTheme.text_muted : #67e8f9;
                                }
                            }
                            Text {
                                text: "静音狂暴";
                                font-size: 11px;
                                font-weight: (power_mode == 3 && root.turbo_silent) ? 800 : 600;
                                color: is_restricted ? AppTheme.text_muted : ((power_mode == 3 && root.turbo_silent) ? #f43f5e : AppTheme.text_primary);
                                horizontal-alignment: center;
                            }
                            Text {
                                text: is_restricted ? "需圆口DC" : ((power_mode == 3 && root.turbo_silent) ? "● 当前" : "静音");
                                font-size: 9px;
                                color: is_restricted ? #f59e0b : ((power_mode == 3 && root.turbo_silent) ? #f43f5e : AppTheme.text_muted);
                                horizontal-alignment: center;
                            }
                        }

                        // 右上角 GPU OC 胶囊：仅激活的狂暴段显示（对齐 ModeSelector.tsx:172）
                        // 独立 TouchArea 覆盖在分段之上，点击不会落到下面的 apply_turbo_silent。
                        if power_mode == 3 && root.turbo_silent && !is_restricted: oc_silent := Rectangle {
                            x: parent.width - self.width - 5px;
                            y: 3px;
                            width: oc_silent_text.preferred-width + 8px;
                            height: 13px;
                            border-radius: 3px;
                            background: #38bdf824;
                            border-width: 1px;
                            border-color: root.gpu_oc_on ? #38bdf8 : #38bdf880;

                            oc_silent_text := Text {
                                text: root.gpu_oc_on ? "GPU OC ON" : "GPU OC OFF";
                                font-size: 8px;
                                font-weight: 700;
                                color: #38bdf8;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.toggle_gpu_oc(); }
                            }
                        }
                    }

                    // 右段：高能狂暴（点击固定 silent=false）
                    seg_bst_extreme := Rectangle {
                        horizontal-stretch: 1;
                        border-radius: 4px;
                        background: (power_mode == 3 && !root.turbo_silent)
                            ? #f43f5e25
                            : (t_seg_extreme.has-hover && !is_restricted ? AppTheme.surface_card_hover : AppTheme.surface_card);
                        border-width: (power_mode == 3 && !root.turbo_silent) ? 1px : 0px;
                        border-color: #f43f5e;

                        t_seg_extreme := TouchArea {
                            mouse-cursor: is_restricted ? default : pointer;
                            clicked => {
                                if (!is_restricted) {
                                    set_power_mode(3);
                                    root.apply_turbo_silent(false);
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            HorizontalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("../../assets/icons/flame.svg");
                                    width: 16px;
                                    height: 16px;
                                    colorize: is_restricted ? AppTheme.text_muted : #f43f5e;
                                }
                            }
                            Text {
                                text: "高能狂暴";
                                font-size: 11px;
                                font-weight: (power_mode == 3 && !root.turbo_silent) ? 800 : 600;
                                color: is_restricted ? AppTheme.text_muted : ((power_mode == 3 && !root.turbo_silent) ? #f43f5e : AppTheme.text_primary);
                                horizontal-alignment: center;
                            }
                            Text {
                                text: is_restricted ? "需圆口DC" : ((power_mode == 3 && !root.turbo_silent) ? "● 当前" : "高能");
                                font-size: 9px;
                                color: is_restricted ? #f59e0b : ((power_mode == 3 && !root.turbo_silent) ? #f43f5e : AppTheme.text_muted);
                                horizontal-alignment: center;
                            }
                        }

                        // 右上角 GPU OC 胶囊：仅激活的狂暴段显示（对齐 ModeSelector.tsx:184）
                        if power_mode == 3 && !root.turbo_silent && !is_restricted: oc_extreme := Rectangle {
                            x: parent.width - self.width - 5px;
                            y: 3px;
                            width: oc_extreme_text.preferred-width + 8px;
                            height: 13px;
                            border-radius: 3px;
                            background: #38bdf824;
                            border-width: 1px;
                            border-color: root.gpu_oc_on ? #38bdf8 : #38bdf880;

                            oc_extreme_text := Text {
                                text: root.gpu_oc_on ? "GPU OC ON" : "GPU OC OFF";
                                font-size: 8px;
                                font-weight: 700;
                                color: #38bdf8;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.toggle_gpu_oc(); }
                            }
                        }
                    }
                }
            }

            if !root.turbo_submode_supported: card_bst := Rectangle {
                horizontal-stretch: 1;
                border-radius: 6px;
                opacity: is_restricted ? 0.45 : 1.0;
                background: power_mode == 3 ? #f43f5e25 : (t_bst.has-hover && !is_restricted ? AppTheme.surface_card_hover : AppTheme.surface_pill);
                border-width: power_mode == 3 ? 1.5px : 1px;
                border-color: power_mode == 3 ? #f43f5e : AppTheme.border_subtle;

                t_bst := TouchArea {
                    mouse-cursor: is_restricted ? default : pointer;
                    clicked => {
                        if (!is_restricted) {
                            set_power_mode(3);
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 4px;
                    HorizontalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../../assets/icons/flame.svg");
                            width: 18px;
                            height: 18px;
                            colorize: is_restricted ? AppTheme.text_muted : (power_mode == 3 ? #f43f5e : AppTheme.text_secondary);
                        }
                    }
                    Text {
                        text: "狂暴";
                        font-size: 12px;
                        font-weight: power_mode == 3 ? 800 : 600;
                        color: is_restricted ? AppTheme.text_muted : (power_mode == 3 ? #f43f5e : AppTheme.text_primary);
                        horizontal-alignment: center;
                    }
                    Text {
                        text: is_restricted ? "需圆口DC" : (power_mode == 3 ? "● 当前" : "狂暴");
                        font-size: 9.5px;
                        color: is_restricted ? #f59e0b : (power_mode == 3 ? #f43f5e : AppTheme.text_muted);
                        horizontal-alignment: center;
                    }
                }

                // 不支持子模式时的狂暴卡：激活态同样显示 GPU OC 胶囊（对齐 ModeSelector.tsx:227）
                if power_mode == 3 && !is_restricted: oc_fallback := Rectangle {
                    x: parent.width - self.width - 6px;
                    y: 5px;
                    width: oc_fallback_text.preferred-width + 8px;
                    height: 13px;
                    border-radius: 3px;
                    background: #38bdf824;
                    border-width: 1px;
                    border-color: root.gpu_oc_on ? #38bdf8 : #38bdf880;

                    oc_fallback_text := Text {
                        text: root.gpu_oc_on ? "GPU OC ON" : "GPU OC OFF";
                        font-size: 8px;
                        font-weight: 700;
                        color: #38bdf8;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.toggle_gpu_oc(); }
                    }
                }
            }

            // 4. Custom (自定义)
            card_cst := Rectangle {
                horizontal-stretch: 1;
                border-radius: 6px;
                opacity: is_restricted ? 0.45 : 1.0;
                background: power_mode == 4 ? #c084fc25 : (t_cst.has-hover && !is_restricted ? AppTheme.surface_card_hover : AppTheme.surface_pill);
                border-width: power_mode == 4 ? 1.5px : 1px;
                border-color: power_mode == 4 ? #c084fc : AppTheme.border_subtle;

                t_cst := TouchArea {
                    mouse-cursor: is_restricted ? default : pointer;
                    clicked => {
                        if (!is_restricted) {
                            if root.power_mode == 4 {
                                root.open_custom_tuning();
                            } else {
                                root.set_power_mode(4);
                            }
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 4px;
                    HorizontalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../../assets/icons/sliders.svg");
                            width: 18px;
                            height: 18px;
                            colorize: is_restricted ? AppTheme.text_muted : (power_mode == 4 ? #c084fc : AppTheme.text_secondary);
                        }
                    }
                    Text {
                        text: "自定义";
                        font-size: 12px;
                        font-weight: power_mode == 4 ? 800 : 600;
                        color: is_restricted ? AppTheme.text_muted : (power_mode == 4 ? #c084fc : AppTheme.text_primary);
                        horizontal-alignment: center;
                    }
                    Text {
                        text: is_restricted ? "需圆口DC" : (power_mode == 4 ? "● 当前" : "极客");
                        font-size: 9.5px;
                        color: is_restricted ? #f59e0b : (power_mode == 4 ? #c084fc : AppTheme.text_muted);
                        horizontal-alignment: center;
                    }
                }

                // Top-right Corner Badge for Custom Tuning
                if root.power_mode == 4 && !is_restricted: tune_badge := Rectangle {
                    x: parent.width - self.width - 6px;
                    y: 6px;
                    width: 52px;
                    height: 20px;
                    border-radius: 4px;
                    background: t_tune.has-hover ? #a855f770 : #a855f745;
                    border-width: 1px;
                    border-color: #c084fc;

                    t_tune := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.open_custom_tuning(); }
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 3px;

                        Image {
                            source: @image-url("../../assets/icons/sliders-horizontal.svg");
                            width: 11px;
                            height: 11px;
                            colorize: #f3e8ff;
                            y: (parent.height - self.height) / 2;
                        }

                        Text {
                            text: "调校";
                            font-size: 9.5px;
                            font-weight: 700;
                            color: #f3e8ff;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}

