import { AppTheme } from "../../theme.slint";
import { OsdConfigData } from "../system/system_types.slint";

export component DashboardQuickActions inherits Rectangle {
    height: 76px;
    background: transparent;

    in-out property <bool> fan_boost: false;
    in-out property <bool> has_fan_boost: true;
    in-out property <bool> is_bld_fan_lock: false;
    in-out property <int> bld_fan_rpm: 5800;
    in-out property <bool> auto_min_hz: true;
    in-out property <OsdConfigData> osd_config: {
        enabled: true,
        theme: "fade",
        scale: "140%",
        position: "top-left"
    };

    callback toggle_fan_boost();
    callback toggle_bld_fan_lock(int);
    callback change_bld_fan_rpm(int);
    callback toggle_auto_min_hz();
    callback change_osd_theme(string);
    callback change_osd_scale(string);
    callback change_osd_position(string);
    callback trigger_osd_preview();

    HorizontalLayout {
        spacing: 12px;

        // 1. 一键强冷 (同方物理开关 / 宝龙达强冷锁速滑块)
        if root.has_fan_boost && root.is_bld_fan_lock : card_bld_fb := Rectangle {
            width: 215px;
            background: AppTheme.surface_card;
            border-radius: 8px;
            border-width: 1px;
            border-color: fan_boost ? #38bdf880 : AppTheme.border_subtle;

            VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 9px;
                padding-bottom: 9px;
                spacing: 8px;
                alignment: center;

                // Top Row: Icon + 强冷锁速 + RPM Badge + 自动/已锁定 Button
                HorizontalLayout {
                    alignment: space-between;
                    height: 22px;

                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../../assets/icons/fan.svg");
                                width: 15px;
                                height: 15px;
                                colorize: fan_boost ? #38bdf8 : AppTheme.text_secondary;
                            }
                        }

                        Text {
                            text: "强冷锁速";
                            font-size: 11.5px;
                            font-weight: 700;
                            color: AppTheme.text_primary;
                            vertical-alignment: center;
                        }

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                height: 17px;
                                border-radius: 4px;
                                background: fan_boost ? #38bdf822 : AppTheme.surface_pill;
                                border-width: 1px;
                                border-color: fan_boost ? #38bdf860 : AppTheme.border_subtle;

                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    Text {
                                        text: root.bld_fan_rpm + " RPM";
                                        font-size: 9.5px;
                                        font-weight: 700;
                                        color: fan_boost ? #38bdf8 : AppTheme.text_muted;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    // Auto / Locked Toggle Button
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 20px;
                            border-radius: 4px;
                            background: fan_boost ? #38bdf8 : AppTheme.surface_pill;
                            border-width: 1px;
                            border-color: fan_boost ? #38bdf8 : AppTheme.border_medium;

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.toggle_bld_fan_lock(root.bld_fan_rpm); }
                            }

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text {
                                    text: fan_boost ? "已锁定" : "自动";
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: fan_boost ? #0f172a : AppTheme.text_secondary;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // Bottom Row: 2200 [Slider] 5800
                HorizontalLayout {
                    spacing: 8px;
                    height: 16px;
                    alignment: stretch;

                    Text {
                        text: "2200";
                        font-size: 9.5px;
                        font-weight: 600;
                        color: AppTheme.text_muted;
                        vertical-alignment: center;
                    }

                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;

                        bld_track := Rectangle {
                            height: 5px;
                            border-radius: 2.5px;
                            background: AppTheme.surface_pill;

                            Rectangle {
                                x: 0px;
                                y: 0px;
                                height: 100%;
                                width: Math.clamp((root.bld_fan_rpm - 2200) / 3600.0, 0.0, 1.0) * parent.width;
                                border-radius: 2.5px;
                                background: fan_boost ? #38bdf8 : AppTheme.border_highlight;
                            }

                            Rectangle {
                                width: 12px;
                                height: 12px;
                                border-radius: 6px;
                                background: #ffffff;
                                border-width: 1.5px;
                                border-color: fan_boost ? #38bdf8 : AppTheme.border_medium;
                                x: Math.clamp((root.bld_fan_rpm - 2200) / 3600.0, 0.0, 1.0) * (parent.width - 12px);
                                y: (parent.height - self.height) / 2;
                            }

                            TouchArea {
                                mouse-cursor: pointer;
                                pointer-event(ev) => {
                                    if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                                        root.bld_fan_rpm = Math.round(Math.clamp(self.mouse-x / self.width, 0.0, 1.0) * 36.0) * 100 + 2200;
                                    } else if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left) {
                                        root.bld_fan_rpm = Math.round(Math.clamp(self.mouse-x / self.width, 0.0, 1.0) * 36.0) * 100 + 2200;
                                        root.change_bld_fan_rpm(root.bld_fan_rpm);
                                    }
                                }
                                moved => {
                                    if self.pressed {
                                        root.bld_fan_rpm = Math.round(Math.clamp(self.mouse-x / self.width, 0.0, 1.0) * 36.0) * 100 + 2200;
                                    }
                                }
                            }
                        }
                    }

                    Text {
                        text: "5800";
                        font-size: 9.5px;
                        font-weight: 600;
                        color: AppTheme.text_muted;
                        vertical-alignment: center;
                    }
                }
            }
        }

        if root.has_fan_boost && !root.is_bld_fan_lock : card_fb := Rectangle {
            width: 190px;
            background: AppTheme.surface_card;
            border-radius: 8px;
            border-width: 1px;
            border-color: fan_boost ? #38bdf880 : AppTheme.border_subtle;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../../assets/icons/fan.svg");
                            width: 22px;
                            height: 22px;
                            colorize: fan_boost ? #38bdf8 : AppTheme.text_secondary;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: "一键强冷";
                            font-size: 12px;
                            font-weight: 700;
                            color: AppTheme.text_primary;
                        }
                        Text {
                            text: "最高转速极限降温";
                            font-size: 9.5px;
                            color: AppTheme.text_muted;
                        }
                    }
                }

                // Switch Button
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        border-radius: 5px;
                        background: fan_boost ? #38bdf8 : AppTheme.surface_pill;
                        border-width: 1px;
                        border-color: fan_boost ? #38bdf8 : AppTheme.border_medium;
                        height: 28px;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { toggle_fan_boost(); }
                        }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            Text {
                                text: fan_boost ? "已开启" : "关闭";
                                font-size: 11px;
                                font-weight: 700;
                                color: fan_boost ? #0f172a : AppTheme.text_secondary;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // 2. 拔电自动低刷 (Compact width: 210px)
        card_hz := Rectangle {
            width: 210px;
            background: AppTheme.surface_card;
            border-radius: 8px;
            border-width: 1px;
            border-color: auto_min_hz ? #6366f180 : AppTheme.border_subtle;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../../assets/icons/zap-off.svg");
                            width: 20px;
                            height: 20px;
                            colorize: auto_min_hz ? #818cf8 : AppTheme.text_secondary;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: "拔电自动低刷";
                            font-size: 12px;
                            font-weight: 700;
                            color: AppTheme.text_primary;
                        }
                        Text {
                            text: "离电续航最大化";
                            font-size: 9.5px;
                            color: AppTheme.text_muted;
                        }
                    }
                }

                // Switch Button
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        border-radius: 5px;
                        background: auto_min_hz ? AppTheme.accent_brand : AppTheme.surface_pill;
                        border-width: 1px;
                        border-color: auto_min_hz ? AppTheme.accent_brand : AppTheme.border_medium;
                        height: 28px;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { toggle_auto_min_hz(); }
                        }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            Text {
                                text: auto_min_hz ? "已开启" : "关闭";
                                font-size: 11px;
                                font-weight: 700;
                                color: auto_min_hz ? AppTheme.tag_brand_text : AppTheme.text_secondary;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // 3. OSD 悬浮提示设置 (horizontal-stretch: 1)
        card_osd := Rectangle {
            horizontal-stretch: 1;
            background: AppTheme.surface_card;
            border-radius: 8px;
            border-width: 1px;
            border-color: AppTheme.border_subtle;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;

                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../../assets/icons/layers.svg");
                            width: 20px;
                            height: 20px;
                            colorize: #38bdf8;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        HorizontalLayout {
                            spacing: 6px;
                            Text {
                                text: "OSD 设置";
                                font-size: 12px;
                                font-weight: 700;
                                color: AppTheme.text_primary;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                border-radius: 3px;
                                background: #38bdf820;
                                border-width: 1px;
                                border-color: #38bdf860;
                                height: 16px;
                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    Text {
                                        text: "HUD";
                                        font-size: 9px;
                                        font-weight: 700;
                                        color: #38bdf8;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                        Text {
                            text: "形态控制";
                            font-size: 9.5px;
                            color: AppTheme.text_muted;
                        }
                    }
                }

                // Controls: Theme, Scale, Position, Preview
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 6px;

                        // 1. Theme Dropdown
                        Rectangle {
                            height: 26px;
                            border-radius: 4px;
                            background: t_theme.has-hover ? AppTheme.surface_card_hover : AppTheme.surface_pill;
                            border-width: 1px;
                            border-color: AppTheme.border_medium;
                            t_theme := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { theme_popup.show(); }
                            }
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 4px;
                                Text {
                                    text: root.osd_config.theme == "cinema" ? "电影字幕" : (root.osd_config.theme == "fade" ? "向右羽化" : "磨砂胶囊");
                                    font-size: 11px;
                                    color: AppTheme.text_primary;
                                    vertical-alignment: center;
                                }
                                Image {
                                    source: @image-url("../../assets/icons/chevron-down.svg");
                                    width: 10px;
                                    height: 10px;
                                    colorize: AppTheme.text_muted;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                            theme_popup := PopupWindow {
                                x: 0;
                                y: parent.height + 4px;
                                width: 100px;
                                Rectangle {
                                    background: AppTheme.surface_elevated;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: AppTheme.border_medium;
                                    drop-shadow-blur: 8px;
                                    drop-shadow-color: #00000060;
                                    VerticalLayout {
                                        padding: 4px;
                                        spacing: 2px;
                                        Rectangle {
                                            height: 24px;
                                            border-radius: 4px;
                                            background: t_th1.has-hover ? AppTheme.surface_pill : transparent;
                                            t_th1 := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.change_osd_theme("cinema"); }
                                            }
                                            HorizontalLayout { padding-left: 8px; Text { text: "电影字幕"; font-size: 11px; color: AppTheme.text_primary; vertical-alignment: center; } }
                                        }
                                        Rectangle {
                                            height: 24px;
                                            border-radius: 4px;
                                            background: t_th2.has-hover ? AppTheme.surface_pill : transparent;
                                            t_th2 := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.change_osd_theme("fade"); }
                                            }
                                            HorizontalLayout { padding-left: 8px; Text { text: "向右羽化"; font-size: 11px; color: AppTheme.text_primary; vertical-alignment: center; } }
                                        }
                                        Rectangle {
                                            height: 24px;
                                            border-radius: 4px;
                                            background: t_th3.has-hover ? AppTheme.surface_pill : transparent;
                                            t_th3 := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.change_osd_theme("pill"); }
                                            }
                                            HorizontalLayout { padding-left: 8px; Text { text: "磨砂胶囊"; font-size: 11px; color: AppTheme.text_primary; vertical-alignment: center; } }
                                        }
                                    }
                                }
                            }
                        }

                        // 2. Scale Dropdown
                        Rectangle {
                            height: 26px;
                            border-radius: 4px;
                            background: t_scale.has-hover ? AppTheme.surface_card_hover : AppTheme.surface_pill;
                            border-width: 1px;
                            border-color: AppTheme.border_medium;
                            t_scale := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { scale_popup.show(); }
                            }
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 4px;
                                Text { text: root.osd_config.scale; font-size: 11px; color: AppTheme.text_primary; vertical-alignment: center; }
                                Image {
                                    source: @image-url("../../assets/icons/chevron-down.svg");
                                    width: 10px;
                                    height: 10px;
                                    colorize: AppTheme.text_muted;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                            scale_popup := PopupWindow {
                                x: 0;
                                y: parent.height + 4px;
                                width: 80px;
                                Rectangle {
                                    background: AppTheme.surface_elevated;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: AppTheme.border_medium;
                                    drop-shadow-blur: 8px;
                                    drop-shadow-color: #00000060;
                                    VerticalLayout {
                                        padding: 4px;
                                        spacing: 2px;
                                        for sc in ["80%", "100%", "120%", "140%"]: Rectangle {
                                            height: 24px;
                                            border-radius: 4px;
                                            background: t_sc.has-hover ? AppTheme.surface_pill : transparent;
                                            t_sc := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.change_osd_scale(sc); }
                                            }
                                            HorizontalLayout { padding-left: 8px; Text { text: sc; font-size: 11px; color: AppTheme.text_primary; vertical-alignment: center; } }
                                        }
                                    }
                                }
                            }
                        }

                        // 3. Position Dropdown
                        Rectangle {
                            height: 26px;
                            border-radius: 4px;
                            background: t_pos.has-hover ? AppTheme.surface_card_hover : AppTheme.surface_pill;
                            border-width: 1px;
                            border-color: AppTheme.border_medium;
                            t_pos := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { pos_popup.show(); }
                            }
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 4px;
                                Text {
                                    text: root.osd_config.position == "top-left" ? "左上角" : (root.osd_config.position == "bottom-center" ? "下方中央" : "屏幕正中");
                                    font-size: 11px;
                                    color: AppTheme.text_primary;
                                    vertical-alignment: center;
                                }
                                Image {
                                    source: @image-url("../../assets/icons/chevron-down.svg");
                                    width: 10px;
                                    height: 10px;
                                    colorize: AppTheme.text_muted;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                            pos_popup := PopupWindow {
                                x: 0;
                                y: parent.height + 4px;
                                width: 90px;
                                Rectangle {
                                    background: AppTheme.surface_elevated;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: AppTheme.border_medium;
                                    drop-shadow-blur: 8px;
                                    drop-shadow-color: #00000060;
                                    VerticalLayout {
                                        padding: 4px;
                                        spacing: 2px;
                                        Rectangle {
                                            height: 24px;
                                            border-radius: 4px;
                                            background: t_p1.has-hover ? AppTheme.surface_pill : transparent;
                                            t_p1 := TouchArea { mouse-cursor: pointer; clicked => { root.change_osd_position("top-left"); } }
                                            HorizontalLayout { padding-left: 8px; Text { text: "左上角"; font-size: 11px; color: AppTheme.text_primary; vertical-alignment: center; } }
                                        }
                                        Rectangle {
                                            height: 24px;
                                            border-radius: 4px;
                                            background: t_p2.has-hover ? AppTheme.surface_pill : transparent;
                                            t_p2 := TouchArea { mouse-cursor: pointer; clicked => { root.change_osd_position("bottom-center"); } }
                                            HorizontalLayout { padding-left: 8px; Text { text: "下方中央"; font-size: 11px; color: AppTheme.text_primary; vertical-alignment: center; } }
                                        }
                                        Rectangle {
                                            height: 24px;
                                            border-radius: 4px;
                                            background: t_p3.has-hover ? AppTheme.surface_pill : transparent;
                                            t_p3 := TouchArea { mouse-cursor: pointer; clicked => { root.change_osd_position("center"); } }
                                            HorizontalLayout { padding-left: 8px; Text { text: "屏幕正中"; font-size: 11px; color: AppTheme.text_primary; vertical-alignment: center; } }
                                        }
                                    }
                                }
                            }
                        }

                        // 4. Preview Button
                        Rectangle {
                            height: 26px;
                            border-radius: 4px;
                            background: t_prev.has-hover ? #6366f125 : AppTheme.surface_pill;
                            border-width: 1px;
                            border-color: #6366f155;
                            t_prev := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.trigger_osd_preview(); }
                            }
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                Text { text: "预览"; font-size: 11px; font-weight: 600; color: #a5b4fc; vertical-alignment: center; }
                            }
                        }
                    }
                }
            }
        }
    }
}