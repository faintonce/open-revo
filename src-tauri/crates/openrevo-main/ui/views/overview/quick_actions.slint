import { AppTheme } from "../../theme.slint";
import { MonitorRefreshCard } from "../gpu/monitor_refresh_card.slint";

export component DashboardQuickActions inherits Rectangle {
    height: 76px;
    background: transparent;

    in-out property <bool> fan_boost: false;
    in-out property <bool> auto_min_hz: true;
    in-out property <int> refresh_rate: 240;
    in-out property <string> monitor_name: "京东方";
    in-out property <[int]> rates_row1: [60, 144, 240];
    in-out property <[int]> rates_row2: [];
    in-out property <bool> has_secondary_monitor: false;
    in-out property <string> primary_monitor_name: "内置主屏";
    in-out property <string> secondary_monitor_name: "外接副屏";

    callback toggle_fan_boost();
    callback toggle_auto_min_hz();
    callback switch_hz(int);
    callback select_monitor(string);
    callback select_monitor_index(int);

    HorizontalLayout {
        spacing: 12px;

        // 1. 一键强冷 (Compact width: 190px)
        card_fb := Rectangle {
            width: 190px;
            background: AppTheme.surface_card;
            border-radius: 8px;
            border-width: 1px;
            border-color: fan_boost ? #38bdf880 : AppTheme.border_subtle;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../../assets/icons/fan.svg");
                            width: 22px;
                            height: 22px;
                            colorize: fan_boost ? #38bdf8 : AppTheme.text_secondary;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: "一键强冷";
                            font-size: 12px;
                            font-weight: 700;
                            color: AppTheme.text_primary;
                        }
                        Text {
                            text: "最高转速极限降温";
                            font-size: 9.5px;
                            color: AppTheme.text_muted;
                        }
                    }
                }

                // Switch Button
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        border-radius: 5px;
                        background: fan_boost ? #38bdf8 : AppTheme.surface_pill;
                        border-width: 1px;
                        border-color: fan_boost ? #38bdf8 : AppTheme.border_medium;
                        height: 28px;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { toggle_fan_boost(); }
                        }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            Text {
                                text: fan_boost ? "已开启" : "关闭";
                                font-size: 11px;
                                font-weight: 700;
                                color: fan_boost ? #0f172a : AppTheme.text_secondary;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // 2. 拔电自动低刷 (Compact width: 210px)
        card_hz := Rectangle {
            width: 210px;
            background: AppTheme.surface_card;
            border-radius: 8px;
            border-width: 1px;
            border-color: auto_min_hz ? #6366f180 : AppTheme.border_subtle;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../../assets/icons/zap-off.svg");
                            width: 20px;
                            height: 20px;
                            colorize: auto_min_hz ? #818cf8 : AppTheme.text_secondary;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: "拔电自动低刷";
                            font-size: 12px;
                            font-weight: 700;
                            color: AppTheme.text_primary;
                        }
                        Text {
                            text: "离电续航最大化";
                            font-size: 9.5px;
                            color: AppTheme.text_muted;
                        }
                    }
                }

                // Switch Button
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        border-radius: 5px;
                        background: auto_min_hz ? #6366f1 : AppTheme.surface_pill;
                        border-width: 1px;
                        border-color: auto_min_hz ? #6366f1 : AppTheme.border_medium;
                        height: 28px;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { toggle_auto_min_hz(); }
                        }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            Text {
                                text: auto_min_hz ? "已开启" : "关闭";
                                font-size: 11px;
                                font-weight: 700;
                                color: auto_min_hz ? #ffffff : AppTheme.text_secondary;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // 3. Monitor Refresh Rate Control (Reusing shared MonitorRefreshCard)
        MonitorRefreshCard {
            horizontal-stretch: 1;
            title: "屏幕刷新率";
            monitor_name: root.monitor_name;
            refresh_rate: root.refresh_rate;
            rates_row1: root.rates_row1;
            rates_row2: root.rates_row2;
            has_secondary_monitor: root.has_secondary_monitor;
            primary_monitor_name: root.primary_monitor_name;
            secondary_monitor_name: root.secondary_monitor_name;
            refresh_rate_switched(hz) => { root.switch_hz(hz); }
            select_monitor_index(idx) => { root.select_monitor_index(idx); }
        }
    }
}