import { AppTheme } from "../../theme.slint";

export component MuxSwitchCard inherits Rectangle {
    in-out property <string> gpu_mode: "dgpu";
    in-out property <string> gpu_name: "RTX 4090 Laptop GPU";
    in-out property <string> cpu_name: "Intel Core i9-14900HX";
    in-out property <bool> is_tri_mode: true;
    in-out property <bool> is_safety_locked: false;
    in-out property <bool> is_intel: true;
    in-out property <bool> is_thin_and_light: false;
    in-out property <string> igpu_lock_reason: "";

    callback request_mode_switch(string, string); // (mode, title)

    border-radius: 8px;
    background: AppTheme.surface_card;
    border-width: 1px;
    border-color: AppTheme.border_subtle;

    VerticalLayout {
        padding: 14px;
        spacing: 10px;

        // Row 1: Title + Hardware Spec Badge
        HorizontalLayout {
            alignment: space-between;

            HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../../assets/icons/monitor.svg");
                        width: 16px;
                        height: 16px;
                        colorize: root.is_thin_and_light ? #10b981 : #38bdf8;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: root.is_thin_and_light ? "Режим графики (изначальная архитектура iGPU)" : (root.is_tri_mode ? "Режим графики (два GPU, три режима)" : "Режим графики (два GPU, два режима)");
                        font-size: 13px;
                        font-weight: 800;
                        color: AppTheme.text_primary;
                    }
                    Text {
                        text: root.is_thin_and_light ?
                            "Платформа текущей модели — энергоэффективная архитектура только на iGPU, без dGPU и физического переключателя MUX. Экран питается напрямую встроенной графикой: очень долгая автономность и отличная тишина." :
                            (root.is_tri_mode ?
                                "Аппаратное переключение MUX на уровне платы · управляется процессом BIOS POST или динамической линией PCIe и физическим переключателем" :
                                "Платформа модели — двухрежимная архитектура с двумя GPU (прямой вывод dGPU и гибридный вывод); включена аппаратная защитная блокировка от чёрного экрана и «окирпичивания».");
                        font-size: 10px;
                        color: AppTheme.text_muted;
                        overflow: elide;
                    }
                }
            }

            // Right: CPU + GPU chip badge
            Rectangle {
                height: 26px;
                border-radius: 5px;
                background: AppTheme.surface_pill;
                border-width: 1px;
                border-color: AppTheme.border_subtle;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 6px;
                    Image {
                        source: @image-url("../../assets/icons/cpu.svg");
                        width: 12px;
                        height: 12px;
                        colorize: #60a5fa;
                        y: (parent.height - self.height) / 2;
                    }
                    Text {
                        text: root.is_thin_and_light ? (root.cpu_name + " · Встроенное ядро графики") : (root.gpu_name + " · " + root.cpu_name);
                        font-size: 10.5px;
                        font-weight: 600;
                        color: AppTheme.text_secondary;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }

        // Row 2: Sub-banner with Shield badge
        Rectangle {
            height: 30px;
            border-radius: 6px;
            background: AppTheme.is_light ? #f3f4f6 : #0d121c;
            border-width: 1px;
            border-color: AppTheme.border_subtle;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: root.is_thin_and_light ? "Изначально чисто iGPU, энергоэффективная архитектура прямого вывода" : (root.is_tri_mode ? "Изначальная аппаратная архитектура переключения MUX на плате" : "Аппаратная защитная архитектура платы для двух GPU и двух режимов");
                        font-size: 10.5px;
                        font-weight: 700;
                        color: root.is_thin_and_light ? #10b981 : (root.is_tri_mode ? #38bdf8 : #f59e0b);
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.is_intel ? "[Платформа Intel]" : "[Платформа AMD]";
                        font-size: 10px;
                        font-weight: 700;
                        color: root.is_intel ? #60a5fa : #fb923c;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.is_thin_and_light ?
                            "· Прямой вывод iGPU: графика и видеосигнал полностью обслуживаются энергоэффективным iGPU CPU; физическое переключение MUX не требуется и не поддерживается." :
                            (root.is_tri_mode ?
                                "· Физический канал прямого прохождения сигнала: полностью исключает снижение частот и потери на преобразование" :
                                "· Аппаратная реконфигурация: во время самопроверки перенастраиваются линии PCIe и физический переключатель экрана — исключаются сбои драйвера, падение FPS и подвисания.");
                        font-size: 10px;
                        color: AppTheme.text_muted;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 5px;
                    Image {
                        source: @image-url("../../assets/icons/shield.svg");
                        width: 12px;
                        height: 12px;
                        colorize: root.is_thin_and_light ? #10b981 : #38bdf8;
                        y: (parent.height - self.height) / 2;
                    }
                    Text {
                        text: root.is_thin_and_light ? "NATIVE iGPU LINK" : "HARDWARE MUX LINK";
                        font-size: 9.5px;
                        font-weight: 800;
                        color: root.is_thin_and_light ? #10b981 : #38bdf8;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Row 3: 3 MUX Mode Big Cards
        HorizontalLayout {
            spacing: 12px;

            // 1. dGPU Card (轻薄本反向锁定)
            Rectangle {
                horizontal-stretch: 1;
                height: 135px;
                border-radius: 8px;
                opacity: root.is_thin_and_light ? 0.45 : 1.0;
                background: (!root.is_thin_and_light && root.gpu_mode == "dgpu") ? #38bdf815 : AppTheme.surface_pill;
                border-width: 1px;
                border-color: (!root.is_thin_and_light && root.gpu_mode == "dgpu") ? #38bdf8aa : (root.is_thin_and_light ? #f59e0b40 : AppTheme.border_subtle);

                VerticalLayout {
                    padding: 12px;
                    alignment: space-between;

                    HorizontalLayout {
                        alignment: space-between;
                        Rectangle {
                            width: 30px;
                            height: 30px;
                            border-radius: 6px;
                            background: root.is_thin_and_light ? #f59e0b18 : (root.gpu_mode == "dgpu" ? #38bdf825 : transparent);
                            border-width: 1px;
                            border-color: root.is_thin_and_light ? #f59e0b50 : (root.gpu_mode == "dgpu" ? #38bdf860 : AppTheme.border_subtle);
                            Image {
                                source: root.is_thin_and_light ? @image-url("../../assets/icons/lock.svg") : @image-url("../../assets/icons/zap.svg");
                                width: 15px;
                                height: 15px;
                                colorize: root.is_thin_and_light ? #f59e0b : #38bdf8;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }

                        if root.is_thin_and_light: Rectangle {
                            height: 20px;
                            border-radius: 4px;
                            background: #f59e0b1a;
                            border-width: 1px;
                            border-color: #f59e0b50;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                spacing: 3px;
                                Image {
                                    source: @image-url("../../assets/icons/lock.svg");
                                    width: 10px;
                                    height: 10px;
                                    colorize: #f59e0b;
                                    y: (parent.height - self.height) / 2;
                                }
                                Text {
                                    text: "Блокировка ультрабука";
                                    font-size: 9px;
                                    font-weight: 700;
                                    color: #f59e0b;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        if !root.is_thin_and_light && root.gpu_mode == "dgpu": Rectangle {
                            height: 20px;
                            border-radius: 4px;
                            background: #38bdf825;
                            border-width: 1px;
                            border-color: #38bdf870;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                Text {
                                    text: "✔ Применяется на уровне железа";
                                    font-size: 9.5px;
                                    font-weight: 700;
                                    color: #38bdf8;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    Text {
                        text: root.is_thin_and_light ?
                            "Текущая модель — ультрабук без дискретной графики: канал прямого вывода dGPU недоступен." :
                            "dGPU физически подключена напрямую к встроенному экрану: минуя iGPU — максимальный FPS и сверхнизкая задержка изображения.";
                        font-size: 9.5px;
                        color: AppTheme.text_muted;
                        wrap: word-wrap;
                    }

                    Rectangle {
                        height: 28px;
                        border-radius: 5px;
                        background: (!root.is_thin_and_light && root.gpu_mode == "dgpu") ? #38bdf8 : AppTheme.surface_card;
                        border-width: 1px;
                        border-color: (!root.is_thin_and_light && root.gpu_mode == "dgpu") ? #38bdf8 : AppTheme.border_subtle;
                        TouchArea {
                            mouse-cursor: root.is_thin_and_light ? not-allowed : pointer;
                            clicked => {
                                if (!root.is_thin_and_light && root.gpu_mode != "dgpu") {
                                    root.request_mode_switch("dgpu", "Прямой вывод dGPU");
                                }
                            }
                        }
                        Text {
                            text: root.is_thin_and_light ? "Прямой вывод dGPU (нет оборудования)" : "Прямой вывод dGPU";
                            font-size: 11px;
                            font-weight: 700;
                            color: root.is_thin_and_light ? AppTheme.text_muted : ((root.gpu_mode == "dgpu") ? #000000 : AppTheme.text_primary);
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // 2. Hybrid Card (轻薄本反向锁定)
            Rectangle {
                horizontal-stretch: 1;
                height: 135px;
                border-radius: 8px;
                opacity: root.is_thin_and_light ? 0.45 : 1.0;
                background: (!root.is_thin_and_light && root.gpu_mode == "hybrid") ? #a855f718 : AppTheme.surface_pill;
                border-width: 1px;
                border-color: (!root.is_thin_and_light && root.gpu_mode == "hybrid") ? #a855f7aa : (root.is_thin_and_light ? #f59e0b40 : AppTheme.border_subtle);

                VerticalLayout {
                    padding: 12px;
                    alignment: space-between;

                    HorizontalLayout {
                        alignment: space-between;
                        Rectangle {
                            width: 30px;
                            height: 30px;
                            border-radius: 6px;
                            background: root.is_thin_and_light ? #f59e0b18 : (root.gpu_mode == "hybrid" ? #a855f725 : transparent);
                            border-width: 1px;
                            border-color: root.is_thin_and_light ? #f59e0b50 : (root.gpu_mode == "hybrid" ? #a855f760 : AppTheme.border_subtle);
                            Image {
                                source: root.is_thin_and_light ? @image-url("../../assets/icons/lock.svg") : @image-url("../../assets/icons/layers.svg");
                                width: 15px;
                                height: 15px;
                                colorize: root.is_thin_and_light ? #f59e0b : #c084fc;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }

                        if root.is_thin_and_light: Rectangle {
                            height: 20px;
                            border-radius: 4px;
                            background: #f59e0b1a;
                            border-width: 1px;
                            border-color: #f59e0b50;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                spacing: 3px;
                                Image {
                                    source: @image-url("../../assets/icons/lock.svg");
                                    width: 10px;
                                    height: 10px;
                                    colorize: #f59e0b;
                                    y: (parent.height - self.height) / 2;
                                }
                                Text {
                                    text: "Блокировка ультрабука";
                                    font-size: 9px;
                                    font-weight: 700;
                                    color: #f59e0b;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        if !root.is_thin_and_light && root.gpu_mode == "hybrid": Rectangle {
                            height: 20px;
                            border-radius: 4px;
                            background: #a855f725;
                            border-width: 1px;
                            border-color: #a855f770;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                Text {
                                    text: "✔ Применяется на уровне железа";
                                    font-size: 9.5px;
                                    font-weight: 700;
                                    color: #c084fc;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    Text {
                        text: root.is_thin_and_light ?
                            "Текущая модель — архитектура с прямым выводом только на iGPU, внешняя dGPU не участвует: гибридный канал недоступен." :
                            "Лёгкие задачи идут через iGPU ради автономности; при сложном 3D-рендеринге и киберспортивных играх ускорение dGPU подключается автоматически.";
                        font-size: 9.5px;
                        color: AppTheme.text_muted;
                        wrap: word-wrap;
                    }

                    Rectangle {
                        height: 28px;
                        border-radius: 5px;
                        background: (!root.is_thin_and_light && root.gpu_mode == "hybrid") ? #a855f7 : AppTheme.surface_card;
                        border-width: 1px;
                        border-color: (!root.is_thin_and_light && root.gpu_mode == "hybrid") ? #a855f7 : AppTheme.border_subtle;
                        TouchArea {
                            mouse-cursor: root.is_thin_and_light ? not-allowed : pointer;
                            clicked => {
                                if (!root.is_thin_and_light && root.gpu_mode != "hybrid") {
                                    root.request_mode_switch("hybrid", "Гибридный вывод (Hybrid)");
                                }
                            }
                        }
                        Text {
                            text: root.is_thin_and_light ? "Гибридный вывод (нет оборудования)" : "Гибридный вывод";
                            font-size: 11px;
                            font-weight: 700;
                            color: root.is_thin_and_light ? AppTheme.text_muted : ((root.gpu_mode == "hybrid") ? #ffffff : AppTheme.text_primary);
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // 3. iGPU Card (轻薄本原生生效)
            Rectangle {
                horizontal-stretch: 1;
                height: 135px;
                border-radius: 8px;
                opacity: (root.is_thin_and_light || root.is_tri_mode) ? 1.0 : 0.65;
                background: (root.is_thin_and_light || root.gpu_mode == "igpu") ? #10b98118 : AppTheme.surface_pill;
                border-width: 1px;
                border-color: (root.is_thin_and_light || root.gpu_mode == "igpu") ? #10b981aa : (!root.is_tri_mode ? #f59e0b40 : AppTheme.border_subtle);

                VerticalLayout {
                    padding: 12px;
                    alignment: space-between;

                    HorizontalLayout {
                        alignment: space-between;
                        Rectangle {
                            width: 30px;
                            height: 30px;
                            border-radius: 6px;
                            background: (!root.is_thin_and_light && !root.is_tri_mode) ? #f59e0b18 : ((root.is_thin_and_light || root.gpu_mode == "igpu") ? #10b98125 : transparent);
                            border-width: 1px;
                            border-color: (!root.is_thin_and_light && !root.is_tri_mode) ? #f59e0b50 : ((root.is_thin_and_light || root.gpu_mode == "igpu") ? #10b98160 : AppTheme.border_subtle);
                            Image {
                                source: (!root.is_thin_and_light && !root.is_tri_mode) ? @image-url("../../assets/icons/lock.svg") : @image-url("../../assets/icons/zap-off.svg");
                                width: 15px;
                                height: 15px;
                                colorize: (!root.is_thin_and_light && !root.is_tri_mode) ? #f59e0b : #34d399;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }

                        if !root.is_thin_and_light && !root.is_tri_mode: Rectangle {
                            height: 20px;
                            border-radius: 4px;
                            background: #f59e0b1a;
                            border-width: 1px;
                            border-color: #f59e0b50;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                spacing: 3px;
                                Image {
                                    source: @image-url("../../assets/icons/lock.svg");
                                    width: 10px;
                                    height: 10px;
                                    colorize: #f59e0b;
                                    y: (parent.height - self.height) / 2;
                                }
                                Text {
                                    text: "Блокировка защиты двух режимов";
                                    font-size: 9px;
                                    font-weight: 700;
                                    color: #f59e0b;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        if root.is_thin_and_light || (root.is_tri_mode && root.gpu_mode == "igpu"): Rectangle {
                            height: 20px;
                            border-radius: 4px;
                            background: #10b98125;
                            border-width: 1px;
                            border-color: #10b98170;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                Text {
                                    text: root.is_thin_and_light ? "✔ Прямой вывод iGPU" : "✔ Применяется на уровне железа";
                                    font-size: 9.5px;
                                    font-weight: 700;
                                    color: #34d399;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    Text {
                        text: root.is_thin_and_light ?
                            "Графика и вывод на экран полностью обслуживаются встроенным ядром CPU — без затрат на dGPU и MUX, очень долгая автономность." :
                            (root.is_tri_mode ?
                                "Полностью отсекает питание dGPU и линию PCIe, убирая потребление dGPU в простое — очень долгая работа от батареи." :
                                "Оборудование платформы — двухрежимная архитектура без физического переключателя «только iGPU». Включена защитная блокировка, полностью предотвращающая чёрный экран и зависание при старте.");
                        font-size: 9.5px;
                        color: AppTheme.text_muted;
                        wrap: word-wrap;
                    }

                    Rectangle {
                        height: 28px;
                        border-radius: 5px;
                        background: (!root.is_thin_and_light && !root.is_tri_mode) ? AppTheme.surface_pill : ((root.is_thin_and_light || root.gpu_mode == "igpu") ? #10b981 : AppTheme.surface_card);
                        border-width: 1px;
                        border-color: (!root.is_thin_and_light && !root.is_tri_mode) ? AppTheme.border_subtle : ((root.is_thin_and_light || root.gpu_mode == "igpu") ? #10b981 : AppTheme.border_subtle);
                        TouchArea {
                            mouse-cursor: (!root.is_thin_and_light && !root.is_tri_mode) ? not-allowed : pointer;
                            clicked => {
                                if (!root.is_thin_and_light && root.is_tri_mode && root.gpu_mode != "igpu") {
                                    root.request_mode_switch("igpu", "Режим только-iGPU (iGPU)");
                                }
                            }
                        }
                        Text {
                            text: root.is_thin_and_light ? "Прямой вывод iGPU" : (root.is_tri_mode ? "Режим iGPU" : "Режим iGPU (блокировка двух режимов)");
                            font-size: 11px;
                            font-weight: 700;
                            color: (!root.is_thin_and_light && !root.is_tri_mode) ? AppTheme.text_muted : ((root.is_thin_and_light || root.gpu_mode == "igpu") ? #000000 : AppTheme.text_primary);
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}

