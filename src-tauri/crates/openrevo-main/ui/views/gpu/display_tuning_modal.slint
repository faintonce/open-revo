import { AppTheme } from "../../theme.slint";

export struct ColorPresetItem {
    id: string,
    name: string,
    temp_k: int,
    saturation: int, // 0 - 200 (%)
    contrast: int,   // 50 - 150 (%)
    gamma: int,      // 70 - 130 (0.70 - 1.30)
    gain_r: int,     // 50 - 150 (%)
    gain_g: int,     // 50 - 150 (%)
    gain_b: int,     // 50 - 150 (%)
}

export component DisplayTuningModal inherits Rectangle {
    in-out property <bool> is_open: false;
    in-out property <bool> tuning_enabled: true;
    in-out property <string> active_preset_id: "preset_vibrant";

    // Sliders state
    in-out property <int> cur_temp_k: 6500;
    in-out property <int> cur_saturation: 150;
    in-out property <int> cur_contrast: 100;
    in-out property <int> cur_gamma: 100;
    in-out property <int> cur_gain_r: 100;
    in-out property <int> cur_gain_g: 100;
    in-out property <int> cur_gain_b: 100;

    in-out property <bool> is_modified: false;
    in-out property <bool> show_rgb_channels: false;
    in-out property <string> toast_message: "";

    callback close();
    callback select_preset(string);
    callback change_temp_k(int);
    callback change_saturation(int);
    callback change_contrast(int);
    callback change_gamma(int);
    callback change_gain_r(int);
    callback change_gain_g(int);
    callback change_gain_b(int);
    callback reset_preset();
    callback import_json();
    callback export_json();

    // Backdrop overlay
    background: #000000bd;

    // Intercept clicks on backdrop to prevent passing through
    TouchArea { }

    // Modal Card
    Rectangle {
        width: Math.min(parent.width - 48px, 860px);
        height: Math.min(parent.height - 40px, 640px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: AppTheme.is_light ? #ffffff : #0f1522f5;
        border-radius: 12px;
        border-width: 1px;
        border-color: #ec489945;
        clip: true;

        VerticalLayout {
            // Header Bar
            Rectangle {
                height: 57px;
                background: AppTheme.is_light ? #f8fafc : #131b2e;

                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 18px;
                    alignment: space-between;

                    // Left icon + titles
                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 36px;
                                height: 36px;
                                border-radius: 8px;
                                background: #ec489920;
                                border-width: 1px;
                                border-color: #ec489960;
                                Image {
                                    source: @image-url("../../assets/icons/palette.svg");
                                    width: 18px;
                                    height: 18px;
                                    colorize: #f472b6;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;

                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "屏幕色彩增强引擎";
                                    font-size: 14px;
                                    font-weight: 800;
                                    color: AppTheme.text_primary;
                                    vertical-alignment: center;
                                }

                                Rectangle {
                                    height: 18px;
                                    border-radius: 4px;
                                    background: root.tuning_enabled ? #10b98124 : #94a3b820;
                                    border-width: 1px;
                                    border-color: root.tuning_enabled ? #10b98160 : #94a3b840;
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        Text {
                                            text: root.tuning_enabled ? "GPU 硬件生效中" : "调色已暂停";
                                            font-size: 9.5px;
                                            font-weight: 700;
                                            color: root.tuning_enabled ? #34d399 : #94a3b8;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            Text {
                                text: "GPU 硬件级 LUT 查找表与全屏 DWM 渲染管线实时色彩重构";
                                font-size: 10px;
                                color: AppTheme.text_muted;
                            }
                        }
                    }

                    // Right Toast & Close Button
                    HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            if root.toast_message != "": Rectangle {
                                height: 26px;
                                border-radius: 6px;
                                background: #10b98124;
                                border-width: 1px;
                                border-color: #10b98160;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    Text {
                                        text: root.toast_message;
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: #34d399;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 30px;
                                height: 30px;
                                border-radius: 6px;
                                background: close_touch.has-hover ? AppTheme.surface_pill : transparent;
                                border-width: 1px;
                                border-color: close_touch.has-hover ? AppTheme.border_medium : AppTheme.border_subtle;

                                close_touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.close(); }
                                }

                                Image {
                                    source: @image-url("../../assets/icons/x.svg");
                                    width: 14px;
                                    height: 14px;
                                    colorize: close_touch.has-hover ? #f43f5e : AppTheme.text_muted;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }
                    }
                }
            }

            // Divider below header
            Rectangle {
                height: 1px;
                background: AppTheme.border_subtle;
            }

            // Content Container
            VerticalLayout {
                padding: 18px;
                spacing: 14px;

                // Section 1: Presets
                Rectangle {
                    background: AppTheme.surface_card;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: AppTheme.border_subtle;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 10px;

                        // Title & Actions Row
                        HorizontalLayout {
                            alignment: space-between;

                            Text {
                                text: "色彩预设方案";
                                font-size: 11.5px;
                                font-weight: 700;
                                color: AppTheme.text_primary;
                                vertical-alignment: center;
                            }

                            HorizontalLayout {
                                spacing: 8px;

                                // Load .json
                                Rectangle {
                                    height: 24px;
                                    border-radius: 5px;
                                    background: #3b82f61a;
                                    border-width: 1px;
                                    border-color: #3b82f660;
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.import_json(); }
                                    }
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 5px;
                                        Image {
                                            source: @image-url("../../assets/icons/folder.svg");
                                            width: 11px;
                                            height: 11px;
                                            colorize: #60a5fa;
                                            y: (parent.height - self.height) / 2;
                                        }
                                        Text {
                                            text: "加载 .json";
                                            font-size: 10px;
                                            font-weight: 600;
                                            color: #60a5fa;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Export .json
                                Rectangle {
                                    height: 24px;
                                    border-radius: 5px;
                                    background: AppTheme.surface_pill;
                                    border-width: 1px;
                                    border-color: AppTheme.border_subtle;
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.export_json(); }
                                    }
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 5px;
                                        Image {
                                            source: @image-url("../../assets/icons/download.svg");
                                            width: 11px;
                                            height: 11px;
                                            colorize: AppTheme.text_secondary;
                                            y: (parent.height - self.height) / 2;
                                        }
                                        Text {
                                            text: "导出 .json";
                                            font-size: 10px;
                                            color: AppTheme.text_secondary;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Undo / Reset
                                Rectangle {
                                    height: 24px;
                                    border-radius: 5px;
                                    background: root.is_modified ? #ef444420 : AppTheme.surface_pill;
                                    border-width: 1px;
                                    border-color: root.is_modified ? #ef444460 : AppTheme.border_subtle;
                                    opacity: root.is_modified ? 1.0 : 0.5;
                                    TouchArea {
                                        mouse-cursor: root.is_modified ? pointer : default;
                                        clicked => {
                                            if (root.is_modified) {
                                                if (root.active_preset_id == "preset_vibrant") {
                                                    root.cur_temp_k = 6500; root.cur_saturation = 150; root.cur_contrast = 100; root.cur_gamma = 100;
                                                    root.cur_gain_r = 100; root.cur_gain_g = 100; root.cur_gain_b = 100;
                                                }
                                                if (root.active_preset_id == "preset_internet") {
                                                    root.cur_temp_k = 6500; root.cur_saturation = 110; root.cur_contrast = 100; root.cur_gamma = 100;
                                                    root.cur_gain_r = 100; root.cur_gain_g = 100; root.cur_gain_b = 100;
                                                }
                                                if (root.active_preset_id == "preset_video") {
                                                    root.cur_temp_k = 6500; root.cur_saturation = 130; root.cur_contrast = 115; root.cur_gamma = 95;
                                                    root.cur_gain_r = 100; root.cur_gain_g = 100; root.cur_gain_b = 100;
                                                }
                                                if (root.active_preset_id == "preset_eyecare") {
                                                    root.cur_temp_k = 4800; root.cur_saturation = 95; root.cur_contrast = 95; root.cur_gamma = 105;
                                                    root.cur_gain_r = 105; root.cur_gain_g = 100; root.cur_gain_b = 80;
                                                }
                                                if (root.active_preset_id == "preset_cinema") {
                                                    root.cur_temp_k = 6200; root.cur_saturation = 140; root.cur_contrast = 120; root.cur_gamma = 90;
                                                    root.cur_gain_r = 100; root.cur_gain_g = 98; root.cur_gain_b = 102;
                                                }
                                                if (root.active_preset_id == "preset_standard") {
                                                    root.cur_temp_k = 6500; root.cur_saturation = 100; root.cur_contrast = 100; root.cur_gamma = 100;
                                                    root.cur_gain_r = 100; root.cur_gain_g = 100; root.cur_gain_b = 100;
                                                }
                                                root.is_modified = false;
                                                root.reset_preset();
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 5px;
                                        Image {
                                            source: @image-url("../../assets/icons/rotate-ccw.svg");
                                            width: 11px;
                                            height: 11px;
                                            colorize: root.is_modified ? #f87171 : AppTheme.text_muted;
                                            y: (parent.height - self.height) / 2;
                                        }
                                        Text {
                                            text: "撤销更改";
                                            font-size: 10px;
                                            font-weight: 600;
                                            color: root.is_modified ? #f87171 : AppTheme.text_muted;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        // 6 Presets Grid Row 1 (3 items)
                        HorizontalLayout {
                            spacing: 8px;

                            // 1. Vibrant
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 38px;
                                border-radius: 6px;
                                background: root.active_preset_id == "preset_vibrant" ? #ec489926 : AppTheme.surface_pill;
                                border-width: 1px;
                                border-color: root.active_preset_id == "preset_vibrant" ? #ec489999 : AppTheme.border_subtle;
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                    root.active_preset_id = "preset_vibrant";
                                    root.cur_temp_k = 6500;
                                    root.cur_saturation = 150;
                                    root.cur_contrast = 100;
                                    root.cur_gamma = 100;
                                    root.cur_gain_r = 100;
                                    root.cur_gain_g = 100;
                                    root.cur_gain_b = 100;
                                    root.is_modified = false;
                                    root.select_preset("preset_vibrant");
                                }
                                }
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    alignment: space-between;
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Image {
                                            source: @image-url("../../assets/icons/star.svg");
                                            width: 13px;
                                            height: 13px;
                                            colorize: #f59e0b;
                                            y: (parent.height - self.height) / 2;
                                        }
                                        Text {
                                            text: "多彩鲜艳";
                                            font-size: 11px;
                                            font-weight: root.active_preset_id == "preset_vibrant" ? 700 : 500;
                                            color: root.active_preset_id == "preset_vibrant" ? #ffffff : AppTheme.text_primary;
                                            vertical-alignment: center;
                                        }
                                    }
                                    if root.active_preset_id == "preset_vibrant" && root.is_modified: Text {
                                        text: "微调";
                                        font-size: 9px;
                                        font-weight: 700;
                                        color: #fbbf24;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // 2. Internet / Office
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 38px;
                                border-radius: 6px;
                                background: root.active_preset_id == "preset_internet" ? #ec489926 : AppTheme.surface_pill;
                                border-width: 1px;
                                border-color: root.active_preset_id == "preset_internet" ? #ec489999 : AppTheme.border_subtle;
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                    root.active_preset_id = "preset_internet";
                                    root.cur_temp_k = 6500;
                                    root.cur_saturation = 110;
                                    root.cur_contrast = 100;
                                    root.cur_gamma = 100;
                                    root.cur_gain_r = 100;
                                    root.cur_gain_g = 100;
                                    root.cur_gain_b = 100;
                                    root.is_modified = false;
                                    root.select_preset("preset_internet");
                                }
                                }
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    alignment: space-between;
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Image {
                                            source: @image-url("../../assets/icons/monitor.svg");
                                            width: 13px;
                                            height: 13px;
                                            colorize: #38bdf8;
                                            y: (parent.height - self.height) / 2;
                                        }
                                        Text {
                                            text: "互联网/办公";
                                            font-size: 11px;
                                            font-weight: root.active_preset_id == "preset_internet" ? 700 : 500;
                                            color: root.active_preset_id == "preset_internet" ? #ffffff : AppTheme.text_primary;
                                            vertical-alignment: center;
                                        }
                                    }
                                    if root.active_preset_id == "preset_internet" && root.is_modified: Text {
                                        text: "微调";
                                        font-size: 9px;
                                        font-weight: 700;
                                        color: #fbbf24;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // 3. Video
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 38px;
                                border-radius: 6px;
                                background: root.active_preset_id == "preset_video" ? #ec489926 : AppTheme.surface_pill;
                                border-width: 1px;
                                border-color: root.active_preset_id == "preset_video" ? #ec489999 : AppTheme.border_subtle;
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                    root.active_preset_id = "preset_video";
                                    root.cur_temp_k = 6500;
                                    root.cur_saturation = 130;
                                    root.cur_contrast = 115;
                                    root.cur_gamma = 95;
                                    root.cur_gain_r = 100;
                                    root.cur_gain_g = 100;
                                    root.cur_gain_b = 100;
                                    root.is_modified = false;
                                    root.select_preset("preset_video");
                                }
                                }
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    alignment: space-between;
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Image {
                                            source: @image-url("../../assets/icons/layers.svg");
                                            width: 13px;
                                            height: 13px;
                                            colorize: #818cf8;
                                            y: (parent.height - self.height) / 2;
                                        }
                                        Text {
                                            text: "电影娱乐";
                                            font-size: 11px;
                                            font-weight: root.active_preset_id == "preset_video" ? 700 : 500;
                                            color: root.active_preset_id == "preset_video" ? #ffffff : AppTheme.text_primary;
                                            vertical-alignment: center;
                                        }
                                    }
                                    if root.active_preset_id == "preset_video" && root.is_modified: Text {
                                        text: "微调";
                                        font-size: 9px;
                                        font-weight: 700;
                                        color: #fbbf24;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // Presets Row 2 (3 items)
                        HorizontalLayout {
                            spacing: 8px;

                            // 4. Eyecare
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 38px;
                                border-radius: 6px;
                                background: root.active_preset_id == "preset_eyecare" ? #ec489926 : AppTheme.surface_pill;
                                border-width: 1px;
                                border-color: root.active_preset_id == "preset_eyecare" ? #ec489999 : AppTheme.border_subtle;
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                    root.active_preset_id = "preset_eyecare";
                                    root.cur_temp_k = 4800;
                                    root.cur_saturation = 95;
                                    root.cur_contrast = 95;
                                    root.cur_gamma = 105;
                                    root.cur_gain_r = 105;
                                    root.cur_gain_g = 100;
                                    root.cur_gain_b = 80;
                                    root.is_modified = false;
                                    root.select_preset("preset_eyecare");
                                }
                                }
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    alignment: space-between;
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Image {
                                            source: @image-url("../../assets/icons/eyes.svg");
                                            width: 13px;
                                            height: 13px;
                                            colorize: #34d399;
                                            y: (parent.height - self.height) / 2;
                                        }
                                        Text {
                                            text: "防蓝光护眼";
                                            font-size: 11px;
                                            font-weight: root.active_preset_id == "preset_eyecare" ? 700 : 500;
                                            color: root.active_preset_id == "preset_eyecare" ? #ffffff : AppTheme.text_primary;
                                            vertical-alignment: center;
                                        }
                                    }
                                    if root.active_preset_id == "preset_eyecare" && root.is_modified: Text {
                                        text: "微调";
                                        font-size: 9px;
                                        font-weight: 700;
                                        color: #fbbf24;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // 5. Cinema
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 38px;
                                border-radius: 6px;
                                background: root.active_preset_id == "preset_cinema" ? #ec489926 : AppTheme.surface_pill;
                                border-width: 1px;
                                border-color: root.active_preset_id == "preset_cinema" ? #ec489999 : AppTheme.border_subtle;
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                    root.active_preset_id = "preset_cinema";
                                    root.cur_temp_k = 6200;
                                    root.cur_saturation = 140;
                                    root.cur_contrast = 120;
                                    root.cur_gamma = 90;
                                    root.cur_gain_r = 100;
                                    root.cur_gain_g = 98;
                                    root.cur_gain_b = 102;
                                    root.is_modified = false;
                                    root.select_preset("preset_cinema");
                                }
                                }
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    alignment: space-between;
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Image {
                                            source: @image-url("../../assets/icons/coffee.svg");
                                            width: 13px;
                                            height: 13px;
                                            colorize: #c084fc;
                                            y: (parent.height - self.height) / 2;
                                        }
                                        Text {
                                            text: "影院震撼";
                                            font-size: 11px;
                                            font-weight: root.active_preset_id == "preset_cinema" ? 700 : 500;
                                            color: root.active_preset_id == "preset_cinema" ? #ffffff : AppTheme.text_primary;
                                            vertical-alignment: center;
                                        }
                                    }
                                    if root.active_preset_id == "preset_cinema" && root.is_modified: Text {
                                        text: "微调";
                                        font-size: 9px;
                                        font-weight: 700;
                                        color: #fbbf24;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // 6. Standard
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 38px;
                                border-radius: 6px;
                                background: root.active_preset_id == "preset_standard" ? #ec489926 : AppTheme.surface_pill;
                                border-width: 1px;
                                border-color: root.active_preset_id == "preset_standard" ? #ec489999 : AppTheme.border_subtle;
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                    root.active_preset_id = "preset_standard";
                                    root.cur_temp_k = 6500;
                                    root.cur_saturation = 100;
                                    root.cur_contrast = 100;
                                    root.cur_gamma = 100;
                                    root.cur_gain_r = 100;
                                    root.cur_gain_g = 100;
                                    root.cur_gain_b = 100;
                                    root.is_modified = false;
                                    root.select_preset("preset_standard");
                                }
                                }
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    alignment: space-between;
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Image {
                                            source: @image-url("../../assets/icons/palette.svg");
                                            width: 13px;
                                            height: 13px;
                                            colorize: #94a3b8;
                                            y: (parent.height - self.height) / 2;
                                        }
                                        Text {
                                            text: "标准出厂";
                                            font-size: 11px;
                                            font-weight: root.active_preset_id == "preset_standard" ? 700 : 500;
                                            color: root.active_preset_id == "preset_standard" ? #ffffff : AppTheme.text_primary;
                                            vertical-alignment: center;
                                        }
                                    }
                                    if root.active_preset_id == "preset_standard" && root.is_modified: Text {
                                        text: "微调";
                                        font-size: 9px;
                                        font-weight: 700;
                                        color: #fbbf24;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                // Section 2: Real-time Hardware Sliders
                Rectangle {
                    background: AppTheme.surface_card;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: AppTheme.border_subtle;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 12px;

                        Text {
                            text: "实时显卡硬件微调 (所见即所得，毫秒级生效)";
                            font-size: 11.5px;
                            font-weight: 700;
                            color: AppTheme.text_primary;
                        }

                        // 1. Color Temp Slider (4000K - 9000K)
                        VerticalLayout {
                            spacing: 4px;
                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: "色温 (Color Temperature)";
                                    font-size: 11px;
                                    color: AppTheme.text_secondary;
                                }
                                Text {
                                    text: root.cur_temp_k + " K";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: #f59e0b;
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "4000K 暖黄"; font-size: 9.5px; color: AppTheme.text_muted; vertical-alignment: center; }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 20px;
                                    // 完整底槽，width: 100% 贯穿
                                    Rectangle {
                                        x: 0;
                                        y: (parent.height - self.height) / 2;
                                        width: parent.width;
                                        height: 4px;
                                        background: AppTheme.surface_pill;
                                        border-radius: 2px;
                                        Rectangle {
                                            x: 0;
                                            y: 0;
                                            width: parent.width * Math.max(0.0, Math.min(1.0, (root.cur_temp_k - 4000) / 5000.0));
                                            height: 100%;
                                            background: #f59e0b;
                                            border-radius: 2px;
                                        }
                                    }
                                    Rectangle {
                                        x: (parent.width - self.width) * Math.max(0.0, Math.min(1.0, (root.cur_temp_k - 4000) / 5000.0));
                                        y: (parent.height - self.height) / 2;
                                        width: 14px;
                                        height: 14px;
                                        border-radius: 7px;
                                        background: #ffffff;
                                        border-width: 3px;
                                        border-color: #f59e0b;
                                    }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        pointer-event(event) => {
                                            if (event.kind == PointerEventKind.down || event.kind == PointerEventKind.move) {
                                                if (self.pressed) {
                                                    root.is_modified = true;
                                                    root.cur_temp_k = Math.max(4000, Math.min(9000, 4000 + Math.round(self.mouse-x / parent.width * 100) * 50));
                                                    root.change_temp_k(root.cur_temp_k);
                                                }
                                            }
                                        }
                                        clicked => {
                                            root.is_modified = true;
                                            root.cur_temp_k = Math.max(4000, Math.min(9000, 4000 + Math.round(self.mouse-x / parent.width * 100) * 50));
                                            root.change_temp_k(root.cur_temp_k);
                                        }
                                    }
                                }
                                Text { text: "9000K 冷蓝"; font-size: 9.5px; color: AppTheme.text_muted; vertical-alignment: center; }
                            }
                        }

                        // 2. Saturation / Vibrance (0% - 200%)
                        VerticalLayout {
                            spacing: 4px;
                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: "色彩鲜艳度 / 饱和度 (Vibrance)";
                                    font-size: 11px;
                                    color: AppTheme.text_secondary;
                                }
                                Text {
                                    text: root.cur_saturation + "%";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: #ec4899;
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "0% 黑白"; font-size: 9.5px; color: AppTheme.text_muted; vertical-alignment: center; }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 20px;
                                    Rectangle {
                                        x: 0;
                                        y: (parent.height - self.height) / 2;
                                        width: parent.width;
                                        height: 4px;
                                        background: AppTheme.surface_pill;
                                        border-radius: 2px;
                                        Rectangle {
                                            x: 0;
                                            y: 0;
                                            width: parent.width * Math.max(0.0, Math.min(1.0, root.cur_saturation / 200.0));
                                            height: 100%;
                                            background: #ec4899;
                                            border-radius: 2px;
                                        }
                                    }
                                    Rectangle {
                                        x: (parent.width - self.width) * Math.max(0.0, Math.min(1.0, root.cur_saturation / 200.0));
                                        y: (parent.height - self.height) / 2;
                                        width: 14px;
                                        height: 14px;
                                        border-radius: 7px;
                                        background: #ffffff;
                                        border-width: 3px;
                                        border-color: #ec4899;
                                    }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        pointer-event(event) => {
                                            if (event.kind == PointerEventKind.down || event.kind == PointerEventKind.move) {
                                                if (self.pressed) {
                                                    root.is_modified = true;
                                                    root.cur_saturation = Math.max(0, Math.min(200, Math.round(self.mouse-x / parent.width * 40) * 5));
                                                    root.change_saturation(root.cur_saturation);
                                                }
                                            }
                                        }
                                        clicked => {
                                            root.is_modified = true;
                                            root.cur_saturation = Math.max(0, Math.min(200, Math.round(self.mouse-x / parent.width * 40) * 5));
                                            root.change_saturation(root.cur_saturation);
                                        }
                                    }
                                }
                                Text { text: "200% 浓艳"; font-size: 9.5px; color: AppTheme.text_muted; vertical-alignment: center; }
                            }
                        }

                        // 3. Contrast (50% - 150%)
                        VerticalLayout {
                            spacing: 4px;
                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: "对比度 (Contrast)";
                                    font-size: 11px;
                                    color: AppTheme.text_secondary;
                                }
                                Text {
                                    text: root.cur_contrast + "%";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: #38bdf8;
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "50% 柔和"; font-size: 9.5px; color: AppTheme.text_muted; vertical-alignment: center; }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 20px;
                                    Rectangle {
                                        x: 0;
                                        y: (parent.height - self.height) / 2;
                                        width: parent.width;
                                        height: 4px;
                                        background: AppTheme.surface_pill;
                                        border-radius: 2px;
                                        Rectangle {
                                            x: 0;
                                            y: 0;
                                            width: parent.width * Math.max(0.0, Math.min(1.0, (root.cur_contrast - 50) / 100.0));
                                            height: 100%;
                                            background: #38bdf8;
                                            border-radius: 2px;
                                        }
                                    }
                                    Rectangle {
                                        x: (parent.width - self.width) * Math.max(0.0, Math.min(1.0, (root.cur_contrast - 50) / 100.0));
                                        y: (parent.height - self.height) / 2;
                                        width: 14px;
                                        height: 14px;
                                        border-radius: 7px;
                                        background: #ffffff;
                                        border-width: 3px;
                                        border-color: #38bdf8;
                                    }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        pointer-event(event) => {
                                            if (event.kind == PointerEventKind.down || event.kind == PointerEventKind.move) {
                                                if (self.pressed) {
                                                    root.is_modified = true;
                                                    root.cur_contrast = Math.max(50, Math.min(150, 50 + Math.round(self.mouse-x / parent.width * 20) * 5));
                                                    root.change_contrast(root.cur_contrast);
                                                }
                                            }
                                        }
                                        clicked => {
                                            root.is_modified = true;
                                            root.cur_contrast = Math.max(50, Math.min(150, 50 + Math.round(self.mouse-x / parent.width * 20) * 5));
                                            root.change_contrast(root.cur_contrast);
                                        }
                                    }
                                }
                                Text { text: "150% 鲜明"; font-size: 9.5px; color: AppTheme.text_muted; vertical-alignment: center; }
                            }
                        }

                        // 4. Gamma (0.70 - 1.30, stored as 70 - 130)
                        VerticalLayout {
                            spacing: 4px;
                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: "伽马曲线 (Gamma)";
                                    font-size: 11px;
                                    color: AppTheme.text_secondary;
                                }
                                Text {
                                    text: (root.cur_gamma / 100.0) + "";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: #a855f7;
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "0.7 暗部深沉"; font-size: 9.5px; color: AppTheme.text_muted; vertical-alignment: center; }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 20px;
                                    Rectangle {
                                        x: 0;
                                        y: (parent.height - self.height) / 2;
                                        width: parent.width;
                                        height: 4px;
                                        background: AppTheme.surface_pill;
                                        border-radius: 2px;
                                        Rectangle {
                                            x: 0;
                                            y: 0;
                                            width: parent.width * Math.max(0.0, Math.min(1.0, (root.cur_gamma - 70) / 60.0));
                                            height: 100%;
                                            background: #a855f7;
                                            border-radius: 2px;
                                        }
                                    }
                                    Rectangle {
                                        x: (parent.width - self.width) * Math.max(0.0, Math.min(1.0, (root.cur_gamma - 70) / 60.0));
                                        y: (parent.height - self.height) / 2;
                                        width: 14px;
                                        height: 14px;
                                        border-radius: 7px;
                                        background: #ffffff;
                                        border-width: 3px;
                                        border-color: #a855f7;
                                    }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        pointer-event(event) => {
                                            if (event.kind == PointerEventKind.down || event.kind == PointerEventKind.move) {
                                                if (self.pressed) {
                                                    root.is_modified = true;
                                                    root.cur_gamma = Math.max(70, Math.min(130, 70 + Math.round(self.mouse-x / parent.width * 12) * 5));
                                                    root.change_gamma(root.cur_gamma);
                                                }
                                            }
                                        }
                                        clicked => {
                                            root.is_modified = true;
                                            root.cur_gamma = Math.max(70, Math.min(130, 70 + Math.round(self.mouse-x / parent.width * 12) * 5));
                                            root.change_gamma(root.cur_gamma);
                                        }
                                    }
                                }
                                Text { text: "1.3 暗部通透"; font-size: 9.5px; color: AppTheme.text_muted; vertical-alignment: center; }
                            }
                        }

                        // Foldable Advanced RGB Gain Section
                        Rectangle {
                            height: 1px;
                            background: AppTheme.border_subtle;
                        }

                        HorizontalLayout {
                            alignment: space-between;
                            Rectangle {
                                height: 24px;
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.show_rgb_channels = !root.show_rgb_channels; }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    Text {
                                        text: root.show_rgb_channels ? "收起 RGB 独立原色增益微调" : "展开 RGB 独立原色增益微调";
                                        font-size: 10.5px;
                                        color: AppTheme.text_secondary;
                                        vertical-alignment: center;
                                    }
                                    Image {
                                        source: @image-url("../../assets/icons/chevron-down.svg");
                                        width: 11px;
                                        height: 11px;
                                        colorize: AppTheme.text_muted;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                            }
                        }

                        if root.show_rgb_channels: VerticalLayout {
                            spacing: 8px;

                            // Red (R)
                            HorizontalLayout {
                                spacing: 8px;
                                Text { width: 75px; text: "红 (R): " + root.cur_gain_r + "%"; font-size: 10px; color: #f87171; vertical-alignment: center; }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 18px;
                                    Rectangle {
                                        x: 0;
                                        y: (parent.height - self.height) / 2;
                                        width: parent.width;
                                        height: 3px;
                                        background: AppTheme.surface_pill;
                                        border-radius: 1.5px;
                                        Rectangle {
                                            x: 0;
                                            y: 0;
                                            width: parent.width * Math.max(0.0, Math.min(1.0, (root.cur_gain_r - 50) / 100.0));
                                            height: 100%;
                                            background: #ef4444;
                                            border-radius: 1.5px;
                                        }
                                    }
                                    Rectangle {
                                        x: (parent.width - self.width) * Math.max(0.0, Math.min(1.0, (root.cur_gain_r - 50) / 100.0));
                                        y: (parent.height - self.height) / 2;
                                        width: 12px;
                                        height: 12px;
                                        border-radius: 6px;
                                        background: #ffffff;
                                        border-width: 2.5px;
                                        border-color: #ef4444;
                                    }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        pointer-event(event) => {
                                            if (event.kind == PointerEventKind.down || event.kind == PointerEventKind.move) {
                                                if (self.pressed) {
                                                    root.is_modified = true;
                                                    root.cur_gain_r = Math.max(50, Math.min(150, 50 + Math.round(self.mouse-x / parent.width * 50) * 2));
                                                    root.change_gain_r(root.cur_gain_r);
                                                }
                                            }
                                        }
                                        clicked => {
                                            root.is_modified = true;
                                            root.cur_gain_r = Math.max(50, Math.min(150, 50 + Math.round(self.mouse-x / parent.width * 50) * 2));
                                            root.change_gain_r(root.cur_gain_r);
                                        }
                                    }
                                }
                            }

                            // Green (G)
                            HorizontalLayout {
                                spacing: 8px;
                                Text { width: 75px; text: "绿 (G): " + root.cur_gain_g + "%"; font-size: 10px; color: #4ade80; vertical-alignment: center; }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 18px;
                                    Rectangle {
                                        x: 0;
                                        y: (parent.height - self.height) / 2;
                                        width: parent.width;
                                        height: 3px;
                                        background: AppTheme.surface_pill;
                                        border-radius: 1.5px;
                                        Rectangle {
                                            x: 0;
                                            y: 0;
                                            width: parent.width * Math.max(0.0, Math.min(1.0, (root.cur_gain_g - 50) / 100.0));
                                            height: 100%;
                                            background: #22c55e;
                                            border-radius: 1.5px;
                                        }
                                    }
                                    Rectangle {
                                        x: (parent.width - self.width) * Math.max(0.0, Math.min(1.0, (root.cur_gain_g - 50) / 100.0));
                                        y: (parent.height - self.height) / 2;
                                        width: 12px;
                                        height: 12px;
                                        border-radius: 6px;
                                        background: #ffffff;
                                        border-width: 2.5px;
                                        border-color: #22c55e;
                                    }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        pointer-event(event) => {
                                            if (event.kind == PointerEventKind.down || event.kind == PointerEventKind.move) {
                                                if (self.pressed) {
                                                    root.is_modified = true;
                                                    root.cur_gain_g = Math.max(50, Math.min(150, 50 + Math.round(self.mouse-x / parent.width * 50) * 2));
                                                    root.change_gain_g(root.cur_gain_g);
                                                }
                                            }
                                        }
                                        clicked => {
                                            root.is_modified = true;
                                            root.cur_gain_g = Math.max(50, Math.min(150, 50 + Math.round(self.mouse-x / parent.width * 50) * 2));
                                            root.change_gain_g(root.cur_gain_g);
                                        }
                                    }
                                }
                            }

                            // Blue (B)
                            HorizontalLayout {
                                spacing: 8px;
                                Text { width: 75px; text: "蓝 (B): " + root.cur_gain_b + "%"; font-size: 10px; color: #60a5fa; vertical-alignment: center; }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 18px;
                                    Rectangle {
                                        x: 0;
                                        y: (parent.height - self.height) / 2;
                                        width: parent.width;
                                        height: 3px;
                                        background: AppTheme.surface_pill;
                                        border-radius: 1.5px;
                                        Rectangle {
                                            x: 0;
                                            y: 0;
                                            width: parent.width * Math.max(0.0, Math.min(1.0, (root.cur_gain_b - 50) / 100.0));
                                            height: 100%;
                                            background: #3b82f6;
                                            border-radius: 1.5px;
                                        }
                                    }
                                    Rectangle {
                                        x: (parent.width - self.width) * Math.max(0.0, Math.min(1.0, (root.cur_gain_b - 50) / 100.0));
                                        y: (parent.height - self.height) / 2;
                                        width: 12px;
                                        height: 12px;
                                        border-radius: 6px;
                                        background: #ffffff;
                                        border-width: 2.5px;
                                        border-color: #3b82f6;
                                    }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        pointer-event(event) => {
                                            if (event.kind == PointerEventKind.down || event.kind == PointerEventKind.move) {
                                                if (self.pressed) {
                                                    root.is_modified = true;
                                                    root.cur_gain_b = Math.max(50, Math.min(150, 50 + Math.round(self.mouse-x / parent.width * 50) * 2));
                                                    root.change_gain_b(root.cur_gain_b);
                                                }
                                            }
                                        }
                                        clicked => {
                                            root.is_modified = true;
                                            root.cur_gain_b = Math.max(50, Math.min(150, 50 + Math.round(self.mouse-x / parent.width * 50) * 2));
                                            root.change_gain_b(root.cur_gain_b);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
