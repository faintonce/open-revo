import { AppTheme } from "../../theme.slint";

export component MonitorRefreshCard inherits Rectangle {
    in-out property <string> title: "屏幕刷新率";
    in-out property <string> monitor_name: "京东方 (主屏)";
    in-out property <int> refresh_rate: 240;
    in-out property <[int]> rates_row1: [60, 144, 240];
    in-out property <[int]> rates_row2: [];
    in-out property <bool> has_secondary_monitor: false;
    in-out property <string> primary_monitor_name: "京东方 (主屏)";
    in-out property <string> secondary_monitor_name: "外接副屏";

    callback refresh_rate_switched(int);
    callback select_monitor_index(int);

    background: AppTheme.surface_card;
    border-radius: 8px;
    border-width: 1px;
    border-color: AppTheme.border_subtle;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 10px;
        padding-bottom: 10px;
        alignment: space-between;

        // Left: Icon + Title + Dynamic Monitor Pill
        HorizontalLayout {
            spacing: 10px;
            alignment: start;

            VerticalLayout {
                alignment: center;
                Image {
                    source: @image-url("../../assets/icons/monitor.svg");
                    width: 18px;
                    height: 18px;
                    colorize: #38bdf8;
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;

                Text {
                    text: root.title;
                    font-size: 11.5px;
                    font-weight: 700;
                    color: AppTheme.text_primary;
                }

                // Monitor Dropdown Pill
                mon_btn := Rectangle {
                    border-radius: 4px;
                    background: (root.has_secondary_monitor && t_mon.has-hover) ? AppTheme.surface_card_hover : AppTheme.surface_pill;
                    border-width: 1px;
                    border-color: AppTheme.border_subtle;
                    height: 20px;

                    t_mon := TouchArea {
                        mouse-cursor: root.has_secondary_monitor ? pointer : default;
                        clicked => {
                            if (root.has_secondary_monitor) {
                                mon_popup.show();
                            }
                        }
                    }

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 4px;

                        Image {
                            source: @image-url("../../assets/icons/monitor.svg");
                            width: 10px;
                            height: 10px;
                            colorize: AppTheme.text_muted;
                            y: (parent.height - self.height) / 2;
                        }

                        Text {
                            text: root.monitor_name;
                            font-size: 9px;
                            color: AppTheme.text_secondary;
                            vertical-alignment: center;
                        }

                        // Chevron arrow ONLY displayed when secondary monitor actually exists
                        if root.has_secondary_monitor: Image {
                            source: @image-url("../../assets/icons/chevron-down.svg");
                            width: 8px;
                            height: 8px;
                            colorize: AppTheme.text_muted;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    mon_popup := PopupWindow {
                        x: 0px;
                        y: 22px;
                        width: 180px;

                        Rectangle {
                            background: AppTheme.surface_elevated;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: AppTheme.border_medium;
                            drop-shadow-blur: 8px;
                            drop-shadow-color: #00000080;

                            VerticalLayout {
                                padding: 4px;
                                spacing: 2px;

                                // Item 0: Builtin Primary Monitor
                                Rectangle {
                                    height: 26px;
                                    border-radius: 4px;
                                    background: t_m0.has-hover ? AppTheme.surface_pill : transparent;
                                    t_m0 := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.select_monitor_index(0);
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text {
                                            text: root.primary_monitor_name != "" ? root.primary_monitor_name : "内置主屏";
                                            font-size: 10px;
                                            color: AppTheme.text_primary;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                }

                                // Item 1: External Secondary Monitor (Strictly conditional)
                                if root.has_secondary_monitor: Rectangle {
                                    height: 26px;
                                    border-radius: 4px;
                                    background: t_m1.has-hover ? AppTheme.surface_pill : transparent;
                                    t_m1 := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.select_monitor_index(1);
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text {
                                            text: root.secondary_monitor_name != "" ? root.secondary_monitor_name : "外接副屏 / 扩展显示器";
                                            font-size: 10px;
                                            color: AppTheme.text_secondary;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Right: Dynamic Supported Refresh Rates (Wrap into 2 clean rows if many rates)
        VerticalLayout {
            alignment: center;
            spacing: 4px;

            // Row 1
            HorizontalLayout {
                spacing: 4px;
                alignment: end;

                for rate in root.rates_row1: Rectangle {
                    border-radius: 4px;
                    background: root.refresh_rate == rate ? #38bdf825 : AppTheme.surface_pill;
                    border-width: 1px;
                    border-color: root.refresh_rate == rate ? #38bdf8 : AppTheme.border_subtle;
                    height: 22px;
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.refresh_rate_switched(rate); }
                    }
                    HorizontalLayout {
                        padding-left: 7px;
                        padding-right: 7px;
                        Text {
                            text: rate + "Hz";
                            font-size: 9.5px;
                            font-weight: root.refresh_rate == rate ? 700 : 500;
                            color: root.refresh_rate == rate ? #38bdf8 : AppTheme.text_primary;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Row 2 (rendered cleanly only if there are overflow rates)
            if root.rates_row2.length > 0: HorizontalLayout {
                spacing: 4px;
                alignment: end;

                for rate in root.rates_row2: Rectangle {
                    border-radius: 4px;
                    background: root.refresh_rate == rate ? #38bdf825 : AppTheme.surface_pill;
                    border-width: 1px;
                    border-color: root.refresh_rate == rate ? #38bdf8 : AppTheme.border_subtle;
                    height: 22px;
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.refresh_rate_switched(rate); }
                    }
                    HorizontalLayout {
                        padding-left: 7px;
                        padding-right: 7px;
                        Text {
                            text: rate + "Hz";
                            font-size: 9.5px;
                            font-weight: root.refresh_rate == rate ? 700 : 500;
                            color: root.refresh_rate == rate ? #38bdf8 : AppTheme.text_primary;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
