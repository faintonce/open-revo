import { AppTheme } from "../../theme.slint";

export component CpuTempWallCard inherits Rectangle {
    in-out property <bool> is_amd: false;
    in-out property <int> temp_wall: 95;
    in-out property <bool> temp_wall_enabled: true;
    in-out property <int> temp_wall_max: 95;

    callback toggle_temp_wall();
    callback change_temp_wall(int);
    callback adjust_temp_wall_max(int);

    background: AppTheme.surface_pill;
    border-radius: AppTheme.radius_sm;
    border-width: 1px;
    border-color: AppTheme.border_subtle;

    VerticalLayout {
        padding: 8px;
        spacing: 6px;

        HorizontalLayout {
            alignment: space-between;
            Text {
                text: root.is_amd ? "温度墙上限 (TjMax):" : "温度墙上限:";
                font-size: 11px;
                color: AppTheme.text_secondary;
                vertical-alignment: center;
            }

            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.temp_wall + "°C";
                    font-size: 12px;
                    font-weight: 700;
                    color: root.temp_wall >= 96 ? AppTheme.mode_beast : #38bdf8;
                    vertical-alignment: center;
                }

                // Toggle Button
                Rectangle {
                    width: 44px;
                    height: 20px;
                    border-radius: 3px;
                    background: root.temp_wall_enabled ? #0284c730 : AppTheme.surface_card;
                    border-width: 1px;
                    border-color: root.temp_wall_enabled ? #38bdf8 : AppTheme.border_medium;

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.toggle_temp_wall();
                        }
                    }

                    Text {
                        text: root.temp_wall_enabled ? "已开启" : "关闭";
                        font-size: 9.5px;
                        font-weight: 700;
                        color: root.temp_wall_enabled ? #38bdf8 : AppTheme.text_muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Slider & Tcc
        HorizontalLayout {
            spacing: 8px;

            // Slider container (height: 20px, 宽敞舒适的点击与拖拽手感)
            Rectangle {
                height: 20px;
                background: transparent;
                vertical-stretch: 0;

                // Track line
                Rectangle {
                    height: 6px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 3px;
                    background: AppTheme.surface_card;
                    width: 100%;

                    // Fill
                    Rectangle {
                        x: 0;
                        width: parent.width * Math.clamp((root.temp_wall - 85) / Math.max(1, root.temp_wall_max - 85), 0, 1);
                        height: 100%;
                        border-radius: 3px;
                        background: root.temp_wall >= 96 ? AppTheme.mode_beast : #38bdf8;
                    }

                    // Thumb
                    Rectangle {
                        x: (parent.width - self.width) * Math.clamp((root.temp_wall - 85) / Math.max(1, root.temp_wall_max - 85), 0, 1);
                        y: (parent.height - self.height) / 2;
                        width: 14px;
                        height: 14px;
                        border-radius: 7px;
                        background: #ffffff;
                        border-width: 2px;
                        border-color: #38bdf8;
                    }
                }

                TouchArea {
                    width: 100%;
                    height: 100%;
                    mouse-cursor: pointer;
                    pointer-event(event) => {
                        if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                            let ratio = Math.clamp(self.mouse-x / self.width, 0, 1);
                            let val = Math.clamp(85 + Math.round(ratio * (root.temp_wall_max - 85)), 85, root.temp_wall_max);
                            root.temp_wall = val;
                            root.change_temp_wall(val);
                        }
                    }
                    moved => {
                        if self.pressed {
                            let ratio = Math.clamp(self.mouse-x / self.width, 0, 1);
                            let val = Math.clamp(85 + Math.round(ratio * (root.temp_wall_max - 85)), 85, root.temp_wall_max);
                            root.temp_wall = val;
                            root.change_temp_wall(val);
                        }
                    }
                }
            }

            Text {
                text: root.is_amd ? (root.temp_wall < 95 ? "限频" : "满血") : ("Tcc-" + (100 - root.temp_wall));
                font-size: 10px;
                color: AppTheme.text_muted;
                vertical-alignment: center;
                min-width: 32px;
                horizontal-alignment: right;
            }
        }

        // Range hints & -/+
        HorizontalLayout {
            alignment: space-between;
            Text {
                text: "85°C";
                font-size: 9px;
                color: AppTheme.text_muted;
            }
            HorizontalLayout {
                spacing: 4px;
                Text {
                    text: "上限: " + root.temp_wall_max + "°C";
                    font-size: 9px;
                    color: AppTheme.text_muted;
                    vertical-alignment: center;
                }
                // - btn
                Rectangle {
                    width: 16px;
                    height: 16px;
                    border-radius: 2px;
                    background: AppTheme.surface_card;
                    border-width: 1px;
                    border-color: AppTheme.border_medium;
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.temp_wall_max = Math.clamp(root.temp_wall_max - 1, 85, 105);
                            root.adjust_temp_wall_max(-1);
                        }
                    }
                    Text {
                        text: "-";
                        font-size: 11px;
                        color: AppTheme.text_secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                // + btn
                Rectangle {
                    width: 16px;
                    height: 16px;
                    border-radius: 2px;
                    background: AppTheme.surface_card;
                    border-width: 1px;
                    border-color: AppTheme.border_medium;
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.temp_wall_max = Math.clamp(root.temp_wall_max + 1, 85, 105);
                            root.adjust_temp_wall_max(1);
                        }
                    }
                    Text {
                        text: "+";
                        font-size: 11px;
                        color: AppTheme.text_secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

