import { AppTheme } from "../../theme.slint";

export component CpuTuningCol inherits Rectangle {
    background: AppTheme.surface_card;
    border-radius: AppTheme.radius_md;
    border-width: 1px;
    border-color: AppTheme.border_subtle;

    // Platform capabilities
    in-out property <string> cpu_vendor: "intel";      // "intel" | "amd"
    in-out property <string> cpu_tuning_type: "intel_pl"; // "intel_pl" | "amd_smu" | "none"
    in-out property <bool> cpu_supports_fppt: true;

    // Tuning values
    in-out property <int> temp_wall: 95;
    in-out property <bool> temp_wall_enabled: true;
    in-out property <int> temp_wall_max: 95;

    in-out property <int> pl1: 75;
    in-out property <int> pl1_max: 230;

    in-out property <int> pl2: 75;
    in-out property <int> pl2_max: 230;

    in-out property <int> pl4: 126;
    in-out property <int> pl4_max: 275;

    in-out property <bool> bios_oc_enabled: true;

    // Live Telemetry
    in-out property <int> cpu_temp: 67;
    in-out property <int> cpu_rpm: 3166;
    in-out property <string> cpu_watts: "19.9 W";
    in-out property <int> gpu_temp: 54;
    in-out property <int> gpu_rpm: 2123;
    in-out property <string> gpu_watts: "20.4 W";

    // Callbacks
    callback toggle_temp_wall();
    callback change_temp_wall(int);
    callback adjust_temp_wall_max(int);
    callback change_pl1(int);
    callback adjust_pl1_max(int);
    callback change_pl2(int);
    callback adjust_pl2_max(int);
    callback change_pl4(int);
    callback adjust_pl4_max(int);
    callback toggle_bios_oc();

    property <bool> is_amd: cpu_vendor == "amd" || cpu_tuning_type == "amd_smu";
    property <bool> is_disabled: cpu_tuning_type == "none";

    VerticalLayout {
        padding: 10px;
        spacing: 8px;

        // 1. Header
        HorizontalLayout {
            alignment: space-between;
            HorizontalLayout {
                spacing: 6px;
                Image {
                    source: @image-url("../../assets/icons/cpu.svg");
                    width: 15px;
                    height: 15px;
                    colorize: #38bdf8;
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    text: root.is_amd ? "AMD CPU 功耗与温控" : "CPU 功耗与温控";
                    font-size: 13px;
                    font-weight: 700;
                    color: #38bdf8;
                    vertical-alignment: center;
                }
            }
        }

        // 2. Thin Laptop Banner
        if root.is_disabled: Rectangle {
            background: AppTheme.surface_pill;
            border-radius: AppTheme.radius_xs;
            border-width: 1px;
            border-color: AppTheme.border_subtle;

            VerticalLayout {
                padding: 8px;
                Text {
                    text: "当前机型为轻薄本架构，不支持自定义 CPU 功耗限制与温度墙调节。功耗由预设模式自动调度。";
                    font-size: 10px;
                    color: AppTheme.text_muted;
                    wrap: word-wrap;
                }
            }
        }

        // 3. Temperature Wall
        Rectangle {
            background: AppTheme.surface_pill;
            border-radius: AppTheme.radius_sm;
            border-width: 1px;
            border-color: AppTheme.border_subtle;

            VerticalLayout {
                padding: 8px;
                spacing: 6px;

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: root.is_amd ? "温度墙上限 (TjMax):" : "温度墙上限:";
                        font-size: 11px;
                        color: AppTheme.text_secondary;
                        vertical-alignment: center;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: root.temp_wall + "°C";
                            font-size: 12px;
                            font-weight: 700;
                            color: root.temp_wall >= 96 ? AppTheme.mode_beast : #38bdf8;
                            vertical-alignment: center;
                        }

                        // Toggle Button
                        Rectangle {
                            width: 44px;
                            height: 20px;
                            border-radius: 3px;
                            background: root.temp_wall_enabled ? #0284c730 : AppTheme.surface_card;
                            border-width: 1px;
                            border-color: root.temp_wall_enabled ? #38bdf8 : AppTheme.border_medium;

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.temp_wall_enabled = !root.temp_wall_enabled;
                                    root.toggle_temp_wall();
                                }
                            }

                            Text {
                                text: root.temp_wall_enabled ? "已开启" : "关闭";
                                font-size: 9.5px;
                                font-weight: 700;
                                color: root.temp_wall_enabled ? #38bdf8 : AppTheme.text_muted;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Slider & Tcc
                HorizontalLayout {
                    spacing: 8px;

                    // Slider container (height: 20px, 宽敞舒适的点击与拖拽手感)
                    Rectangle {
                        height: 20px;
                        background: transparent;
                        vertical-stretch: 0;

                        // Track line
                        Rectangle {
                            height: 6px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 3px;
                            background: AppTheme.surface_card;
                            width: 100%;

                            // Fill
                            Rectangle {
                                x: 0;
                                width: parent.width * Math.clamp((root.temp_wall - 85) / Math.max(1, root.temp_wall_max - 85), 0, 1);
                                height: 100%;
                                border-radius: 3px;
                                background: root.temp_wall >= 96 ? AppTheme.mode_beast : #38bdf8;
                            }

                            // Thumb
                            Rectangle {
                                x: (parent.width - self.width) * Math.clamp((root.temp_wall - 85) / Math.max(1, root.temp_wall_max - 85), 0, 1);
                                y: (parent.height - self.height) / 2;
                                width: 14px;
                                height: 14px;
                                border-radius: 7px;
                                background: #ffffff;
                                border-width: 2px;
                                border-color: #38bdf8;
                            }
                        }

                        TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            pointer-event(event) => {
                                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                    let ratio = Math.clamp(self.mouse-x / self.width, 0, 1);
                                    let val = Math.clamp(85 + Math.round(ratio * (root.temp_wall_max - 85)), 85, root.temp_wall_max);
                                    root.temp_wall = val;
                                    root.change_temp_wall(val);
                                }
                            }
                            moved => {
                                if self.pressed {
                                    let ratio = Math.clamp(self.mouse-x / self.width, 0, 1);
                                    let val = Math.clamp(85 + Math.round(ratio * (root.temp_wall_max - 85)), 85, root.temp_wall_max);
                                    root.temp_wall = val;
                                    root.change_temp_wall(val);
                                }
                            }
                        }
                    }

                    Text {
                        text: root.is_amd ? (root.temp_wall < 95 ? "限频" : "满血") : ("Tcc-" + (100 - root.temp_wall));
                        font-size: 10px;
                        color: AppTheme.text_muted;
                        vertical-alignment: center;
                        min-width: 32px;
                        horizontal-alignment: right;
                    }
                }

                // Range hints & -/+
                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "85°C";
                        font-size: 9px;
                        color: AppTheme.text_muted;
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        Text {
                            text: "上限: " + root.temp_wall_max + "°C";
                            font-size: 9px;
                            color: AppTheme.text_muted;
                            vertical-alignment: center;
                        }
                        // - btn
                        Rectangle {
                            width: 16px;
                            height: 16px;
                            border-radius: 2px;
                            background: AppTheme.surface_card;
                            border-width: 1px;
                            border-color: AppTheme.border_medium;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.temp_wall_max = Math.clamp(root.temp_wall_max - 1, 85, 105);
                                    root.adjust_temp_wall_max(-1);
                                }
                            }
                            Text {
                                text: "-";
                                font-size: 11px;
                                color: AppTheme.text_secondary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        // + btn
                        Rectangle {
                            width: 16px;
                            height: 16px;
                            border-radius: 2px;
                            background: AppTheme.surface_card;
                            border-width: 1px;
                            border-color: AppTheme.border_medium;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.temp_wall_max = Math.clamp(root.temp_wall_max + 1, 85, 105);
                                    root.adjust_temp_wall_max(1);
                                }
                            }
                            Text {
                                text: "+";
                                font-size: 11px;
                                color: AppTheme.text_secondary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // 4. PL1 (Long Duration Power Limit / AMD SPL)
        Rectangle {
            background: AppTheme.surface_pill;
            border-radius: AppTheme.radius_sm;
            border-width: 1px;
            border-color: AppTheme.border_subtle;

            VerticalLayout {
                padding: 8px;
                spacing: 6px;
                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: root.is_amd ? "长时持续功耗 (SPL):" : "长时功耗 PL1:";
                        font-size: 11px;
                        color: AppTheme.text_secondary;
                        vertical-alignment: center;
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        Rectangle {
                            width: 42px;
                            height: 20px;
                            border-radius: 3px;
                            background: AppTheme.surface_card;
                            border-width: 1px;
                            border-color: #38bdf880;
                            Text {
                                text: root.pl1;
                                font-size: 11px;
                                font-weight: 700;
                                color: #38bdf8;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Text {
                            text: "W";
                            font-size: 10px;
                            color: AppTheme.text_muted;
                            vertical-alignment: center;
                        }
                    }
                }

                // Slider container (PL1)
                Rectangle {
                    height: 20px;
                    background: transparent;
                    vertical-stretch: 0;

                    // Track line
                    Rectangle {
                        height: 6px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 3px;
                        background: AppTheme.surface_card;
                        width: 100%;

                        // Fill
                        Rectangle {
                            x: 0;
                            width: parent.width * Math.clamp((root.pl1 - 15) / Math.max(1, root.pl1_max - 15), 0, 1);
                            height: 100%;
                            border-radius: 3px;
                            background: #38bdf8;
                        }

                        // Thumb
                        Rectangle {
                            x: (parent.width - self.width) * Math.clamp((root.pl1 - 15) / Math.max(1, root.pl1_max - 15), 0, 1);
                            y: (parent.height - self.height) / 2;
                            width: 14px;
                            height: 14px;
                            border-radius: 7px;
                            background: #ffffff;
                            border-width: 2px;
                            border-color: #38bdf8;
                        }
                    }

                    TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: pointer;
                        pointer-event(event) => {
                            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                let ratio = Math.clamp(self.mouse-x / self.width, 0, 1);
                                let val = Math.clamp(15 + Math.round(ratio * (root.pl1_max - 15)), 15, root.pl1_max);
                                root.pl1 = val;
                                root.change_pl1(val);
                            }
                        }
                        moved => {
                            if self.pressed {
                                let ratio = Math.clamp(self.mouse-x / self.width, 0, 1);
                                let val = Math.clamp(15 + Math.round(ratio * (root.pl1_max - 15)), 15, root.pl1_max);
                                root.pl1 = val;
                                root.change_pl1(val);
                            }
                        }
                    }
                }

                // Limit hint & buttons
                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "15W";
                        font-size: 9px;
                        color: AppTheme.text_muted;
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        Text {
                            text: "上限: " + root.pl1_max + "W";
                            font-size: 9px;
                            color: AppTheme.text_muted;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            width: 16px;
                            height: 16px;
                            border-radius: 2px;
                            background: AppTheme.surface_card;
                            border-width: 1px;
                            border-color: AppTheme.border_medium;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.pl1_max = Math.clamp(root.pl1_max - 5, 35, 275);
                                    root.adjust_pl1_max(-5);
                                }
                            }
                            Text {
                                text: "-";
                                font-size: 11px;
                                color: AppTheme.text_secondary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Rectangle {
                            width: 16px;
                            height: 16px;
                            border-radius: 2px;
                            background: AppTheme.surface_card;
                            border-width: 1px;
                            border-color: AppTheme.border_medium;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.pl1_max = Math.clamp(root.pl1_max + 5, 35, 275);
                                    root.adjust_pl1_max(5);
                                }
                            }
                            Text {
                                text: "+";
                                font-size: 11px;
                                color: AppTheme.text_secondary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // 5. PL2 (Short Duration Power Limit / AMD sPPT)
        Rectangle {
            background: AppTheme.surface_pill;
            border-radius: AppTheme.radius_sm;
            border-width: 1px;
            border-color: AppTheme.border_subtle;

            VerticalLayout {
                padding: 8px;
                spacing: 6px;
                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: root.is_amd ? "短时爆发功耗 (sPPT):" : "短时功耗 PL2:";
                        font-size: 11px;
                        color: AppTheme.text_secondary;
                        vertical-alignment: center;
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        Rectangle {
                            width: 42px;
                            height: 20px;
                            border-radius: 3px;
                            background: AppTheme.surface_card;
                            border-width: 1px;
                            border-color: #6366f180;
                            Text {
                                text: root.pl2;
                                font-size: 11px;
                                font-weight: 700;
                                color: #818cf8;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Text {
                            text: "W";
                            font-size: 10px;
                            color: AppTheme.text_muted;
                            vertical-alignment: center;
                        }
                    }
                }

                // Slider container (PL2)
                Rectangle {
                    height: 20px;
                    background: transparent;
                    vertical-stretch: 0;

                    // Track line
                    Rectangle {
                        height: 6px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 3px;
                        background: AppTheme.surface_card;
                        width: 100%;

                        // Fill
                        Rectangle {
                            x: 0;
                            width: parent.width * Math.clamp((root.pl2 - 15) / Math.max(1, root.pl2_max - 15), 0, 1);
                            height: 100%;
                            border-radius: 3px;
                            background: #818cf8;
                        }

                        // Thumb
                        Rectangle {
                            x: (parent.width - self.width) * Math.clamp((root.pl2 - 15) / Math.max(1, root.pl2_max - 15), 0, 1);
                            y: (parent.height - self.height) / 2;
                            width: 14px;
                            height: 14px;
                            border-radius: 7px;
                            background: #ffffff;
                            border-width: 2px;
                            border-color: #818cf8;
                        }
                    }

                    TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: pointer;
                        pointer-event(event) => {
                            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                let ratio = Math.clamp(self.mouse-x / self.width, 0, 1);
                                let val = Math.clamp(15 + Math.round(ratio * (root.pl2_max - 15)), 15, root.pl2_max);
                                root.pl2 = val;
                                root.change_pl2(val);
                            }
                        }
                        moved => {
                            if self.pressed {
                                let ratio = Math.clamp(self.mouse-x / self.width, 0, 1);
                                let val = Math.clamp(15 + Math.round(ratio * (root.pl2_max - 15)), 15, root.pl2_max);
                                root.pl2 = val;
                                root.change_pl2(val);
                            }
                        }
                    }
                }

                // Limit hint & buttons
                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "15W";
                        font-size: 9px;
                        color: AppTheme.text_muted;
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        Text {
                            text: "上限: " + root.pl2_max + "W";
                            font-size: 9px;
                            color: AppTheme.text_muted;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            width: 16px;
                            height: 16px;
                            border-radius: 2px;
                            background: AppTheme.surface_card;
                            border-width: 1px;
                            border-color: AppTheme.border_medium;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.pl2_max = Math.clamp(root.pl2_max - 5, 35, 275);
                                    root.adjust_pl2_max(-5);
                                }
                            }
                            Text {
                                text: "-";
                                font-size: 11px;
                                color: AppTheme.text_secondary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Rectangle {
                            width: 16px;
                            height: 16px;
                            border-radius: 2px;
                            background: AppTheme.surface_card;
                            border-width: 1px;
                            border-color: AppTheme.border_medium;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.pl2_max = Math.clamp(root.pl2_max + 5, 35, 275);
                                    root.adjust_pl2_max(5);
                                }
                            }
                            Text {
                                text: "+";
                                font-size: 11px;
                                color: AppTheme.text_secondary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // 6. PL4 (Peak Power / AMD fPPT)
        Rectangle {
            background: AppTheme.surface_pill;
            border-radius: AppTheme.radius_sm;
            border-width: 1px;
            border-color: AppTheme.border_subtle;

            VerticalLayout {
                padding: 8px;
                spacing: 6px;
                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: root.is_amd ? (root.cpu_supports_fppt ? "极速峰值 (fPPT):" : "极速峰值 (未开放):") : "瞬时峰值 PL4:";
                        font-size: 11px;
                        color: AppTheme.text_secondary;
                        vertical-alignment: center;
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        Rectangle {
                            width: 42px;
                            height: 20px;
                            border-radius: 3px;
                            background: AppTheme.surface_card;
                            border-width: 1px;
                            border-color: #f43f5e80;
                            Text {
                                text: root.pl4;
                                font-size: 11px;
                                font-weight: 700;
                                color: #f43f5e;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Text {
                            text: "W";
                            font-size: 10px;
                            color: AppTheme.text_muted;
                            vertical-alignment: center;
                        }
                    }
                }

                // Slider container (PL4)
                Rectangle {
                    height: 20px;
                    background: transparent;
                    vertical-stretch: 0;

                    // Track line
                    Rectangle {
                        height: 6px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 3px;
                        background: AppTheme.surface_card;
                        width: 100%;

                        // Fill
                        Rectangle {
                            x: 0;
                            width: parent.width * Math.clamp((root.pl4 - 35) / Math.max(1, root.pl4_max - 35), 0, 1);
                            height: 100%;
                            border-radius: 3px;
                            background: #f43f5e;
                        }

                        // Thumb
                        Rectangle {
                            x: (parent.width - self.width) * Math.clamp((root.pl4 - 35) / Math.max(1, root.pl4_max - 35), 0, 1);
                            y: (parent.height - self.height) / 2;
                            width: 14px;
                            height: 14px;
                            border-radius: 7px;
                            background: #ffffff;
                            border-width: 2px;
                            border-color: #f43f5e;
                        }
                    }

                    TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: pointer;
                        pointer-event(event) => {
                            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                let ratio = Math.clamp(self.mouse-x / self.width, 0, 1);
                                let val = Math.clamp(35 + Math.round(ratio * (root.pl4_max - 35)), 35, root.pl4_max);
                                root.pl4 = val;
                                root.change_pl4(val);
                            }
                        }
                        moved => {
                            if self.pressed {
                                let ratio = Math.clamp(self.mouse-x / self.width, 0, 1);
                                let val = Math.clamp(35 + Math.round(ratio * (root.pl4_max - 35)), 35, root.pl4_max);
                                root.pl4 = val;
                                root.change_pl4(val);
                            }
                        }
                    }
                }

                // Limit hint & buttons
                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "35W";
                        font-size: 9px;
                        color: AppTheme.text_muted;
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        Text {
                            text: "上限: " + root.pl4_max + "W";
                            font-size: 9px;
                            color: AppTheme.text_muted;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            width: 16px;
                            height: 16px;
                            border-radius: 2px;
                            background: AppTheme.surface_card;
                            border-width: 1px;
                            border-color: AppTheme.border_medium;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.pl4_max = Math.clamp(root.pl4_max - 5, 50, 350);
                                    root.adjust_pl4_max(-5);
                                }
                            }
                            Text {
                                text: "-";
                                font-size: 11px;
                                color: AppTheme.text_secondary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Rectangle {
                            width: 16px;
                            height: 16px;
                            border-radius: 2px;
                            background: AppTheme.surface_card;
                            border-width: 1px;
                            border-color: AppTheme.border_medium;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.pl4_max = Math.clamp(root.pl4_max + 5, 50, 350);
                                    root.adjust_pl4_max(5);
                                }
                            }
                            Text {
                                text: "+";
                                font-size: 11px;
                                color: AppTheme.text_secondary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // 7. Advanced BIOS OC
        Rectangle {
            background: AppTheme.surface_pill;
            border-radius: AppTheme.radius_sm;
            border-width: 1px;
            border-color: AppTheme.border_subtle;

            HorizontalLayout {
                padding: 8px;
                alignment: space-between;
                VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: "高级 BIOS 超频菜单";
                        font-size: 11px;
                        font-weight: 700;
                        color: AppTheme.text_primary;
                    }
                    Text {
                        text: "同步解锁 CPU 与内存超频菜单 (CPU: 已开, 内存: 已开)";
                        font-size: 9px;
                        color: AppTheme.text_muted;
                    }
                }

                Rectangle {
                    width: 44px;
                    height: 22px;
                    border-radius: 4px;
                    background: root.bios_oc_enabled ? #0284c730 : AppTheme.surface_card;
                    border-width: 1px;
                    border-color: root.bios_oc_enabled ? #38bdf8 : AppTheme.border_medium;

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.bios_oc_enabled = !root.bios_oc_enabled;
                            root.toggle_bios_oc();
                        }
                    }

                    Text {
                        text: root.bios_oc_enabled ? "已开启" : "关闭";
                        font-size: 10px;
                        font-weight: 700;
                        color: root.bios_oc_enabled ? #38bdf8 : AppTheme.text_muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // 8. Real-Time Hardware Telemetry Monitor (底部实时硬件监测)
        Rectangle {
            background: AppTheme.surface_sunken;
            border-radius: AppTheme.radius_sm;
            border-width: 1px;
            border-color: AppTheme.border_subtle;

            VerticalLayout {
                padding: 8px;
                spacing: 6px;

                HorizontalLayout {
                    alignment: space-between;
                    HorizontalLayout {
                        spacing: 4px;
                        Image {
                            source: @image-url("../../assets/icons/activity.svg");
                            width: 12px;
                            height: 12px;
                            colorize: #f59e0b;
                            y: (parent.height - self.height) / 2;
                        }
                        Text {
                            text: "实时硬件监测";
                            font-size: 10.5px;
                            font-weight: 700;
                            color: #f59e0b;
                        }
                    }
                    Text {
                        text: "双烤合计: 40 W";
                        font-size: 10px;
                        font-weight: 700;
                        color: AppTheme.text_secondary;
                    }
                }

                // CPU row
                HorizontalLayout {
                    alignment: space-between;
                    HorizontalLayout {
                        spacing: 6px;
                        Rectangle {
                            width: 32px;
                            height: 16px;
                            border-radius: 2px;
                            background: #0284c730;
                            Text {
                                text: "CPU";
                                font-size: 9px;
                                font-weight: 700;
                                color: #38bdf8;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Text {
                            text: root.cpu_temp + "°C";
                            font-size: 10.5px;
                            font-weight: 700;
                            color: AppTheme.text_primary;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "Fan " + root.cpu_rpm + " RPM";
                            font-size: 9.5px;
                            color: AppTheme.text_muted;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        text: root.cpu_watts;
                        font-size: 11px;
                        font-weight: 700;
                        color: #38bdf8;
                        vertical-alignment: center;
                    }
                }

                // GPU row
                HorizontalLayout {
                    alignment: space-between;
                    HorizontalLayout {
                        spacing: 6px;
                        Rectangle {
                            width: 32px;
                            height: 16px;
                            border-radius: 2px;
                            background: #10b98130;
                            Text {
                                text: "GPU";
                                font-size: 9px;
                                font-weight: 700;
                                color: #10b981;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Text {
                            text: root.gpu_temp + "°C";
                            font-size: 10.5px;
                            font-weight: 700;
                            color: AppTheme.text_primary;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "Fan " + root.gpu_rpm + " RPM";
                            font-size: 9.5px;
                            color: AppTheme.text_muted;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        text: root.gpu_watts;
                        font-size: 11px;
                        font-weight: 700;
                        color: #10b981;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
