import { AppTheme } from "../../theme.slint";

export component CpuExtraLimitsCard inherits VerticalLayout {
    in-out property <bool> is_amd: false;
    in-out property <bool> cpu_supports_fppt: true;

    in-out property <int> min_pl4: 35;
    in-out property <int> pl4: 126;
    in-out property <int> pl4_max: 275;
    in-out property <int> min_max_pl4: 155;
    in-out property <int> max_max_pl4: 280;

    in-out property <bool> bios_oc_enabled: true;
    in-out property <string> bios_oc_desc: "同步解锁 CPU 与内存超频菜单";
    in-out property <string> bios_oc_btn_text: "关闭";
    in-out property <int> bios_oc_status: 0; // 0: 关闭, 1: 已开启, 2: 部分开启, 3: 不支持
    in-out property <bool> bios_oc_disabled: false;

    callback change_pl4(int);
    callback adjust_pl4_max(int);
    callback toggle_bios_oc();

    spacing: 8px;

    // 1. PL4 (Peak Power / AMD fPPT)
    Rectangle {
        background: AppTheme.surface_pill;
        border-radius: AppTheme.radius_sm;
        border-width: 1px;
        border-color: AppTheme.border_subtle;

        VerticalLayout {
            padding: 8px;
            spacing: 6px;
            HorizontalLayout {
                alignment: space-between;
                Text {
                    text: root.is_amd ? (root.cpu_supports_fppt ? "极速峰值 (fPPT):" : "极速峰值 (未开放):") : "瞬时峰值 PL4:";
                    font-size: 11px;
                    color: AppTheme.text_secondary;
                    vertical-alignment: center;
                }
                HorizontalLayout {
                    spacing: 4px;
                    Rectangle {
                        width: 42px;
                        height: 20px;
                        border-radius: 3px;
                        background: AppTheme.surface_card;
                        border-width: 1px;
                        border-color: #f43f5e80;
                        Text {
                            text: root.pl4;
                            font-size: 11px;
                            font-weight: 700;
                            color: #f43f5e;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        text: "W";
                        font-size: 10px;
                        color: AppTheme.text_muted;
                        vertical-alignment: center;
                    }
                }
            }

            // Slider container (PL4)
            Rectangle {
                height: 20px;
                background: transparent;
                vertical-stretch: 0;

                // Track line
                Rectangle {
                    height: 6px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 3px;
                    background: AppTheme.surface_card;
                    width: 100%;

                    // Fill
                    Rectangle {
                        x: 0;
                        width: parent.width * Math.clamp((root.pl4 - root.min_pl4) / Math.max(1, root.pl4_max - root.min_pl4), 0, 1);
                        height: 100%;
                        border-radius: 3px;
                        background: #f43f5e;
                    }

                    // Thumb
                    Rectangle {
                        x: (parent.width - self.width) * Math.clamp((root.pl4 - root.min_pl4) / Math.max(1, root.pl4_max - root.min_pl4), 0, 1);
                        y: (parent.height - self.height) / 2;
                        width: 14px;
                        height: 14px;
                        border-radius: 7px;
                        background: #ffffff;
                        border-width: 2px;
                        border-color: #f43f5e;
                    }
                }

                TouchArea {
                    width: 100%;
                    height: 100%;
                    mouse-cursor: pointer;
                    pointer-event(event) => {
                        if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                            let ratio = Math.clamp(self.mouse-x / self.width, 0, 1);
                            let val = Math.clamp(root.min_pl4 + Math.round(ratio * (root.pl4_max - root.min_pl4)), root.min_pl4, root.pl4_max);
                            root.pl4 = val;
                            root.change_pl4(val);
                        }
                    }
                    moved => {
                        if self.pressed {
                            let ratio = Math.clamp(self.mouse-x / self.width, 0, 1);
                            let val = Math.clamp(root.min_pl4 + Math.round(ratio * (root.pl4_max - root.min_pl4)), root.min_pl4, root.pl4_max);
                            root.pl4 = val;
                            root.change_pl4(val);
                        }
                    }
                }
            }

            // Limit hint & buttons
            HorizontalLayout {
                alignment: space-between;
                Text {
                    text: root.min_pl4 + "W";
                    font-size: 9px;
                    color: AppTheme.text_muted;
                }
                HorizontalLayout {
                    spacing: 4px;
                    Text {
                        text: "上限: " + root.pl4_max + "W";
                        font-size: 9px;
                        color: AppTheme.text_muted;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        width: 16px;
                        height: 16px;
                        border-radius: 2px;
                        background: AppTheme.surface_card;
                        border-width: 1px;
                        border-color: AppTheme.border_medium;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.pl4_max = Math.clamp(root.pl4_max - 5, root.min_max_pl4, root.max_max_pl4);
                                root.adjust_pl4_max(-5);
                            }
                        }
                        Text {
                            text: "-";
                            font-size: 11px;
                            color: AppTheme.text_secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        width: 16px;
                        height: 16px;
                        border-radius: 2px;
                        background: AppTheme.surface_card;
                        border-width: 1px;
                        border-color: AppTheme.border_medium;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.pl4_max = Math.clamp(root.pl4_max + 5, root.min_max_pl4, root.max_max_pl4);
                                root.adjust_pl4_max(5);
                            }
                        }
                        Text {
                            text: "+";
                            font-size: 11px;
                            color: AppTheme.text_secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    // 2. Advanced BIOS OC
    Rectangle {
        background: AppTheme.surface_pill;
        border-radius: AppTheme.radius_sm;
        border-width: 1px;
        border-color: AppTheme.border_subtle;

        HorizontalLayout {
            padding: 8px;
            alignment: space-between;
            VerticalLayout {
                spacing: 2px;
                Text {
                    text: "高级 BIOS 超频菜单";
                    font-size: 11px;
                    font-weight: 700;
                    color: AppTheme.text_primary;
                }
                Text {
                    text: root.bios_oc_desc;
                    font-size: 9px;
                    color: AppTheme.text_muted;
                }
            }

            Rectangle {
                width: 48px;
                height: 22px;
                border-radius: 4px;
                background: root.bios_oc_status == 1 ? #0284c730 : (root.bios_oc_status == 2 ? #f59e0b25 : AppTheme.surface_card);
                border-width: 1px;
                border-color: root.bios_oc_status == 1 ? #38bdf8 : (root.bios_oc_status == 2 ? #f59e0b : AppTheme.border_medium);
                opacity: root.bios_oc_disabled ? 0.5 : 1.0;

                TouchArea {
                    mouse-cursor: root.bios_oc_disabled ? not-allowed : pointer;
                    enabled: !root.bios_oc_disabled;
                    clicked => {
                        root.toggle_bios_oc();
                    }
                }

                Text {
                    text: root.bios_oc_btn_text;
                    font-size: 10px;
                    font-weight: 700;
                    color: root.bios_oc_status == 1 ? #38bdf8 : (root.bios_oc_status == 2 ? #f59e0b : AppTheme.text_muted);
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

