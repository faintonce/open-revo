import { AppTheme } from "../../theme.slint";

export component WakeWindowModeRow inherits HorizontalLayout {
    in-out property <string> wake_window_mode: "remember"; // "remember" | "mini" | "full"

    callback change_wake_window_mode(string);

    alignment: space-between;

    VerticalLayout {
        spacing: 2px;
        HorizontalLayout {
            spacing: 6px;
            Text {
                text: "唤醒面板形态";
                font-size: 12px;
                font-weight: 600;
                color: AppTheme.text_primary;
                vertical-alignment: center;
            }
            Rectangle {
                border-radius: 3px;
                background: #38bdf820;
                border-width: 1px;
                border-color: #38bdf860;
                height: 18px;
                HorizontalLayout {
                    padding-left: 5px;
                    padding-right: 5px;
                    Text { text: "Window"; font-size: 10px; font-weight: 700; color: #38bdf8; vertical-alignment: center; }
                }
            }
        }
        Text {
            text: "从系统托盘或后台双击唤醒时展现的界面形态；可记忆最后状态或锁定首选模式";
            font-size: 10px;
            color: AppTheme.text_muted;
        }
    }

    VerticalLayout {
        alignment: center;
        Rectangle {
            border-radius: 6px;
            background: AppTheme.surface_sunken;
            border-width: 1px;
            border-color: AppTheme.border_subtle;

            HorizontalLayout {
                padding: 2px;
                spacing: 2px;

                // 1. Remember
                Rectangle {
                    height: 24px;
                    border-radius: 4px;
                    background: root.wake_window_mode == "remember" ? AppTheme.accent_brand : (t_wm1.has-hover ? AppTheme.surface_card_hover : transparent);
                    t_wm1 := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.change_wake_window_mode("remember"); }
                    }
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: "记忆上次形态";
                            font-size: 10.5px;
                            font-weight: root.wake_window_mode == "remember" ? 700 : 500;
                            color: root.wake_window_mode == "remember" ? AppTheme.tag_brand_text : AppTheme.text_secondary;
                            vertical-alignment: center;
                        }
                    }
                }

                // 2. Mini
                Rectangle {
                    height: 24px;
                    border-radius: 4px;
                    background: root.wake_window_mode == "mini" ? AppTheme.accent_brand : (t_wm2.has-hover ? AppTheme.surface_card_hover : transparent);
                    t_wm2 := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.change_wake_window_mode("mini"); }
                    }
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: "始终迷你抽屉";
                            font-size: 10.5px;
                            font-weight: root.wake_window_mode == "mini" ? 700 : 500;
                            color: root.wake_window_mode == "mini" ? AppTheme.tag_brand_text : AppTheme.text_secondary;
                            vertical-alignment: center;
                        }
                    }
                }

                // 3. Full
                Rectangle {
                    height: 24px;
                    border-radius: 4px;
                    background: root.wake_window_mode == "full" ? AppTheme.accent_brand : (t_wm3.has-hover ? AppTheme.surface_card_hover : transparent);
                    t_wm3 := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.change_wake_window_mode("full"); }
                    }
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: "始终完整面板";
                            font-size: 10.5px;
                            font-weight: root.wake_window_mode == "full" ? 700 : 500;
                            color: root.wake_window_mode == "full" ? AppTheme.tag_brand_text : AppTheme.text_secondary;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}

