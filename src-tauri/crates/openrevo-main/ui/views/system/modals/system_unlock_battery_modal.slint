import { AppTheme } from "../../../theme.slint";

export component SystemUnlockBatteryModal inherits Rectangle {
    in-out property <bool> is_open: false;
    in-out property <bool> is_processing: false;

    callback close();
    callback confirm();

    background: #000000bd;
    TouchArea { }

    Rectangle {
        width: Math.min(parent.width - 60px, 560px);
        height: Math.min(parent.height - 40px, 450px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: AppTheme.is_light ? #ffffff : #141721;
        border-radius: 12px;
        border-width: 1px;
        border-color: #f43f5e55;
        clip: true;

        VerticalLayout {
            padding: 20px;
            spacing: 14px;
            alignment: space-between;

            // Header
            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 38px;
                        height: 38px;
                        border-radius: 8px;
                        background: #f43f5e20;
                        border-width: 1px;
                        border-color: #f43f5e60;
                        Image {
                            source: @image-url("../../../assets/icons/ban.svg");
                            width: 20px;
                            height: 20px;
                            colorize: #f43f5e;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }
                VerticalLayout {
                    spacing: 3px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Предупреждение о рисках снятия ограничения работы от батареи";
                            font-size: 15px;
                            font-weight: 800;
                            color: AppTheme.text_primary;
                        }
                        Rectangle {
                            border-radius: 3px;
                            background: #f43f5e20;
                            border-width: 1px;
                            border-color: #f43f5e60;
                            height: 18px;
                            HorizontalLayout {
                                padding-left: 5px;
                                padding-right: 5px;
                                Text {
                                    text: "Power Gating";
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: #f43f5e;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                    Text {
                        text: "Правила безопасности при разряде оборудования и работе с батареей (официальная прошивка по умолчанию запрещает высокое потребление от батареи)";
                        font-size: 11px;
                        color: AppTheme.text_muted;
                    }
                }
            }

            // Warning Box
            Rectangle {
                border-radius: 8px;
                background: AppTheme.is_light ? #fef2f2 : #1c141a;
                border-width: 1px;
                border-color: #f43f5e30;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    Text {
                        text: "⚠️ После включения статус адаптера игнорируется — режим Турбо разрешено запускать от батареи:";
                        font-size: 11px;
                        font-weight: 700;
                        color: #fb7185;
                    }

                    Text {
                        text: "• Отключение защитой батареи от сверхтока: мгновенная токоотдача батареи намного ниже адаптера; тяжёлая нагрузка от батареи может мгновенно вызвать срабатывание BMS — внезапное отключение, чёрный экран или аппаратная перезагрузка.";
                        font-size: 10.5px;
                        color: AppTheme.text_secondary;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "• Ускоренное старение батареи: сильноточный разряд вызывает интенсивный нагрев ячеек и заметно ускоряет деградацию ёмкости с риском вздутия.";
                        font-size: 10.5px;
                        color: AppTheme.text_secondary;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "• Без принудительного понижения: после отключения адаптера система фиксирует текущий режим и больше не сбрасывается в Баланс автоматически.";
                        font-size: 10.5px;
                        color: AppTheme.text_secondary;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "• Рекомендуемый сценарий: если вы на батарее стремитесь к максимальной автономности и задали потребление ниже офисного режима — пользуйтесь спокойно; но не запускайте на батарее тяжёлые 3D-игры и рендеринг!";
                        font-size: 10.5px;
                        color: #10b981;
                        wrap: word-wrap;
                    }
                }
            }

            // Action Buttons
            HorizontalLayout {
                spacing: 10px;
                alignment: end;

                // Cancel
                Rectangle {
                    width: 80px;
                    height: 32px;
                    border-radius: 6px;
                    background: t_cancel.has-hover ? AppTheme.surface_card_hover : AppTheme.surface_pill;
                    border-width: 1px;
                    border-color: AppTheme.border_medium;
                    t_cancel := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.close(); }
                    }
                    Text {
                        text: "Отмена";
                        font-size: 12px;
                        color: AppTheme.text_primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Confirm Danger
                Rectangle {
                    width: 170px;
                    height: 32px;
                    border-radius: 6px;
                    background: root.is_processing ? #881337 : (t_confirm.has-hover ? #e11d48 : #be123c);
                    border-width: 1px;
                    border-color: #f43f5e;
                    t_confirm := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if !root.is_processing {
                                root.confirm();
                            }
                        }
                    }
                    Text {
                        text: root.is_processing ? "Применение..." : "Я осознаю риски и подтверждаю снятие";
                        font-size: 12px;
                        font-weight: 700;
                        color: #ffffff;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

