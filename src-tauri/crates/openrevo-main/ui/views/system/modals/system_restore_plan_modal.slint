import { AppTheme } from "../../../theme.slint";

export component SystemRestorePlanModal inherits Rectangle {
    in-out property <bool> is_open: false;
    in-out property <bool> is_processing: false;

    callback close();
    callback confirm();

    background: #000000bd;
    TouchArea { }

    Rectangle {
        width: Math.min(parent.width - 60px, 560px);
        height: Math.min(parent.height - 40px, 420px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: AppTheme.is_light ? #ffffff : #141721;
        border-radius: 12px;
        border-width: 1px;
        border-color: #38bdf855;
        clip: true;

        VerticalLayout {
            padding: 20px;
            spacing: 14px;
            alignment: space-between;

            // Header
            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 38px;
                        height: 38px;
                        border-radius: 8px;
                        background: #38bdf820;
                        border-width: 1px;
                        border-color: #38bdf860;
                        Image {
                            source: @image-url("../../../assets/icons/rotate-ccw.svg");
                            width: 20px;
                            height: 20px;
                            colorize: #38bdf8;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }
                VerticalLayout {
                    spacing: 3px;
                    Text {
                        text: "Исправить и сбросить к заводскому плану электропитания";
                        font-size: 15px;
                        font-weight: 800;
                        color: AppTheme.text_primary;
                    }
                    Text {
                        text: "Выравнивает с логикой официальной консоли, устраняя нагрев в простое и аномальную блокировку на 0,8 ГГц";
                        font-size: 11px;
                        color: AppTheme.text_muted;
                    }
                }
            }

            // Info Box
            Rectangle {
                border-radius: 8px;
                background: AppTheme.is_light ? #f0fdf4 : #0f1c1f;
                border-width: 1px;
                border-color: #10b98135;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    Text {
                        text: "💡 Операция выполнит следующие безопасные исправления (полностью по заводским стандартам OEM):";
                        font-size: 11px;
                        font-weight: 700;
                        color: #34d399;
                    }
                    Text {
                        text: "• Устранение аномального нагрева в простое: сбрасывает агрессивные оверлеи слайдеров производительности, возвращает парковку ядер CPU (Core Parking) и глубокий сон C-State, убирая накопление 20+ Вт тепла.";
                        font-size: 10.5px;
                        color: AppTheme.text_secondary;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "• Полная очистка остатков блокировки частот: хирургически удаляет ключи статических лимитов (75b0ae3f) из всех схем, снимая ловушку 0,8 ГГц или 25 Вт.";
                        font-size: 10.5px;
                        color: AppTheme.text_secondary;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "• Повторное внедрение официального OEM provisioning-пакета: адаптивно внедряет заводской PPM-пакет (официальный Provisioning AMD для Baolongda / PPM-пакет TongFang).";
                        font-size: 10.5px;
                        color: AppTheme.text_secondary;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "• Активация официального сбалансированного плана: возврат к стандартному плану Windows (Balanced). Личные пользовательские схемы полностью сохраняются и не удаляются.";
                        font-size: 10.5px;
                        color: AppTheme.text_secondary;
                        wrap: word-wrap;
                    }
                }
            }

            // Action Buttons
            HorizontalLayout {
                spacing: 10px;
                alignment: end;

                // Cancel
                Rectangle {
                    width: 80px;
                    height: 32px;
                    border-radius: 6px;
                    background: t_cancel.has-hover ? AppTheme.surface_card_hover : AppTheme.surface_pill;
                    border-width: 1px;
                    border-color: AppTheme.border_medium;
                    t_cancel := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.close(); }
                    }
                    Text {
                        text: "Отмена";
                        font-size: 12px;
                        color: AppTheme.text_primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Confirm Action
                Rectangle {
                    width: 140px;
                    height: 32px;
                    border-radius: 6px;
                    background: root.is_processing ? #0284c780 : (t_confirm.has-hover ? #0284c7 : #0369a1);
                    border-width: 1px;
                    border-color: #38bdf8;
                    t_confirm := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if !root.is_processing {
                                root.confirm();
                            }
                        }
                    }
                    Text {
                        text: root.is_processing ? "Идёт исправление..." : "Подтвердить безопасное исправление";
                        font-size: 12px;
                        font-weight: 700;
                        color: #ffffff;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

