import { AppTheme } from "../../../theme.slint";
import { AppI18n } from "../../../i18n.slint";

export component SystemRestorePlanModal inherits Rectangle {
    in-out property <bool> is_open: false;
    in-out property <bool> is_processing: false;

    callback close();
    callback confirm();

    background: #000000bd;
    TouchArea { }

    Rectangle {
        width: Math.min(parent.width - 60px, 560px);
        height: Math.min(parent.height - 40px, 420px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: AppTheme.is_light ? #ffffff : #141721;
        border-radius: 12px;
        border-width: 1px;
        border-color: #38bdf855;
        clip: true;

        VerticalLayout {
            padding: 20px;
            spacing: 14px;
            alignment: space-between;

            // Header
            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 38px;
                        height: 38px;
                        border-radius: 8px;
                        background: #38bdf820;
                        border-width: 1px;
                        border-color: #38bdf860;
                        Image {
                            source: @image-url("../../../assets/icons/rotate-ccw.svg");
                            width: 20px;
                            height: 20px;
                            colorize: #38bdf8;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }
                VerticalLayout {
                    spacing: 3px;
                    Text {
                        text: AppI18n.tr(AppI18n.rev, "system.restore_plan_title");
                        font-size: 15px;
                        font-weight: 800;
                        color: AppTheme.text_primary;
                    }
                    Text {
                        text: AppI18n.tr(AppI18n.rev, "system.restore_plan_sub");
                        font-size: 11px;
                        color: AppTheme.text_muted;
                    }
                }
            }

            // Info Box
            Rectangle {
                border-radius: 8px;
                background: AppTheme.is_light ? #f0fdf4 : #0f1c1f;
                border-width: 1px;
                border-color: #10b98135;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    Text {
                        text: AppI18n.tr(AppI18n.rev, "system.restore_plan_info");
                        font-size: 11px;
                        font-weight: 700;
                        color: #34d399;
                    }
                    Text {
                        text: AppI18n.tr(AppI18n.rev, "system.restore_step_1");
                        font-size: 10.5px;
                        color: AppTheme.text_secondary;
                        wrap: word-wrap;
                    }
                    Text {
                        text: AppI18n.tr(AppI18n.rev, "system.restore_step_2");
                        font-size: 10.5px;
                        color: AppTheme.text_secondary;
                        wrap: word-wrap;
                    }
                    Text {
                        text: AppI18n.tr(AppI18n.rev, "system.restore_step_3");
                        font-size: 10.5px;
                        color: AppTheme.text_secondary;
                        wrap: word-wrap;
                    }
                    Text {
                        text: AppI18n.tr(AppI18n.rev, "system.restore_step_4");
                        font-size: 10.5px;
                        color: AppTheme.text_secondary;
                        wrap: word-wrap;
                    }
                }
            }

            // Action Buttons
            HorizontalLayout {
                spacing: 10px;
                alignment: end;

                // Cancel
                Rectangle {
                    width: 80px;
                    height: 32px;
                    border-radius: 6px;
                    background: t_cancel.has-hover ? AppTheme.surface_card_hover : AppTheme.surface_pill;
                    border-width: 1px;
                    border-color: AppTheme.border_medium;
                    t_cancel := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.close(); }
                    }
                    Text {
                        text: AppI18n.tr(AppI18n.rev, "system.cancel");
                        font-size: 12px;
                        color: AppTheme.text_primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Confirm Action
                Rectangle {
                    width: 140px;
                    height: 32px;
                    border-radius: 6px;
                    background: root.is_processing ? #0284c780 : (t_confirm.has-hover ? #0284c7 : #0369a1);
                    border-width: 1px;
                    border-color: #38bdf8;
                    t_confirm := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if !root.is_processing {
                                root.confirm();
                            }
                        }
                    }
                    Text {
                        text: root.is_processing ? AppI18n.tr(AppI18n.rev, "system.repairing") : AppI18n.tr(AppI18n.rev, "system.confirm_repair");
                        font-size: 12px;
                        font-weight: 700;
                        color: #ffffff;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

