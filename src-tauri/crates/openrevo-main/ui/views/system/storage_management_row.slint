import { AppTheme } from "../../theme.slint";
import { UserDataDirInfo } from "system_types.slint";

export component StorageManagementRow inherits HorizontalLayout {
    in-out property <UserDataDirInfo> data_dir_info: {
        path: "C:\\Users\\AppData\\Roaming\\OpenRevo",
        mode: "appdata"
    };

    callback open_user_data_dir();
    callback request_migrate_data();
    callback request_clear_data();

    alignment: space-between;

    VerticalLayout {
        spacing: 2px;
        HorizontalLayout {
            spacing: 6px;
            Text {
                text: "数据存储管理";
                font-size: 12px;
                font-weight: 600;
                color: AppTheme.text_primary;
                vertical-alignment: center;
            }
            Rectangle {
                border-radius: 3px;
                background: root.data_dir_info.mode == "portable" ? #10b98120 : (root.data_dir_info.mode == "custom" ? #f59e0b20 : #6366f120);
                border-width: 1px;
                border-color: root.data_dir_info.mode == "portable" ? #10b98160 : (root.data_dir_info.mode == "custom" ? #f59e0b60 : #6366f160);
                height: 18px;
                HorizontalLayout {
                    padding-left: 5px;
                    padding-right: 5px;
                    Text {
                        text: root.data_dir_info.mode == "portable" ? "便携目录 (./data)" : (root.data_dir_info.mode == "custom" ? "自定义路径 (data_dir.ptr)" : "标准 AppData (%APPDATA%)");
                        font-size: 10px;
                        font-weight: 700;
                        color: root.data_dir_info.mode == "portable" ? #10b981 : (root.data_dir_info.mode == "custom" ? #f59e0b : #818cf8);
                        vertical-alignment: center;
                    }
                }
            }
        }
        Text {
            text: "当前目录: " + root.data_dir_info.path;
            font-size: 10px;
            color: AppTheme.text_muted;
        }
    }

    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            spacing: 6px;

            // Open Folder
            Rectangle {
                height: 26px;
                border-radius: 4px;
                background: t_open_dir.has-hover ? AppTheme.surface_card_hover : AppTheme.surface_pill;
                border-width: 1px;
                border-color: AppTheme.border_medium;
                t_open_dir := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.open_user_data_dir(); }
                }
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 4px;
                    Image {
                        source: @image-url("../../assets/icons/folder.svg");
                        width: 11px;
                        height: 11px;
                        colorize: AppTheme.text_secondary;
                        y: (parent.height - self.height) / 2;
                    }
                    Text { text: "打开目录"; font-size: 11px; color: AppTheme.text_primary; vertical-alignment: center; }
                }
            }

            // Migrate Storage
            Rectangle {
                height: 26px;
                border-radius: 4px;
                background: t_mig.has-hover ? AppTheme.surface_card_hover : AppTheme.surface_pill;
                border-width: 1px;
                border-color: AppTheme.border_medium;
                t_mig := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.request_migrate_data(); }
                }
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    Text { text: "迁移存储"; font-size: 11px; color: AppTheme.text_primary; vertical-alignment: center; }
                }
            }

            // Clear Data (Danger)
            Rectangle {
                height: 26px;
                border-radius: 4px;
                background: t_clr.has-hover ? #f43f5e25 : #f43f5e15;
                border-width: 1px;
                border-color: #f43f5e55;
                t_clr := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.request_clear_data(); }
                }
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 4px;
                    Image {
                        source: @image-url("../../assets/icons/trash.svg");
                        width: 11px;
                        height: 11px;
                        colorize: #f43f5e;
                        y: (parent.height - self.height) / 2;
                    }
                    Text { text: "清除数据"; font-size: 11px; font-weight: 700; color: #f43f5e; vertical-alignment: center; }
                }
            }
        }
    }
}

