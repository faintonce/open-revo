import { AppTheme } from "../../theme.slint";
import { WaterCoolerDeviceItem } from "cooler_types.slint";

export component CoolerDeviceModal inherits Rectangle {
    in-out property <bool> is_open: false;
    in-out property <bool> is_scanning: false;
    in-out property <string> current_mac: "";
    in-out property <[WaterCoolerDeviceItem]> devices: [];
    in-out property <string> error_msg: "";

    callback close();
    callback refresh_devices();
    callback select_device(string); // mac_address

    // Backdrop overlay
    background: #000000c0;

    // Intercept clicks on backdrop to prevent passing through
    TouchArea {
        clicked => { root.close(); }
    }

    // Modal Card
    Rectangle {
        width: Math.min(parent.width - 48px, 640px);
        height: Math.min(parent.height - 60px, 460px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: AppTheme.is_light ? #ffffff : #0f1522f5;
        border-radius: 12px;
        border-width: 1px;
        border-color: #38bdf845;
        clip: true;

        // Prevent clicking inside modal from closing
        TouchArea { }

        VerticalLayout {
            // 1. Header Bar
            Rectangle {
                height: 52px;
                background: AppTheme.is_light ? #f8fafc : #131b2e;

                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 16px;
                    alignment: space-between;

                    // Left title
                    HorizontalLayout {
                        spacing: 10px;

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 32px;
                                height: 32px;
                                border-radius: 8px;
                                background: #38bdf820;
                                border-width: 1px;
                                border-color: #38bdf860;
                                Image {
                                    source: @image-url("../../assets/icons/bluetooth.svg");
                                    width: 16px;
                                    height: 16px;
                                    colorize: #38bdf8;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;

                            Text {
                                text: "选择水冷魔盒 (BLE 设备列表)";
                                font-size: 13.5px;
                                font-weight: 800;
                                color: AppTheme.text_primary;
                            }
                            Text {
                                text: "绑定专属水冷箱，防止与邻近机型产生串联冲突";
                                font-size: 10px;
                                color: AppTheme.text_muted;
                            }
                        }
                    }

                    // Right Refresh & Close
                    HorizontalLayout {
                        spacing: 8px;

                        // Refresh button
                        Rectangle {
                            height: 26px;
                            border-radius: AppTheme.radius_xs;
                            background: ref_touch.has-hover ? AppTheme.surface_pill : AppTheme.surface_card;
                            border-width: 1px;
                            border-color: AppTheme.border_medium;
                            y: (parent.height - self.height) / 2;

                            ref_touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.refresh_devices(); }
                            }

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 4px;

                                Image {
                                    source: @image-url("../../assets/icons/rotate-ccw.svg");
                                    width: 11px;
                                    height: 11px;
                                    colorize: #38bdf8;
                                    y: (parent.height - self.height) / 2;
                                }

                                Text {
                                    text: root.is_scanning ? "扫描中..." : "重新扫描";
                                    font-size: 10.5px;
                                    font-weight: 600;
                                    color: #38bdf8;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Close button
                        Rectangle {
                            width: 26px;
                            height: 26px;
                            border-radius: 13px;
                            background: close_touch.has-hover ? #ef444425 : transparent;
                            y: (parent.height - self.height) / 2;

                            close_touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.close(); }
                            }

                            Image {
                                source: @image-url("../../assets/icons/x.svg");
                                width: 12px;
                                height: 12px;
                                colorize: close_touch.has-hover ? #ef4444 : AppTheme.text_muted;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                    }
                }
            }

            // Divider
            Rectangle {
                height: 1px;
                background: AppTheme.border_subtle;
            }

            // 2. Content Area
            VerticalLayout {
                padding: 16px;
                spacing: 10px;

                if root.error_msg != "": Rectangle {
                    border-radius: AppTheme.radius_sm;
                    background: #f59e0b18;
                    border-width: 1px;
                    border-color: #f59e0b50;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 8px;

                        Image {
                            source: @image-url("../../assets/icons/ban.svg");
                            width: 14px;
                            height: 14px;
                            colorize: #f59e0b;
                            y: (parent.height - self.height) / 2;
                        }

                        Text {
                            text: root.error_msg;
                            font-size: 11px;
                            color: #f59e0b;
                            vertical-alignment: center;
                        }
                    }
                }

                // Device List
                VerticalLayout {
                    spacing: 8px;

                    for dev in root.devices: Rectangle {
                        height: 54px;
                        border-radius: AppTheme.radius_sm;
                        background: dev.mac_address == root.current_mac ? #0284c718 : AppTheme.surface_pill;
                        border-width: 1px;
                        border-color: dev.mac_address == root.current_mac ? #38bdf880 : AppTheme.border_subtle;

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            alignment: space-between;

                            // Left info
                            HorizontalLayout {
                                spacing: 10px;

                                Image {
                                    source: @image-url("../../assets/icons/droplet.svg");
                                    width: 16px;
                                    height: 16px;
                                    colorize: dev.mac_address == root.current_mac ? #06b6d4 : AppTheme.text_muted;
                                    y: (parent.height - self.height) / 2;
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;

                                    HorizontalLayout {
                                        spacing: 6px;

                                        Text {
                                            text: dev.name != "" ? dev.name : "机械革命水冷魔盒";
                                            font-size: 12px;
                                            font-weight: 700;
                                            color: AppTheme.text_primary;
                                            vertical-alignment: center;
                                        }

                                        if dev.mac_address == root.current_mac: Rectangle {
                                            height: 16px;
                                            border-radius: 3px;
                                            background: #10b98125;
                                            border-width: 1px;
                                            border-color: #10b98160;
                                            y: (parent.height - self.height) / 2;

                                            HorizontalLayout {
                                                padding-left: 5px;
                                                padding-right: 5px;
                                                Text {
                                                    text: "当前受控";
                                                    font-size: 8.5px;
                                                    font-weight: 700;
                                                    color: #10b981;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 8px;

                                        Text {
                                            text: "MAC: " + dev.mac_address;
                                            font-size: 10px;
                                            font-family: "Consolas";
                                            color: AppTheme.text_muted;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: dev.rssi >= -65 ? "● 信号极强 (推荐本机)" : (
                                                dev.rssi >= -80 ? "● 信号良好" : "○ 信号较弱 (疑似邻机)"
                                            );
                                            font-size: 9px;
                                            font-weight: 600;
                                            color: dev.rssi >= -65 ? #10b981 : (dev.rssi >= -80 ? #38bdf8 : #f59e0b);
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            // Right Select Button
                            Rectangle {
                                height: 26px;
                                border-radius: AppTheme.radius_xs;
                                background: dev.mac_address == root.current_mac ? #10b98120 : (s_touch.has-hover ? #0284c7 : #0ea5e9);
                                border-width: 1px;
                                border-color: dev.mac_address == root.current_mac ? #10b98160 : #38bdf8;
                                y: (parent.height - self.height) / 2;

                                s_touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.select_device(dev.mac_address); }
                                }

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;

                                    Text {
                                        text: dev.mac_address == root.current_mac ? "已绑定" : "绑定并连接";
                                        font-size: 10.5px;
                                        font-weight: 700;
                                        color: dev.mac_address == root.current_mac ? #10b981 : #ffffff;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                if root.devices.length == 0: Rectangle {
                    height: 120px;
                    border-radius: AppTheme.radius_sm;
                    background: AppTheme.surface_pill;

                    VerticalLayout {
                        alignment: center;
                        spacing: 8px;

                        Image {
                            source: @image-url("../../assets/icons/bluetooth.svg");
                            width: 24px;
                            height: 24px;
                            colorize: AppTheme.text_muted;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: root.is_scanning ? "正在扫描附近的机械革命水冷魔盒..." : "未搜索到附近的机械革命水冷魔盒，请确认水冷已通电且蓝牙正常广播";
                            font-size: 11px;
                            color: AppTheme.text_muted;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }
    }
}

