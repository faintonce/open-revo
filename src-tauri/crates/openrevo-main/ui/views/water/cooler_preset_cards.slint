import { AppTheme } from "../../theme.slint";

export component CoolerPresetCards inherits Rectangle {
    background: transparent;

    in-out property <string> strategy: "smart"; // "smart", "quiet", "balance", "performance", "custom"
    in-out property <int> live_max_temp: 55;
    in-out property <int> live_fan_duty: 0;
    in-out property <int> live_pump_volt: 0;

    callback update_strategy(string);

    VerticalLayout {
        spacing: 4px;

        // Header hint row
        HorizontalLayout {
            alignment: space-between;

            Text {
                text: "Пресеты охлаждения и режимы работы";
                font-size: 10.5px;
                font-weight: 700;
                color: AppTheme.text_muted;
                vertical-alignment: center;
            }

            Text {
                text: root.strategy == "custom" ? "Сейчас активно ручная пользовательская настройка (все пресеты выключены)" : "Выберите «Умную адаптацию» для автоматического сопровождения; после ручной регулировки насоса или вентилятора режим автоматически становится пользовательским";
                font-size: 9.5px;
                font-weight: 500;
                color: root.strategy == "custom" ? #f59e0b : AppTheme.text_muted;
                vertical-alignment: center;
            }
        }

        // 4 Preset Cards Grid
        HorizontalLayout {
            height: 68px;
            spacing: 7px;

            // 1. Smart Adaptive (智慧自适应)
            card_smart := Rectangle {
                height: 68px;
                horizontal-stretch: 14;
                border-radius: AppTheme.radius_sm;
                background: root.strategy == "smart" ? #0284c71a : (smart_touch.has-hover ? AppTheme.surface_card_hover : AppTheme.surface_pill);
                border-width: 1px;
                border-color: root.strategy == "smart" ? #38bdf8 : AppTheme.border_subtle;

                smart_touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.update_strategy("smart"); }
                }

                VerticalLayout {
                    alignment: center;
                    padding-left: 9px;
                    padding-right: 9px;
                    spacing: 2px;

                    HorizontalLayout {
                        alignment: space-between;
                        HorizontalLayout {
                            spacing: 4px;
                            Image {
                                source: @image-url("../../assets/icons/shield.svg");
                                width: 12px;
                                height: 12px;
                                colorize: #38bdf8;
                                y: (parent.height - self.height) / 2;
                            }
                            Text {
                                text: "Умная адаптация";
                                font-size: 11px;
                                font-weight: 800;
                                color: #38bdf8;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            height: 15px;
                            border-radius: 3px;
                            background: #0284c725;
                            y: (parent.height - self.height) / 2;
                            HorizontalLayout {
                                padding-left: 4px;
                                padding-right: 4px;
                                Text {
                                    text: "Температура управляет";
                                    font-size: 8px;
                                    font-weight: 800;
                                    color: #38bdf8;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    Text {
                        text: "Динамическое управление по температуре ядра; ниже 55°C вентиляторы останавливаются";
                        font-size: 9px;
                        color: AppTheme.text_muted;
                    }

                    HorizontalLayout {
                        spacing: 3px;
                        Image {
                            source: @image-url("../../assets/icons/zap.svg");
                            width: 9px;
                            height: 9px;
                            colorize: #38bdf8;
                            y: (parent.height - self.height) / 2;
                        }
                        Text {
                            text: "Следование: " + root.live_max_temp + "°C → вентилятор " + root.live_fan_duty + "% | насос " + (
                                root.live_pump_volt >= 11 || root.live_pump_volt == 3 ? "Предел Турбо" : (
                                    root.live_pump_volt == 0 ? "Остановлено" : "Стандартный цикл"
                                )
                            );
                            font-size: 8.5px;
                            font-weight: 700;
                            color: #38bdf8;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // 2. Quiet (静音策略)
            card_quiet := Rectangle {
                height: 68px;
                horizontal-stretch: 10;
                border-radius: AppTheme.radius_sm;
                background: root.strategy == "quiet" ? #0284c71a : (quiet_touch.has-hover ? AppTheme.surface_card_hover : AppTheme.surface_pill);
                border-width: 1px;
                border-color: root.strategy == "quiet" ? #38bdf8 : AppTheme.border_subtle;

                quiet_touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.update_strategy("quiet"); }
                }

                VerticalLayout {
                    alignment: center;
                    padding-left: 9px;
                    padding-right: 9px;
                    spacing: 2px;

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "Тихая стратегия";
                            font-size: 11px;
                            font-weight: 800;
                            color: root.strategy == "quiet" ? #38bdf8 : AppTheme.text_primary;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            height: 15px;
                            border-radius: 3px;
                            background: AppTheme.surface_card;
                            y: (parent.height - self.height) / 2;
                            HorizontalLayout {
                                padding-left: 4px;
                                padding-right: 4px;
                                Text {
                                    text: "Фиксация";
                                    font-size: 8px;
                                    font-weight: 700;
                                    color: AppTheme.text_muted;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    Text {
                        text: "Насос стандартного цикла + вентиляторы 40%";
                        font-size: 9px;
                        color: AppTheme.text_muted;
                    }
                    Text {
                        text: "Подходит для тихой ночной работы";
                        font-size: 8.5px;
                        color: AppTheme.text_muted;
                    }
                }
            }

            // 3. Balance (均衡策略)
            card_balance := Rectangle {
                height: 68px;
                horizontal-stretch: 10;
                border-radius: AppTheme.radius_sm;
                background: root.strategy == "balance" ? #6366f120 : (bal_touch.has-hover ? AppTheme.surface_card_hover : AppTheme.surface_pill);
                border-width: 1px;
                border-color: root.strategy == "balance" ? #818cf8 : AppTheme.border_subtle;

                bal_touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.update_strategy("balance"); }
                }

                VerticalLayout {
                    alignment: center;
                    padding-left: 9px;
                    padding-right: 9px;
                    spacing: 2px;

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "Сбалансированная стратегия";
                            font-size: 11px;
                            font-weight: 800;
                            color: root.strategy == "balance" ? #818cf8 : AppTheme.text_primary;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            height: 15px;
                            border-radius: 3px;
                            background: AppTheme.surface_card;
                            y: (parent.height - self.height) / 2;
                            HorizontalLayout {
                                padding-left: 4px;
                                padding-right: 4px;
                                Text {
                                    text: "Фиксация";
                                    font-size: 8px;
                                    font-weight: 700;
                                    color: AppTheme.text_muted;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    Text {
                        text: "Насос стандартного цикла + вентиляторы 65%";
                        font-size: 9px;
                        color: AppTheme.text_muted;
                    }
                    Text {
                        text: "Баланс охлаждения и шума вентиляторов";
                        font-size: 8.5px;
                        color: AppTheme.text_muted;
                    }
                }
            }

            // 4. Performance (极速狂暴)
            card_perf := Rectangle {
                height: 68px;
                horizontal-stretch: 10;
                border-radius: AppTheme.radius_sm;
                background: root.strategy == "performance" ? #ef444420 : (perf_touch.has-hover ? AppTheme.surface_card_hover : AppTheme.surface_pill);
                border-width: 1px;
                border-color: root.strategy == "performance" ? #ef4444 : AppTheme.border_subtle;

                perf_touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.update_strategy("performance"); }
                }

                VerticalLayout {
                    alignment: center;
                    padding-left: 9px;
                    padding-right: 9px;
                    spacing: 2px;

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "Турбо на максимуме";
                            font-size: 11px;
                            font-weight: 800;
                            color: root.strategy == "performance" ? #ef4444 : AppTheme.text_primary;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            height: 15px;
                            border-radius: 3px;
                            background: #ef444430;
                            y: (parent.height - self.height) / 2;
                            HorizontalLayout {
                                padding-left: 4px;
                                padding-right: 4px;
                                Text {
                                    text: "На полную";
                                    font-size: 8px;
                                    font-weight: 800;
                                    color: #ef4444;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    Text {
                        text: "Насос на пределе Турбо + вентиляторы 100%";
                        font-size: 9px;
                        color: AppTheme.text_muted;
                    }
                    Text {
                        text: "Выжать из охлаждения максимум";
                        font-size: 8.5px;
                        color: AppTheme.text_muted;
                    }
                }
            }
        }
    }
}

