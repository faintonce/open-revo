                // 3. 硬件协议与适用机型即时预览卡片 (随鼠标悬停实时联动)
                Rectangle {
                    height: 52px;
                    border-radius: 8px;
                    background: #0284c70d;
                    border-width: 1px;
                    border-color: #0284c738;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 12px;
                        alignment: center;

                        Rectangle {
                            width: 22px;
                            height: 22px;
                            border-radius: 11px;
                            background: #0284c725;
                            y: (parent.height - self.height) / 2;

                            Text {
                                text: "ⓘ";
                                font-size: 12px;
                                font-weight: 700;
                                color: #38bdf8;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;
                            horizontal-stretch: 1;

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;

                                Text {
                                    text: root.get_preview_title(root.active_preview_id);
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: #38bdf8;
                                    vertical-alignment: center;
                                }

                                Rectangle {
                                    height: 16px;
                                    border-radius: 3px;
                                    background: #0284c725;
                                    border-width: 1px;
                                    border-color: #38bdf855;
                                    y: (parent.height - self.height) / 2;

                                    HorizontalLayout {
                                        padding-left: 5px;
                                        padding-right: 5px;
                                        Text {
                                            text: root.get_preview_chip(root.active_preview_id);
                                            font-size: 9.5px;
                                            font-weight: 600;
                                            color: #e0f2fe;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                Text {
                                    text: root.get_preview_desc(root.active_preview_id);
                                    font-size: 11px;
                                    color: AppTheme.text_secondary;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }

                            Text {
                                text: root.get_preview_example(root.active_preview_id);
                                font-size: 10.5px;
                                color: AppTheme.text_muted;
                                overflow: elide;
                            }
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: AppTheme.border_subtle; }

            // 4. Footer Actions
            Rectangle {
                height: 52px;
                background: AppTheme.is_light ? #f8fafc : #111a2ce0;

                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    alignment: space-between;

                    // Left: Reset to Auto & Diff Status
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: center;

                        Rectangle {
                            height: 30px;
                            border-radius: 6px;
                            background: AppTheme.surface_pill;
                            border-width: 1px;
                            border-color: AppTheme.border_subtle;
                            y: (parent.height - self.height) / 2;

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.ov_keyboard = "auto";
                                    root.ov_front_bar = "auto";
                                    root.ov_ambient = "auto";
                                    root.ov_logo = "auto";
                                    root.reset_topology();
                                }
                            }

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 5px;
                                alignment: center;

                                Image {
                                    source: @image-url("../../assets/icons/rotate-ccw.svg");
                                    width: 12px;
                                    height: 12px;
                                    colorize: AppTheme.text_muted;
                                    y: (parent.height - self.height) / 2;
                                }
                                Text {
                                    text: AppI18n.tr(AppI18n.rev, "lighting.restore_auto_detect");
                                    font-size: 11px;
                                    font-weight: 500;
                                    color: AppTheme.text_secondary;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Text {
                            text: root.diff_count == 0 ? AppI18n.tr(AppI18n.rev, "lighting.matches_auto_detect") : (root.diff_count + AppI18n.tr(AppI18n.rev, "lighting.overrides_count_suffix"));
                            font-size: 11px;
                            font-weight: root.diff_count == 0 ? 500 : 700;
                            color: root.diff_count == 0 ? AppTheme.text_muted : #f59e0b;
                            vertical-alignment: center;
                        }
                    }

                    // Right: Cancel & Save
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: center;

                        Rectangle {
                            height: 30px;
                            border-radius: 6px;
                            background: AppTheme.surface_pill;
                            border-width: 1px;
                            border-color: AppTheme.border_subtle;
                            y: (parent.height - self.height) / 2;

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.close(); }
                            }

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: center;
                                Text {
                                    text: AppI18n.tr(AppI18n.rev, "lighting.cancel");
                                    font-size: 11px;
                                    color: AppTheme.text_secondary;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Rectangle {
                            height: 30px;
                            border-radius: 6px;
                            background: #0284c7;
                            y: (parent.height - self.height) / 2;

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.apply_topology(
                                        root.ov_keyboard,
                                        root.ov_front_bar,
                                        root.ov_ambient,
                                        root.ov_logo
                                    );
                                }
                            }

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 5px;
                                alignment: center;

                                Image {
                                    source: @image-url("../../assets/icons/check.svg");
                                    width: 13px;
                                    height: 13px;
                                    colorize: #ffffff;
                                    y: (parent.height - self.height) / 2;
                                }
                                Text {
                                    text: AppI18n.tr(AppI18n.rev, "lighting.save_reinit_hw");
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: #ffffff;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
