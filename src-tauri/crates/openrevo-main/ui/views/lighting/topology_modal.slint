                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;
                            horizontal-stretch: 1;

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;

                                Text {
                                    text: root.get_preview_title(root.active_preview_id);
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: #38bdf8;
                                    vertical-alignment: center;
                                }

                                Rectangle {
                                    height: 16px;
                                    border-radius: 3px;
                                    background: #0284c725;
