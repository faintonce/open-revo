import { AppTheme } from "../../theme.slint";

export component LightingTopologyModal inherits Rectangle {
    in-out property <bool> is_open: false;

    // Override settings (auto / specific value)
    in-out property <bool> override_enabled: false;
    in-out property <string> ov_keyboard: "auto";
    in-out property <string> ov_front_bar: "auto";
    in-out property <string> ov_ambient: "auto";
    in-out property <string> ov_logo: "auto";

    // Hardware detected baseline truth
    in property <string> base_keyboard: "per_key";
    in property <string> base_front_bar: "present";
    in property <string> base_ambient: "none";
    in property <string> base_logo: "shield";

    callback close();
    callback apply_topology(string, string, string, string);
    callback reset_topology();

    // Effective active option calculations
    property <string> eff_kb: (ov_keyboard == "auto" || ov_keyboard == "") ? base_keyboard : ov_keyboard;
    property <string> eff_front: (ov_front_bar == "auto" || ov_front_bar == "") ? base_front_bar : ov_front_bar;
    property <string> eff_amb: (ov_ambient == "auto" || ov_ambient == "") ? base_ambient : ov_ambient;
    property <string> eff_logo: (ov_logo == "auto" || ov_logo == "") ? base_logo : ov_logo;

    // Difference counter vs baseline
    property <int> diff_count: (ov_keyboard != "auto" && ov_keyboard != base_keyboard ? 1 : 0) +
                               (ov_front_bar != "auto" && ov_front_bar != base_front_bar ? 1 : 0) +
                               (ov_ambient != "auto" && ov_ambient != base_ambient ? 1 : 0) +
                               (ov_logo != "auto" && ov_logo != base_logo ? 1 : 0);

    // Interactive Hover Preview Item
    property <string> hovered_id: "";
    property <string> active_preview_id: hovered_id != "" ? hovered_id : ("kb:" + eff_kb);

    pure function get_preview_title(id: string) -> string {
        if id == "kb:per_key" { return "Полноцветный по-клавишный RGB"; }
        if id == "kb:four_zone" { return "4-зонное аппаратное разделение RGB"; }
        if id == "kb:single_zone" { return "Однозонный RGB (вся клавиатура одним цветом)"; }
        if id == "kb:single_white" { return "Одноцветная белая подсветка"; }
        if id == "kb:none" { return "Без подсветки клавиатуры"; }

        if id == "lb:present" { return "Световая полоса Coastline на передней кромке"; }
        if id == "lb:none" { return "Нет передней полосы Coastline"; }

        if id == "amb:vent" { return "Фоновая подсветка задних вентиляционных решёток"; }
        if id == "amb:shoulder" { return "Плечевые полосы «восьмёркой» (двойные крылья)"; }
        if id == "amb:none" { return "Без дополнительной фоновой подсветки"; }

        if id == "logo:letter" { return "Светящийся латинский логотип"; }
        if id == "logo:shield" { return "Светящийся щит-«гайка» логотип"; }
        if id == "logo:none" { return "Нет подсветки логотипа на крышке A"; }
        return "Предпросмотр характеристик оборудования";
    }

    pure function get_preview_chip(id: string) -> string {
        if id == "kb:per_key" { return "048D:600B / CE00"; }
        if id == "kb:four_zone" { return "048D:CE00"; }
        if id == "kb:single_zone" { return "EC RAM PWM"; }
        if id == "kb:single_white" { return "Белая подсветка EC"; }
        if id == "kb:none" { return "Disabled"; }

        if id == "lb:present" { return "048D:7001 / EC"; }
        if id == "lb:none" { return "None"; }

        if id == "amb:vent" { return "048D:7000 / Hinge"; }
        if id == "amb:shoulder" { return "IDZ Sync"; }
        if id == "amb:none" { return "None"; }

        if id == "logo:letter" { return "USB NewLogo (35)"; }
        if id == "logo:shield" { return "Эффекты подсветки через EC платы"; }
        if id == "logo:none" { return "None"; }
        return "Standard";
    }

    pure function get_preview_desc(id: string) -> string {
        if id == "kb:per_key" { return "Отдельный цвет для каждой клавиши; поддержка потока BetterRGB 60 FPS, ряби на воде и пользовательских шейдеров."; }
        if id == "kb:four_zone" { return "Клавиатура по горизонтали разделена на 4 физические зоны с отдельными цветами; аппаратные волны, бегущий огонь и дыхание."; }
        if id == "kb:single_zone" { return "Прямое управление от EC платы: вся клавиатура меняет цвет как единое целое; одноцветное свечение, дыхание и общий радужный градиент."; }
        if id == "kb:single_white" { return "Чисто белые LED: три ступени диммирования без мерцания — выкл / слабая (50%) / яркая (100%)."; }
        if id == "kb:none" { return "У платформы нет подсветки, либо карточка управления клавиатурой полностью скрыта в программе."; }

        if id == "lb:present" { return "Тонкая многосегментная световая полоса у передней кромки прямо под тачпадом; столкновения, бегущий огонь и полноцветные волны."; }
        if id == "lb:none" { return "У платформы нет физической световой полосы на передней кромке: выбор пункта полностью удаляет «призрачную» карточку Coastline и прекращает отправку пакетов."; }

        if id == "amb:vent" { return "Симметричные световые полосы выхлопа в стиле спорткара на задних решётках — классический хардкорный визуальный маркер платформ с СЖО."; }
        if id == "amb:shoulder" { return "Две световые полосы «крылья», расходящиеся диагонально над клавиатурой слева и справа, пульсируют в такт подсветке клавиш."; }
        if id == "amb:none" { return "У обычных моделей нет подсветки задних решёток или плечевых полос — карточки управления фоновой подсветкой в консоли не подгружаются."; }

        if id == "logo:letter" { return "Полная подсветка надписи MECHREVO целиком, управление через отдельный USB-чип; поддерживает цветные волны и бегущую подсветку."; }
        if id == "logo:shield" { return "Светящийся щит/гайка из двух половин (верх и низ), прямое управление EC платы; одноцветное свечение, дыхание и смешение трёх цветов."; }
        if id == "logo:none" { return "Крышка A — только металлическая наклейка, глянцевая печать или без подсветки; карточка эффектов крышки A скрыта во избежание ошибочных действий."; }
        return "Наведите курсор на любой вариант выше, чтобы увидеть описание протокола";
    }

    pure function get_preview_example(id: string) -> string {
        if id == "kb:per_key" { return "Типичные модели: Yaoshi 16 Pro/Ultra, Canglong 16, Jiaolong GM7ZG7S(CE00) и другие топовые"; }
        if id == "kb:four_zone" { return "Типичные модели: Jiaolong 16, X10 Pro, ранние версии Jiguang"; }
        if id == "kb:single_zone" { return "Типичные модели: Jiguang X, Yaoshi 15 (однозонная), Kuangshi G16"; }
        if id == "kb:single_white" { return "Типичные модели: Wujie 14X, Wujie 15X и другие ультрабуки"; }
        if id == "kb:none" { return "Типичные модели: универсальные платформы без подсветки"; }

        if id == "lb:present" { return "Типичные модели: Yaoshi 16, Jiaolong 16 и другие с подсветкой передней кромки"; }
        if id == "lb:none" { return "Типичные модели: вся линейка Jiguang, обычные версии Kuangshi"; }

        if id == "amb:vent" { return "Типичные модели: Kuangshi 16 Super (версия с СЖО) и другие флагманы"; }
        if id == "amb:shoulder" { return "Типичные модели: серия шасси IDZ (Deep Sea Ghost)"; }
        if id == "amb:none" { return "Типичные модели: подавляющее большинство моделей без дополнительной фоновой подсветки"; }

        if id == "logo:letter" { return "Типичные модели: GM6IX0B, ранние спецверсии Yaoshi"; }
        if id == "logo:shield" { return "Типичные модели: Canglong, вся серия Yaoshi, Jiguang X, Jiaolong"; }
        if id == "logo:none" { return "Типичные модели: вся линейка ультрабуков Wujie"; }
        return "";
    }

    background: #000000c8;

    // Prevent background click-through
    TouchArea { }

    Rectangle {
        width: Math.min(parent.width - 32px, 830px);
        height: Math.min(parent.height - 24px, 530px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: AppTheme.is_light ? #ffffff : #0c121ee8;
        border-radius: 14px;
        border-width: 1px;
        border-color: #38bdf838;
        clip: true;

        VerticalLayout {
            // 1. Header
            Rectangle {
                height: 56px;
                background: AppTheme.is_light ? #f8fafc : #111a2ce0;

                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 12px;
                        alignment: center;

                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 8px;
                            background: #0284c725;
                            border-width: 1px;
                            border-color: #0284c755;
                            y: (parent.height - self.height) / 2;

                            Image {
                                source: @image-url("../../assets/icons/cpu.svg");
                                width: 17px;
                                height: 17px;
                                colorize: #38bdf8;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;

                                Text {
                                    text: "Исправление топологии оборудования подсветки";
                                    font-size: 14px;
                                    font-weight: 700;
                                    color: AppTheme.text_primary;
                                    vertical-alignment: center;
                                }

                                Rectangle {
                                    height: 18px;
                                    border-radius: 4px;
                                    background: #0284c718;
                                    border-width: 1px;
                                    border-color: #38bdf866;
                                    y: (parent.height - self.height) / 2;

                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        Text {
                                            text: "Адаптация для ультратонких";
                                            font-size: 10px;
                                            font-weight: 600;
                                            color: #38bdf8;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            Text {
                                text: "Если автоопределение не совпало с физическим оборудованием, укажите устройство вручную здесь. Наведите курсор на вариант или ⓘ, чтобы увидеть протокол и совместимые модели.";
                                font-size: 11px;
                                color: AppTheme.text_muted;
                            }
                        }
                    }

                    // Close Button
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 14px;
                        background: AppTheme.surface_pill;
                        y: (parent.height - self.height) / 2;

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.close(); }
                        }

                        Image {
                            source: @image-url("../../assets/icons/x.svg");
                            width: 14px;
                            height: 14px;
                            colorize: AppTheme.text_muted;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: AppTheme.border_subtle; }

            // 2. Body Settings: 4 维度拓扑卡片
            VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 14px;
                padding-bottom: 10px;
                spacing: 12px;

                // Row 1: 键盘背光硬件
                Rectangle {
                    height: 58px;
                    border-radius: 8px;
                    background: AppTheme.is_light ? #f8fafc : #11182745;
                    border-width: 1px;
                    border-color: AppTheme.border_subtle;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        alignment: space-between;

                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;
                            min-width: 160px;

                            Text {
                                text: "⌨️ 1. Оборудование подсветки клавиатуры";
                                font-size: 12px;
                                font-weight: 700;
                                color: AppTheme.text_primary;
                            }
                            HorizontalLayout {
                                spacing: 4px;
                                Text {
                                    text: "Автоопределение: ";
                                    font-size: 11px;
                                    color: AppTheme.text_muted;
                                }
                                Text {
                                    text: root.base_keyboard;
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: #38bdf8;
                                }
                            }
                        }

                        // Radio Pills
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: center;

                            // 全彩逐键
                            Rectangle {
                                height: 30px;
                                border-radius: 15px;
                                background: root.eff_kb == "per_key" ? #0284c728 : AppTheme.surface_pill;
                                border-width: 1px;
                                border-color: root.eff_kb == "per_key" ? #38bdf8 : AppTheme.border_subtle;

                                TouchArea {
                                    mouse-cursor: pointer;
                                    pointer-event(event) => {
                                        if event.kind == PointerEventKind.move { root.hovered_id = "kb:per_key"; }
                                    }
                                    clicked => { root.ov_keyboard = "per_key"; }
                                }

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 6px;
                                    alignment: center;

                                    Rectangle {
                                        width: 8px;
                                        height: 8px;
                                        border-radius: 4px;
                                        background: root.eff_kb == "per_key" ? #38bdf8 : transparent;
                                        border-width: 1.5px;
                                        border-color: root.eff_kb == "per_key" ? #38bdf8 : #64748b;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: "Полноцветный по-клавишный RGB";
                                        font-size: 11px;
                                        font-weight: root.eff_kb == "per_key" ? 700 : 500;
                                        color: root.eff_kb == "per_key" ? #ffffff : AppTheme.text_secondary;
                                        vertical-alignment: center;
                                    }
                                    if root.base_keyboard == "per_key": Rectangle {
                                        height: 15px;
                                        border-radius: 3px;
                                        background: #0284c725;
                                        border-width: 1px;
                                        border-color: #38bdf877;
                                        y: (parent.height - self.height) / 2;
                                        HorizontalLayout { padding-left: 4px; padding-right: 4px; Text { text: "Авто"; font-size: 9px; font-weight: 700; color: #38bdf8; vertical-alignment: center; } }
                                    }
                                    Text { text: "ⓘ"; font-size: 11px; color: #64748b; vertical-alignment: center; }
                                }
                            }

                            // 4区 RGB
                            Rectangle {
                                height: 30px;
                                border-radius: 15px;
                                background: root.eff_kb == "four_zone" ? #0284c728 : AppTheme.surface_pill;
                                border-width: 1px;
                                border-color: root.eff_kb == "four_zone" ? #38bdf8 : AppTheme.border_subtle;

                                TouchArea {
                                    mouse-cursor: pointer;
                                    pointer-event(event) => {
                                        if event.kind == PointerEventKind.move { root.hovered_id = "kb:four_zone"; }
                                    }
                                    clicked => { root.ov_keyboard = "four_zone"; }
                                }

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 6px;
                                    alignment: center;

                                    Rectangle {
                                        width: 8px;
                                        height: 8px;
                                        border-radius: 4px;
                                        background: root.eff_kb == "four_zone" ? #38bdf8 : transparent;
                                        border-width: 1.5px;
                                        border-color: root.eff_kb == "four_zone" ? #38bdf8 : #64748b;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: "4-зонный RGB";
                                        font-size: 11px;
                                        font-weight: root.eff_kb == "four_zone" ? 700 : 500;
                                        color: root.eff_kb == "four_zone" ? #ffffff : AppTheme.text_secondary;
                                        vertical-alignment: center;
                                    }
                                    if root.base_keyboard == "four_zone": Rectangle {
                                        height: 15px;
                                        border-radius: 3px;
                                        background: #0284c725;
                                        border-width: 1px;
                                        border-color: #38bdf877;
                                        y: (parent.height - self.height) / 2;
                                        HorizontalLayout { padding-left: 4px; padding-right: 4px; Text { text: "Авто"; font-size: 9px; font-weight: 700; color: #38bdf8; vertical-alignment: center; } }
                                    }
                                    Text { text: "ⓘ"; font-size: 11px; color: #64748b; vertical-alignment: center; }
                                }
                            }

                            // 单区 RGB
                            Rectangle {
                                height: 30px;
                                border-radius: 15px;
                                background: root.eff_kb == "single_zone" ? #0284c728 : AppTheme.surface_pill;
                                border-width: 1px;
                                border-color: root.eff_kb == "single_zone" ? #38bdf8 : AppTheme.border_subtle;

                                TouchArea {
                                    mouse-cursor: pointer;
                                    pointer-event(event) => {
                                        if event.kind == PointerEventKind.move { root.hovered_id = "kb:single_zone"; }
                                    }
                                    clicked => { root.ov_keyboard = "single_zone"; }
                                }

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 6px;
                                    alignment: center;

                                    Rectangle {
                                        width: 8px;
                                        height: 8px;
                                        border-radius: 4px;
                                        background: root.eff_kb == "single_zone" ? #38bdf8 : transparent;
                                        border-width: 1.5px;
                                        border-color: root.eff_kb == "single_zone" ? #38bdf8 : #64748b;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: "Однозонный RGB";
                                        font-size: 11px;
                                        font-weight: root.eff_kb == "single_zone" ? 700 : 500;
                                        color: root.eff_kb == "single_zone" ? #ffffff : AppTheme.text_secondary;
                                        vertical-alignment: center;
                                    }
                                    if root.base_keyboard == "single_zone": Rectangle {
                                        height: 15px;
                                        border-radius: 3px;
                                        background: #0284c725;
                                        border-width: 1px;
                                        border-color: #38bdf877;
                                        y: (parent.height - self.height) / 2;
                                        HorizontalLayout { padding-left: 4px; padding-right: 4px; Text { text: "Авто"; font-size: 9px; font-weight: 700; color: #38bdf8; vertical-alignment: center; } }
                                    }
                                    Text { text: "ⓘ"; font-size: 11px; color: #64748b; vertical-alignment: center; }
                                }
                            }

                            // 单色白光
                            Rectangle {
                                height: 30px;
                                border-radius: 15px;
                                background: root.eff_kb == "single_white" ? #0284c728 : AppTheme.surface_pill;
                                border-width: 1px;
                                border-color: root.eff_kb == "single_white" ? #38bdf8 : AppTheme.border_subtle;

                                TouchArea {
                                    mouse-cursor: pointer;
                                    pointer-event(event) => {
                                        if event.kind == PointerEventKind.move { root.hovered_id = "kb:single_white"; }
                                    }
                                    clicked => { root.ov_keyboard = "single_white"; }
                                }

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 6px;
                                    alignment: center;

                                    Rectangle {
                                        width: 8px;
                                        height: 8px;
                                        border-radius: 4px;
                                        background: root.eff_kb == "single_white" ? #38bdf8 : transparent;
                                        border-width: 1.5px;
                                        border-color: root.eff_kb == "single_white" ? #38bdf8 : #64748b;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: "Одноцветный белый";
                                        font-size: 11px;
                                        font-weight: root.eff_kb == "single_white" ? 700 : 500;
                                        color: root.eff_kb == "single_white" ? #ffffff : AppTheme.text_secondary;
                                        vertical-alignment: center;
                                    }
                                    if root.base_keyboard == "single_white": Rectangle {
                                        height: 15px;
                                        border-radius: 3px;
                                        background: #0284c725;
                                        border-width: 1px;
                                        border-color: #38bdf877;
                                        y: (parent.height - self.height) / 2;
                                        HorizontalLayout { padding-left: 4px; padding-right: 4px; Text { text: "Авто"; font-size: 9px; font-weight: 700; color: #38bdf8; vertical-alignment: center; } }
                                    }
                                    Text { text: "ⓘ"; font-size: 11px; color: #64748b; vertical-alignment: center; }
                                }
                            }

                            // 无背光/禁用
                            Rectangle {
                                height: 30px;
                                border-radius: 15px;
                                background: root.eff_kb == "none" ? #0284c728 : AppTheme.surface_pill;
                                border-width: 1px;
                                border-color: root.eff_kb == "none" ? #38bdf8 : AppTheme.border_subtle;

                                TouchArea {
                                    mouse-cursor: pointer;
                                    pointer-event(event) => {
                                        if event.kind == PointerEventKind.move { root.hovered_id = "kb:none"; }
                                    }
                                    clicked => { root.ov_keyboard = "none"; }
                                }

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 6px;
                                    alignment: center;

                                    Rectangle {
                                        width: 8px;
                                        height: 8px;
                                        border-radius: 4px;
                                        background: root.eff_kb == "none" ? #38bdf8 : transparent;
                                        border-width: 1.5px;
                                        border-color: root.eff_kb == "none" ? #38bdf8 : #64748b;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: "Без подсветки / отключено";
                                        font-size: 11px;
                                        font-weight: root.eff_kb == "none" ? 700 : 500;
                                        color: root.eff_kb == "none" ? #ffffff : AppTheme.text_secondary;
                                        vertical-alignment: center;
                                    }
                                    if root.base_keyboard == "none": Rectangle {
                                        height: 15px;
                                        border-radius: 3px;
                                        background: #0284c725;
                                        border-width: 1px;
                                        border-color: #38bdf877;
                                        y: (parent.height - self.height) / 2;
                                        HorizontalLayout { padding-left: 4px; padding-right: 4px; Text { text: "Авто"; font-size: 9px; font-weight: 700; color: #38bdf8; vertical-alignment: center; } }
                                    }
                                    Text { text: "ⓘ"; font-size: 11px; color: #64748b; vertical-alignment: center; }
                                }
                            }
