            Rectangle { height: 1px; background: AppTheme.border_subtle; }

            // 4. Footer Actions
            Rectangle {
                height: 52px;
                background: AppTheme.is_light ? #f8fafc : #111a2ce0;

                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    alignment: space-between;

                    // Left: Reset to Auto & Diff Status
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: center;

                        Rectangle {
                            height: 30px;
                            border-radius: 6px;
                            background: AppTheme.surface_pill;
                            border-width: 1px;
                            border-color: AppTheme.border_subtle;
                            y: (parent.height - self.height) / 2;

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.ov_keyboard = "auto";
                                    root.ov_front_bar = "auto";
                                    root.ov_ambient = "auto";
                                    root.ov_logo = "auto";
                                    root.reset_topology();
                                }
                            }

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 5px;
                                alignment: center;

                                Image {
                                    source: @image-url("../../assets/icons/rotate-ccw.svg");
                                    width: 12px;
                                    height: 12px;
                                    colorize: AppTheme.text_muted;
                                    y: (parent.height - self.height) / 2;
                                }
                                Text {
                                    text: "恢复全自动探测";
                                    font-size: 11px;
                                    font-weight: 500;
                                    color: AppTheme.text_secondary;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Text {
                            text: root.diff_count == 0 ? "与自动探测一致" : (root.diff_count + " 项已手动纠偏");
                            font-size: 11px;
                            font-weight: root.diff_count == 0 ? 500 : 700;
                            color: root.diff_count == 0 ? AppTheme.text_muted : #f59e0b;
                            vertical-alignment: center;
                        }
                    }

                    // Right: Cancel & Save
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: center;

                        Rectangle {
                            height: 30px;
                            border-radius: 6px;
                            background: AppTheme.surface_pill;
                            border-width: 1px;
                            border-color: AppTheme.border_subtle;
                            y: (parent.height - self.height) / 2;

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.close(); }
                            }

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: center;
                                Text {
                                    text: "取消";
                                    font-size: 11px;
                                    color: AppTheme.text_secondary;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Rectangle {
                            height: 30px;
                            border-radius: 6px;
                            background: #0284c7;
                            y: (parent.height - self.height) / 2;

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.apply_topology(
                                        root.ov_keyboard,
                                        root.ov_front_bar,
                                        root.ov_ambient,
                                        root.ov_logo
                                    );
                                }
                            }

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 5px;
                                alignment: center;

                                Image {
                                    source: @image-url("../../assets/icons/check.svg");
                                    width: 13px;
                                    height: 13px;
                                    colorize: #ffffff;
                                    y: (parent.height - self.height) / 2;
                                }
                                Text {
                                    text: "保存并重新初始化硬件";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: #ffffff;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
