import { AppTheme } from "../../theme.slint";
import { AppI18n } from "../../i18n.slint";

export component LightingTopologyModal inherits Rectangle {
    in-out property <bool> is_open: false;

    // Override settings (auto / specific value)
    in-out property <bool> override_enabled: false;
    in-out property <string> ov_keyboard: "auto";
    in-out property <string> ov_front_bar: "auto";
    in-out property <string> ov_ambient: "auto";
    in-out property <string> ov_logo: "auto";

    // Hardware detected baseline truth
    in property <string> base_keyboard: "per_key";
    in property <string> base_front_bar: "present";
    in property <string> base_ambient: "none";
    in property <string> base_logo: "shield";

    callback close();
    callback apply_topology(string, string, string, string);
    callback reset_topology();

    // Effective active option calculations
    property <string> eff_kb: (ov_keyboard == "auto" || ov_keyboard == "") ? base_keyboard : ov_keyboard;
    property <string> eff_front: (ov_front_bar == "auto" || ov_front_bar == "") ? base_front_bar : ov_front_bar;
    property <string> eff_amb: (ov_ambient == "auto" || ov_ambient == "") ? base_ambient : ov_ambient;
    property <string> eff_logo: (ov_logo == "auto" || ov_logo == "") ? base_logo : ov_logo;

    // Difference counter vs baseline
    property <int> diff_count: (ov_keyboard != "auto" && ov_keyboard != base_keyboard ? 1 : 0) +
                               (ov_front_bar != "auto" && ov_front_bar != base_front_bar ? 1 : 0) +
                               (ov_ambient != "auto" && ov_ambient != base_ambient ? 1 : 0) +
                               (ov_logo != "auto" && ov_logo != base_logo ? 1 : 0);

    // Interactive Hover Preview Item
    property <string> hovered_id: "";
    property <string> active_preview_id: hovered_id != "" ? hovered_id : ("kb:" + eff_kb);

    pure function get_preview_title(id: string) -> string {
        if id == "kb:per_key" { return AppI18n.tr(AppI18n.rev, "lighting.topo_kb_perkey"); }
        if id == "kb:four_zone" { return AppI18n.tr(AppI18n.rev, "lighting.topo_kb_4zone"); }
        if id == "kb:single_zone" { return AppI18n.tr(AppI18n.rev, "lighting.topo_kb_1zone"); }
        if id == "kb:single_white" { return AppI18n.tr(AppI18n.rev, "lighting.topo_kb_white"); }
        if id == "kb:none" { return AppI18n.tr(AppI18n.rev, "lighting.topo_kb_none"); }

        if id == "lb:present" { return AppI18n.tr(AppI18n.rev, "lighting.topo_lb_front"); }
        if id == "lb:none" { return AppI18n.tr(AppI18n.rev, "lighting.topo_lb_none"); }

        if id == "amb:vent" { return AppI18n.tr(AppI18n.rev, "lighting.topo_amb_rear"); }
        if id == "amb:shoulder" { return AppI18n.tr(AppI18n.rev, "lighting.topo_amb_shoulder"); }
        if id == "amb:none" { return AppI18n.tr(AppI18n.rev, "lighting.topo_amb_none"); }

        if id == "logo:letter" { return AppI18n.tr(AppI18n.rev, "lighting.topo_logo_letters"); }
        if id == "logo:shield" { return AppI18n.tr(AppI18n.rev, "lighting.topo_logo_shield"); }
        if id == "logo:none" { return AppI18n.tr(AppI18n.rev, "lighting.topo_logo_none"); }
        return AppI18n.tr(AppI18n.rev, "lighting.topo_spec_preview");
    }

    pure function get_preview_chip(id: string) -> string {
        if id == "kb:per_key" { return "048D:600B / CE00"; }
        if id == "kb:four_zone" { return "048D:CE00"; }
        if id == "kb:single_zone" { return "EC RAM PWM"; }
        if id == "kb:single_white" { return AppI18n.tr(AppI18n.rev, "lighting.ec_white_bl"); }
        if id == "kb:none" { return "Disabled"; }

        if id == "lb:present" { return "048D:7001 / EC"; }
        if id == "lb:none" { return "None"; }

        if id == "amb:vent" { return "048D:7000 / Hinge"; }
        if id == "amb:shoulder" { return "IDZ Sync"; }
        if id == "amb:none" { return "None"; }

        if id == "logo:letter" { return "USB NewLogo (35)"; }
        if id == "logo:shield" { return AppI18n.tr(AppI18n.rev, "lighting.ec_board_fx"); }
        if id == "logo:none" { return "None"; }
        return "Standard";
    }

    pure function get_preview_desc(id: string) -> string {
        if id == "kb:per_key" { return AppI18n.tr(AppI18n.rev, "lighting.desc_kb_perkey"); }
        if id == "kb:four_zone" { return AppI18n.tr(AppI18n.rev, "lighting.desc_kb_4zone"); }
        if id == "kb:single_zone" { return AppI18n.tr(AppI18n.rev, "lighting.desc_kb_1zone"); }
        if id == "kb:single_white" { return AppI18n.tr(AppI18n.rev, "lighting.desc_kb_white"); }
        if id == "kb:none" { return AppI18n.tr(AppI18n.rev, "lighting.desc_kb_none"); }

        if id == "lb:present" { return AppI18n.tr(AppI18n.rev, "lighting.desc_lb_front"); }
        if id == "lb:none" { return AppI18n.tr(AppI18n.rev, "lighting.desc_lb_none"); }

        if id == "amb:vent" { return AppI18n.tr(AppI18n.rev, "lighting.desc_amb_rear"); }
        if id == "amb:shoulder" { return AppI18n.tr(AppI18n.rev, "lighting.desc_amb_shoulder"); }
        if id == "amb:none" { return AppI18n.tr(AppI18n.rev, "lighting.desc_amb_none"); }

        if id == "logo:letter" { return AppI18n.tr(AppI18n.rev, "lighting.desc_logo_letters"); }
        if id == "logo:shield" { return AppI18n.tr(AppI18n.rev, "lighting.desc_logo_shield"); }
        if id == "logo:none" { return AppI18n.tr(AppI18n.rev, "lighting.desc_logo_none"); }
        return AppI18n.tr(AppI18n.rev, "lighting.hover_spec_hint");
    }

    pure function get_preview_example(id: string) -> string {
        if id == "kb:per_key" { return AppI18n.tr(AppI18n.rev, "lighting.models_kb_perkey"); }
        if id == "kb:four_zone" { return AppI18n.tr(AppI18n.rev, "lighting.models_kb_4zone"); }
        if id == "kb:single_zone" { return AppI18n.tr(AppI18n.rev, "lighting.models_kb_1zone"); }
        if id == "kb:single_white" { return AppI18n.tr(AppI18n.rev, "lighting.models_kb_white"); }
        if id == "kb:none" { return AppI18n.tr(AppI18n.rev, "lighting.models_kb_none"); }

        if id == "lb:present" { return AppI18n.tr(AppI18n.rev, "lighting.models_lb_front"); }
        if id == "lb:none" { return AppI18n.tr(AppI18n.rev, "lighting.models_lb_none"); }

        if id == "amb:vent" { return AppI18n.tr(AppI18n.rev, "lighting.models_amb_rear"); }
        if id == "amb:shoulder" { return AppI18n.tr(AppI18n.rev, "lighting.models_amb_shoulder"); }
        if id == "amb:none" { return AppI18n.tr(AppI18n.rev, "lighting.models_amb_none"); }

        if id == "logo:letter" { return AppI18n.tr(AppI18n.rev, "lighting.models_logo_letters"); }
        if id == "logo:shield" { return AppI18n.tr(AppI18n.rev, "lighting.models_logo_shield"); }
        if id == "logo:none" { return AppI18n.tr(AppI18n.rev, "lighting.models_logo_none"); }
        return "";
    }

    background: #000000c8;

    // Prevent background click-through
    TouchArea { }

    Rectangle {
        width: Math.min(parent.width - 32px, 830px);
        height: Math.min(parent.height - 24px, 530px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: AppTheme.is_light ? #ffffff : #0c121ee8;
        border-radius: 14px;
        border-width: 1px;
        border-color: #38bdf838;
        clip: true;

        VerticalLayout {
            // 1. Header
            Rectangle {
                height: 56px;
                background: AppTheme.is_light ? #f8fafc : #111a2ce0;

                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 12px;
                        alignment: center;

                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 8px;
                            background: #0284c725;
                            border-width: 1px;
                            border-color: #0284c755;
                            y: (parent.height - self.height) / 2;

                            Image {
                                source: @image-url("../../assets/icons/cpu.svg");
                                width: 17px;
                                height: 17px;
                                colorize: #38bdf8;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;

                                Text {
                                    text: AppI18n.tr(AppI18n.rev, "lighting.topo_modal_title");
                                    font-size: 14px;
                                    font-weight: 700;
                                    color: AppTheme.text_primary;
                                    vertical-alignment: center;
                                }

                                Rectangle {
                                    height: 18px;
                                    border-radius: 4px;
                                    background: #0284c718;
                                    border-width: 1px;
                                    border-color: #38bdf866;
                                    y: (parent.height - self.height) / 2;

                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        Text {
                                            text: AppI18n.tr(AppI18n.rev, "lighting.ultra_adaptive");
                                            font-size: 10px;
                                            font-weight: 600;
                                            color: #38bdf8;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            Text {
                                text: AppI18n.tr(AppI18n.rev, "lighting.topo_modal_desc");
                                font-size: 11px;
                                color: AppTheme.text_muted;
                            }
                        }
                    }

                    // Close Button
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 14px;
                        background: AppTheme.surface_pill;
                        y: (parent.height - self.height) / 2;

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.close(); }
                        }

                        Image {
                            source: @image-url("../../assets/icons/x.svg");
                            width: 14px;
                            height: 14px;
                            colorize: AppTheme.text_muted;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: AppTheme.border_subtle; }

            // 2. Body Settings: 4 维度拓扑卡片
            VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 14px;
                padding-bottom: 10px;
                spacing: 12px;

                // Row 1: 键盘背光硬件
                Rectangle {
                    height: 58px;
                    border-radius: 8px;
                    background: AppTheme.is_light ? #f8fafc : #11182745;
                    border-width: 1px;
                    border-color: AppTheme.border_subtle;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        alignment: space-between;

                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;
                            min-width: 160px;

                            Text {
                                text: AppI18n.tr(AppI18n.rev, "lighting.topo_sec_kb");
                                font-size: 12px;
                                font-weight: 700;
                                color: AppTheme.text_primary;
                            }
                            HorizontalLayout {
                                spacing: 4px;
                                Text {
                                    text: AppI18n.tr(AppI18n.rev, "lighting.auto_detect_prefix");
                                    font-size: 11px;
                                    color: AppTheme.text_muted;
                                }
                                Text {
                                    text: root.base_keyboard;
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: #38bdf8;
                                }
                            }
                        }

                        // Radio Pills
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: center;

                            // 全彩逐键
                            Rectangle {
                                height: 30px;
                                border-radius: 15px;
                                background: root.eff_kb == "per_key" ? #0284c728 : AppTheme.surface_pill;
                                border-width: 1px;
                                border-color: root.eff_kb == "per_key" ? #38bdf8 : AppTheme.border_subtle;

                                TouchArea {
                                    mouse-cursor: pointer;
                                    pointer-event(event) => {
                                        if event.kind == PointerEventKind.move { root.hovered_id = "kb:per_key"; }
                                    }
                                    clicked => { root.ov_keyboard = "per_key"; }
                                }

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 6px;
                                    alignment: center;

                                    Rectangle {
                                        width: 8px;
                                        height: 8px;
                                        border-radius: 4px;
                                        background: root.eff_kb == "per_key" ? #38bdf8 : transparent;
                                        border-width: 1.5px;
                                        border-color: root.eff_kb == "per_key" ? #38bdf8 : #64748b;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: AppI18n.tr(AppI18n.rev, "lighting.topo_kb_perkey");
                                        font-size: 11px;
                                        font-weight: root.eff_kb == "per_key" ? 700 : 500;
                                        color: root.eff_kb == "per_key" ? #ffffff : AppTheme.text_secondary;
                                        vertical-alignment: center;
                                    }
                                    if root.base_keyboard == "per_key": Rectangle {
                                        height: 15px;
                                        border-radius: 3px;
                                        background: #0284c725;
                                        border-width: 1px;
                                        border-color: #38bdf877;
                                        y: (parent.height - self.height) / 2;
                                        HorizontalLayout { padding-left: 4px; padding-right: 4px; Text { text: AppI18n.tr(AppI18n.rev, "lighting.auto"); font-size: 9px; font-weight: 700; color: #38bdf8; vertical-alignment: center; } }
                                    }
                                    Text { text: "ⓘ"; font-size: 11px; color: #64748b; vertical-alignment: center; }
                                }
                            }

                            // 4区 RGB
                            Rectangle {
                                height: 30px;
                                border-radius: 15px;
                                background: root.eff_kb == "four_zone" ? #0284c728 : AppTheme.surface_pill;
                                border-width: 1px;
                                border-color: root.eff_kb == "four_zone" ? #38bdf8 : AppTheme.border_subtle;

                                TouchArea {
                                    mouse-cursor: pointer;
                                    pointer-event(event) => {
                                        if event.kind == PointerEventKind.move { root.hovered_id = "kb:four_zone"; }
                                    }
                                    clicked => { root.ov_keyboard = "four_zone"; }
                                }

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 6px;
                                    alignment: center;

                                    Rectangle {
                                        width: 8px;
                                        height: 8px;
                                        border-radius: 4px;
                                        background: root.eff_kb == "four_zone" ? #38bdf8 : transparent;
                                        border-width: 1.5px;
                                        border-color: root.eff_kb == "four_zone" ? #38bdf8 : #64748b;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: AppI18n.tr(AppI18n.rev, "lighting.kb_4zone");
                                        font-size: 11px;
                                        font-weight: root.eff_kb == "four_zone" ? 700 : 500;
                                        color: root.eff_kb == "four_zone" ? #ffffff : AppTheme.text_secondary;
                                        vertical-alignment: center;
                                    }
                                    if root.base_keyboard == "four_zone": Rectangle {
                                        height: 15px;
                                        border-radius: 3px;
                                        background: #0284c725;
                                        border-width: 1px;
                                        border-color: #38bdf877;
                                        y: (parent.height - self.height) / 2;
                                        HorizontalLayout { padding-left: 4px; padding-right: 4px; Text { text: AppI18n.tr(AppI18n.rev, "lighting.auto"); font-size: 9px; font-weight: 700; color: #38bdf8; vertical-alignment: center; } }
                                    }
                                    Text { text: "ⓘ"; font-size: 11px; color: #64748b; vertical-alignment: center; }
                                }
                            }

                            // 单区 RGB
                            Rectangle {
                                height: 30px;
                                border-radius: 15px;
                                background: root.eff_kb == "single_zone" ? #0284c728 : AppTheme.surface_pill;
                                border-width: 1px;
                                border-color: root.eff_kb == "single_zone" ? #38bdf8 : AppTheme.border_subtle;

                                TouchArea {
                                    mouse-cursor: pointer;
                                    pointer-event(event) => {
                                        if event.kind == PointerEventKind.move { root.hovered_id = "kb:single_zone"; }
                                    }
                                    clicked => { root.ov_keyboard = "single_zone"; }
                                }

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 6px;
                                    alignment: center;

                                    Rectangle {
                                        width: 8px;
                                        height: 8px;
                                        border-radius: 4px;
                                        background: root.eff_kb == "single_zone" ? #38bdf8 : transparent;
                                        border-width: 1.5px;
                                        border-color: root.eff_kb == "single_zone" ? #38bdf8 : #64748b;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: AppI18n.tr(AppI18n.rev, "lighting.kb_1zone");
                                        font-size: 11px;
                                        font-weight: root.eff_kb == "single_zone" ? 700 : 500;
                                        color: root.eff_kb == "single_zone" ? #ffffff : AppTheme.text_secondary;
                                        vertical-alignment: center;
                                    }
                                    if root.base_keyboard == "single_zone": Rectangle {
                                        height: 15px;
                                        border-radius: 3px;
                                        background: #0284c725;
                                        border-width: 1px;
                                        border-color: #38bdf877;
                                        y: (parent.height - self.height) / 2;
                                        HorizontalLayout { padding-left: 4px; padding-right: 4px; Text { text: AppI18n.tr(AppI18n.rev, "lighting.auto"); font-size: 9px; font-weight: 700; color: #38bdf8; vertical-alignment: center; } }
                                    }
                                    Text { text: "ⓘ"; font-size: 11px; color: #64748b; vertical-alignment: center; }
                                }
                            }

                            // 单色白光
                            Rectangle {
                                height: 30px;
                                border-radius: 15px;
                                background: root.eff_kb == "single_white" ? #0284c728 : AppTheme.surface_pill;
                                border-width: 1px;
                                border-color: root.eff_kb == "single_white" ? #38bdf8 : AppTheme.border_subtle;

                                TouchArea {
                                    mouse-cursor: pointer;
                                    pointer-event(event) => {
                                        if event.kind == PointerEventKind.move { root.hovered_id = "kb:single_white"; }
                                    }
                                    clicked => { root.ov_keyboard = "single_white"; }
                                }

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 6px;
                                    alignment: center;

                                    Rectangle {
                                        width: 8px;
                                        height: 8px;
                                        border-radius: 4px;
                                        background: root.eff_kb == "single_white" ? #38bdf8 : transparent;
                                        border-width: 1.5px;
                                        border-color: root.eff_kb == "single_white" ? #38bdf8 : #64748b;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: AppI18n.tr(AppI18n.rev, "lighting.kb_white");
                                        font-size: 11px;
                                        font-weight: root.eff_kb == "single_white" ? 700 : 500;
                                        color: root.eff_kb == "single_white" ? #ffffff : AppTheme.text_secondary;
                                        vertical-alignment: center;
                                    }
                                    if root.base_keyboard == "single_white": Rectangle {
                                        height: 15px;
                                        border-radius: 3px;
                                        background: #0284c725;
                                        border-width: 1px;
                                        border-color: #38bdf877;
                                        y: (parent.height - self.height) / 2;
                                        HorizontalLayout { padding-left: 4px; padding-right: 4px; Text { text: AppI18n.tr(AppI18n.rev, "lighting.auto"); font-size: 9px; font-weight: 700; color: #38bdf8; vertical-alignment: center; } }
                                    }
                                    Text { text: "ⓘ"; font-size: 11px; color: #64748b; vertical-alignment: center; }
                                }
                            }

                            // 无背光/禁用
                            Rectangle {
                                height: 30px;
                                border-radius: 15px;
                                background: root.eff_kb == "none" ? #0284c728 : AppTheme.surface_pill;
                                border-width: 1px;
                                border-color: root.eff_kb == "none" ? #38bdf8 : AppTheme.border_subtle;

                                TouchArea {
                                    mouse-cursor: pointer;
                                    pointer-event(event) => {
                                        if event.kind == PointerEventKind.move { root.hovered_id = "kb:none"; }
                                    }
                                    clicked => { root.ov_keyboard = "none"; }
                                }

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 6px;
                                    alignment: center;

                                    Rectangle {
                                        width: 8px;
                                        height: 8px;
                                        border-radius: 4px;
                                        background: root.eff_kb == "none" ? #38bdf8 : transparent;
                                        border-width: 1.5px;
                                        border-color: root.eff_kb == "none" ? #38bdf8 : #64748b;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: AppI18n.tr(AppI18n.rev, "lighting.kb_none");
                                        font-size: 11px;
                                        font-weight: root.eff_kb == "none" ? 700 : 500;
                                        color: root.eff_kb == "none" ? #ffffff : AppTheme.text_secondary;
                                        vertical-alignment: center;
                                    }
                                    if root.base_keyboard == "none": Rectangle {
                                        height: 15px;
                                        border-radius: 3px;
                                        background: #0284c725;
                                        border-width: 1px;
                                        border-color: #38bdf877;
                                        y: (parent.height - self.height) / 2;
                                        HorizontalLayout { padding-left: 4px; padding-right: 4px; Text { text: AppI18n.tr(AppI18n.rev, "lighting.auto"); font-size: 9px; font-weight: 700; color: #38bdf8; vertical-alignment: center; } }
                                    }
                                    Text { text: "ⓘ"; font-size: 11px; color: #64748b; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                }

                // Row 2: 前置海岸灯条
                Rectangle {
                    height: 58px;
                    border-radius: 8px;
                    background: AppTheme.is_light ? #f8fafc : #11182745;
                    border-width: 1px;
                    border-color: AppTheme.border_subtle;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        alignment: space-between;

                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;
                            min-width: 160px;

                            Text {
                                text: AppI18n.tr(AppI18n.rev, "lighting.topo_sec_lb");
                                font-size: 12px;
                                font-weight: 700;
                                color: AppTheme.text_primary;
                            }
                            HorizontalLayout {
                                spacing: 4px;
                                Text {
                                    text: AppI18n.tr(AppI18n.rev, "lighting.auto_detect_prefix");
                                    font-size: 11px;
                                    color: AppTheme.text_muted;
                                }
                                Text {
                                    text: root.base_front_bar == "present" ? AppI18n.tr(AppI18n.rev, "lighting.has_lightbar") : AppI18n.tr(AppI18n.rev, "lighting.not_detected");
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: #38bdf8;
                                }
                            }
