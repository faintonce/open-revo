                                    font-size: 11px;
                                    font-weight: 600;
                                    color: #38bdf8;
                                }
                            }
                        }

                        // Radio Pills
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: center;

                            // 字母 LOGO
                            Rectangle {
                                height: 30px;
                                border-radius: 15px;
                                background: root.eff_logo == "letter" ? #0284c728 : AppTheme.surface_pill;
                                border-width: 1px;
                                border-color: root.eff_logo == "letter" ? #38bdf8 : AppTheme.border_subtle;

                                TouchArea {
