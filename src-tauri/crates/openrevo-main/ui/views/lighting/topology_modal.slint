import { AppTheme } from "../../theme.slint";

export component LightingTopologyModal inherits Rectangle {
    in-out property <bool> is_open: false;

    // Override settings (auto / specific value)
    in-out property <bool> override_enabled: false;
    in-out property <string> ov_keyboard: "auto";
    in-out property <string> ov_front_bar: "auto";
    in-out property <string> ov_ambient: "auto";
    in-out property <string> ov_logo: "auto";

    // Hardware detected baseline truth
    in property <string> base_keyboard: "per_key";
    in property <string> base_front_bar: "present";
    in property <string> base_ambient: "none";
    in property <string> base_logo: "shield";

    callback close();
    callback apply_topology(string, string, string, string);
    callback reset_topology();

    // Effective active option calculations
    property <string> eff_kb: (ov_keyboard == "auto" || ov_keyboard == "") ? base_keyboard : ov_keyboard;
    property <string> eff_front: (ov_front_bar == "auto" || ov_front_bar == "") ? base_front_bar : ov_front_bar;
    property <string> eff_amb: (ov_ambient == "auto" || ov_ambient == "") ? base_ambient : ov_ambient;
    property <string> eff_logo: (ov_logo == "auto" || ov_logo == "") ? base_logo : ov_logo;

    // Difference counter vs baseline
    property <int> diff_count: (ov_keyboard != "auto" && ov_keyboard != base_keyboard ? 1 : 0) +
                               (ov_front_bar != "auto" && ov_front_bar != base_front_bar ? 1 : 0) +
                               (ov_ambient != "auto" && ov_ambient != base_ambient ? 1 : 0) +
                               (ov_logo != "auto" && ov_logo != base_logo ? 1 : 0);

    // Interactive Hover Preview Item
    property <string> hovered_id: "";
    property <string> active_preview_id: hovered_id != "" ? hovered_id : ("kb:" + eff_kb);

    pure function get_preview_title(id: string) -> string {
        if id == "kb:per_key" { return "全彩逐键 RGB"; }
        if id == "kb:four_zone" { return "4区 RGB 硬件分段"; }
        if id == "kb:single_zone" { return "单区 RGB (整盘同色)"; }
        if id == "kb:single_white" { return "单色白光背光"; }
        if id == "kb:none" { return "无键盘背光"; }

        if id == "lb:present" { return "前唇海岸流光灯条"; }
        if id == "lb:none" { return "无前海岸灯"; }

        if id == "amb:vent" { return "尾部排气格栅氛围灯"; }
        if id == "amb:shoulder" { return "八字双飞翼肩灯"; }
        if id == "amb:none" { return "无额外氛围灯"; }

        if id == "logo:letter" { return "英文字母透光 LOGO"; }
        if id == "logo:shield" { return "盾形螺母发光标"; }
        if id == "logo:none" { return "无 A面 LOGO 背光"; }
        return "硬件规格预览";
    }

    pure function get_preview_chip(id: string) -> string {
        if id == "kb:per_key" { return "048D:600B / CE00"; }
        if id == "kb:four_zone" { return "048D:CE00"; }
        if id == "kb:single_zone" { return "EC RAM PWM"; }
        if id == "kb:single_white" { return "EC 白光背光"; }
        if id == "kb:none" { return "Disabled"; }

        if id == "lb:present" { return "048D:7001 / EC"; }
        if id == "lb:none" { return "None"; }

        if id == "amb:vent" { return "048D:7000 / Hinge"; }
        if id == "amb:shoulder" { return "IDZ Sync"; }
        if id == "amb:none" { return "None"; }

        if id == "logo:letter" { return "USB NewLogo (35)"; }
        if id == "logo:shield" { return "主板 EC 灯效"; }
        if id == "logo:none" { return "None"; }
        return "Standard";
    }

    pure function get_preview_desc(id: string) -> string {
        if id == "kb:per_key" { return "每个按键独立设色，支持 BetterRGB 60FPS 极客流光、水波涟漪与自定义着色器。"; }
        if id == "kb:four_zone" { return "键盘横向分为 4 个物理区域独立设色，支持硬件级波浪跑马与呼吸。"; }
        if id == "kb:single_zone" { return "由主板 EC 直驱，全键盘作为一个整体变色，支持单色常亮、呼吸与整体彩虹渐变。"; }
        if id == "kb:single_white" { return "纯白光 LED，支持关 / 弱光 (50%) / 强光 (100%) 三档无频闪梯级调光。"; }
        if id == "kb:none" { return "模具无发光背光，或在软件中彻底隐藏键盘控制卡片。"; }

        if id == "lb:present" { return "位于触摸板正下方前边缘的细长多段流光灯条，支持对撞、跑马与全彩波浪。"; }
        if id == "lb:none" { return "模具前唇物理无发光条，选择此项可彻底移除幽灵海岸灯卡片并停止发包。"; }

        if id == "amb:vent" { return "后出风口左右对称的跑车式排气灯带，水冷模具经典硬核视觉标识。"; }
        if id == "amb:shoulder" { return "C面键盘左右上方呈“八”字斜向展开的跑马飞翼双灯条，与键盘同频律动。"; }
        if id == "amb:none" { return "普通机型无后排出风口灯或肩灯，控制台中不挂载氛围灯控制卡片。"; }

        if id == "logo:letter" { return "整串 MECHREVO 英文全拼透光发光，由独立 USB 芯片驱动，支持彩色波浪与跑马流光。"; }
        if id == "logo:shield" { return "上下两瓣组成的盾形/螺母发光标，由主板 EC 直驱，支持单色常亮、呼吸与三色混光。"; }
        if id == "logo:none" { return "A面仅为金属贴牌、高光印字或不发光，移除 A 面灯效卡片避免误操作。"; }
        return "请将鼠标悬停在上方任意选项查看对应协议说明";
    }

    pure function get_preview_example(id: string) -> string {
        if id == "kb:per_key" { return "典型机型: 耀世16 Pro/Ultra, 苍龙16, 蛟龙 GM7ZG7S(CE00) 等高配"; }
        if id == "kb:four_zone" { return "典型机型: 蛟龙16, X10 Pro, 极光早期版"; }
        if id == "kb:single_zone" { return "典型机型: 极光X, 耀世15单区版, 旷世G16"; }
        if id == "kb:single_white" { return "典型机型: 无界14X, 无界15X 等轻薄本"; }
        if id == "kb:none" { return "典型机型: 无发光背光通用模具"; }

        if id == "lb:present" { return "典型机型: 耀世16, 蛟龙16 等前唇灯机型"; }
        if id == "lb:none" { return "典型机型: 极光全系, 旷世普通版"; }

        if id == "amb:vent" { return "典型机型: 旷世16 Super 水冷版等旗舰"; }
        if id == "amb:shoulder" { return "典型机型: 深海幽灵 IDZ 模具系列"; }
        if id == "amb:none" { return "典型机型: 绝大多数无额外氛围灯机型"; }

        if id == "logo:letter" { return "典型机型: GM6IX0B, 耀世早期特殊版"; }
        if id == "logo:shield" { return "典型机型: 苍龙, 耀世全系列, 极光X, 蛟龙"; }
        if id == "logo:none" { return "典型机型: 无界轻薄本全系列"; }
        return "";
    }

    background: #000000c8;

    // Prevent background click-through
    TouchArea { }

    Rectangle {
        width: Math.min(parent.width - 32px, 830px);
        height: Math.min(parent.height - 24px, 530px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: AppTheme.is_light ? #ffffff : #0c121ee8;
        border-radius: 14px;
        border-width: 1px;
        border-color: #38bdf838;
        clip: true;

        VerticalLayout {
            // 1. Header
            Rectangle {
                height: 56px;
                background: AppTheme.is_light ? #f8fafc : #111a2ce0;

                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 12px;
                        alignment: center;

                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 8px;
                            background: #0284c725;
                            border-width: 1px;
                            border-color: #0284c755;
                            y: (parent.height - self.height) / 2;

                            Image {
                                source: @image-url("../../assets/icons/cpu.svg");
                                width: 17px;
                                height: 17px;
                                colorize: #38bdf8;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;

                                Text {
                                    text: "灯效硬件设备拓扑纠偏";
                                    font-size: 14px;
                                    font-weight: 700;
                                    color: AppTheme.text_primary;
                                    vertical-alignment: center;
                                }

                                Rectangle {
                                    height: 18px;
                                    border-radius: 4px;
                                    background: #0284c718;
                                    border-width: 1px;
                                    border-color: #38bdf866;
                                    y: (parent.height - self.height) / 2;

                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        Text {
                                            text: "超薄自适应";
                                            font-size: 10px;
                                            font-weight: 600;
                                            color: #38bdf8;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            Text {
                                text: "若自动检测与物理硬件不符，请在此手动指定物理设备。鼠标悬停在选项或 ⓘ 上可查看硬件协议与适用机型。";
                                font-size: 11px;
                                color: AppTheme.text_muted;
                            }
                        }
                    }

                    // Close Button
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 14px;
                        background: AppTheme.surface_pill;
                        y: (parent.height - self.height) / 2;

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.close(); }
                        }

                        Image {
                            source: @image-url("../../assets/icons/x.svg");
                            width: 14px;
                            height: 14px;
                            colorize: AppTheme.text_muted;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: AppTheme.border_subtle; }

            // 2. Body Settings: 4 维度拓扑卡片
            VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 14px;
                padding-bottom: 10px;
                spacing: 12px;

                // Row 1: 键盘背光硬件
                Rectangle {
                    height: 58px;
                    border-radius: 8px;
                    background: AppTheme.is_light ? #f8fafc : #11182745;
                    border-width: 1px;
                    border-color: AppTheme.border_subtle;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        alignment: space-between;

                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;
                            min-width: 160px;

                            Text {
                                text: "⌨️ 1. 键盘背光硬件";
                                font-size: 12px;
                                font-weight: 700;
                                color: AppTheme.text_primary;
                            }
                            HorizontalLayout {
                                spacing: 4px;
                                Text {
                                    text: "自动探测: ";
                                    font-size: 11px;
                                    color: AppTheme.text_muted;
                                }
                                Text {
                                    text: root.base_keyboard;
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: #38bdf8;
                                }
                            }
                        }

                        // Radio Pills
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: center;

                            // 全彩逐键
                            Rectangle {
                                height: 30px;
                                border-radius: 15px;
                                background: root.eff_kb == "per_key" ? #0284c728 : AppTheme.surface_pill;
                                border-width: 1px;
                                border-color: root.eff_kb == "per_key" ? #38bdf8 : AppTheme.border_subtle;

                                TouchArea {
                                    mouse-cursor: pointer;
                                    pointer-event(event) => {
                                        if event.kind == PointerEventKind.move { root.hovered_id = "kb:per_key"; }
                                    }
                                    clicked => { root.ov_keyboard = "per_key"; }
                                }

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 6px;
                                    alignment: center;

                                    Rectangle {
                                        width: 8px;
                                        height: 8px;
                                        border-radius: 4px;
                                        background: root.eff_kb == "per_key" ? #38bdf8 : transparent;
                                        border-width: 1.5px;
                                        border-color: root.eff_kb == "per_key" ? #38bdf8 : #64748b;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: "全彩逐键 RGB";
                                        font-size: 11px;
                                        font-weight: root.eff_kb == "per_key" ? 700 : 500;
                                        color: root.eff_kb == "per_key" ? #ffffff : AppTheme.text_secondary;
                                        vertical-alignment: center;
                                    }
                                    if root.base_keyboard == "per_key": Rectangle {
                                        height: 15px;
                                        border-radius: 3px;
                                        background: #0284c725;
                                        border-width: 1px;
                                        border-color: #38bdf877;
                                        y: (parent.height - self.height) / 2;
                                        HorizontalLayout { padding-left: 4px; padding-right: 4px; Text { text: "自动"; font-size: 9px; font-weight: 700; color: #38bdf8; vertical-alignment: center; } }
                                    }
                                    Text { text: "ⓘ"; font-size: 11px; color: #64748b; vertical-alignment: center; }
                                }
                            }

                            // 4区 RGB
                            Rectangle {
                                height: 30px;
                                border-radius: 15px;
                                background: root.eff_kb == "four_zone" ? #0284c728 : AppTheme.surface_pill;
                                border-width: 1px;
                                border-color: root.eff_kb == "four_zone" ? #38bdf8 : AppTheme.border_subtle;

                                TouchArea {
                                    mouse-cursor: pointer;
                                    pointer-event(event) => {
                                        if event.kind == PointerEventKind.move { root.hovered_id = "kb:four_zone"; }
                                    }
                                    clicked => { root.ov_keyboard = "four_zone"; }
                                }

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 6px;
                                    alignment: center;

                                    Rectangle {
                                        width: 8px;
                                        height: 8px;
                                        border-radius: 4px;
                                        background: root.eff_kb == "four_zone" ? #38bdf8 : transparent;
                                        border-width: 1.5px;
                                        border-color: root.eff_kb == "four_zone" ? #38bdf8 : #64748b;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: "4区 RGB";
                                        font-size: 11px;
                                        font-weight: root.eff_kb == "four_zone" ? 700 : 500;
                                        color: root.eff_kb == "four_zone" ? #ffffff : AppTheme.text_secondary;
                                        vertical-alignment: center;
                                    }
                                    if root.base_keyboard == "four_zone": Rectangle {
                                        height: 15px;
                                        border-radius: 3px;
                                        background: #0284c725;
                                        border-width: 1px;
                                        border-color: #38bdf877;
                                        y: (parent.height - self.height) / 2;
                                        HorizontalLayout { padding-left: 4px; padding-right: 4px; Text { text: "自动"; font-size: 9px; font-weight: 700; color: #38bdf8; vertical-alignment: center; } }
                                    }
                                    Text { text: "ⓘ"; font-size: 11px; color: #64748b; vertical-alignment: center; }
                                }
                            }

                            // 单区 RGB
                            Rectangle {
                                height: 30px;
                                border-radius: 15px;
                                background: root.eff_kb == "single_zone" ? #0284c728 : AppTheme.surface_pill;
                                border-width: 1px;
                                border-color: root.eff_kb == "single_zone" ? #38bdf8 : AppTheme.border_subtle;

                                TouchArea {
                                    mouse-cursor: pointer;
                                    pointer-event(event) => {
                                        if event.kind == PointerEventKind.move { root.hovered_id = "kb:single_zone"; }
                                    }
                                    clicked => { root.ov_keyboard = "single_zone"; }
                                }

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 6px;
                                    alignment: center;

                                    Rectangle {
                                        width: 8px;
                                        height: 8px;
                                        border-radius: 4px;
                                        background: root.eff_kb == "single_zone" ? #38bdf8 : transparent;
                                        border-width: 1.5px;
                                        border-color: root.eff_kb == "single_zone" ? #38bdf8 : #64748b;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: "单区 RGB";
                                        font-size: 11px;
                                        font-weight: root.eff_kb == "single_zone" ? 700 : 500;
                                        color: root.eff_kb == "single_zone" ? #ffffff : AppTheme.text_secondary;
                                        vertical-alignment: center;
                                    }
                                    if root.base_keyboard == "single_zone": Rectangle {
                                        height: 15px;
                                        border-radius: 3px;
                                        background: #0284c725;
                                        border-width: 1px;
                                        border-color: #38bdf877;
                                        y: (parent.height - self.height) / 2;
                                        HorizontalLayout { padding-left: 4px; padding-right: 4px; Text { text: "自动"; font-size: 9px; font-weight: 700; color: #38bdf8; vertical-alignment: center; } }
                                    }
                                    Text { text: "ⓘ"; font-size: 11px; color: #64748b; vertical-alignment: center; }
                                }
                            }

                            // 单色白光
                            Rectangle {
                                height: 30px;
                                border-radius: 15px;
                                background: root.eff_kb == "single_white" ? #0284c728 : AppTheme.surface_pill;
                                border-width: 1px;
                                border-color: root.eff_kb == "single_white" ? #38bdf8 : AppTheme.border_subtle;

                                TouchArea {
                                    mouse-cursor: pointer;
                                    pointer-event(event) => {
                                        if event.kind == PointerEventKind.move { root.hovered_id = "kb:single_white"; }
                                    }
                                    clicked => { root.ov_keyboard = "single_white"; }
                                }

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 6px;
                                    alignment: center;

                                    Rectangle {
                                        width: 8px;
                                        height: 8px;
                                        border-radius: 4px;
                                        background: root.eff_kb == "single_white" ? #38bdf8 : transparent;
                                        border-width: 1.5px;
                                        border-color: root.eff_kb == "single_white" ? #38bdf8 : #64748b;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: "单色白光";
                                        font-size: 11px;
                                        font-weight: root.eff_kb == "single_white" ? 700 : 500;
                                        color: root.eff_kb == "single_white" ? #ffffff : AppTheme.text_secondary;
                                        vertical-alignment: center;
                                    }
                                    if root.base_keyboard == "single_white": Rectangle {
                                        height: 15px;
                                        border-radius: 3px;
                                        background: #0284c725;
                                        border-width: 1px;
                                        border-color: #38bdf877;
                                        y: (parent.height - self.height) / 2;
                                        HorizontalLayout { padding-left: 4px; padding-right: 4px; Text { text: "自动"; font-size: 9px; font-weight: 700; color: #38bdf8; vertical-alignment: center; } }
                                    }
                                    Text { text: "ⓘ"; font-size: 11px; color: #64748b; vertical-alignment: center; }
                                }
                            }

                            // 无背光/禁用
                            Rectangle {
                                height: 30px;
                                border-radius: 15px;
                                background: root.eff_kb == "none" ? #0284c728 : AppTheme.surface_pill;
                                border-width: 1px;
                                border-color: root.eff_kb == "none" ? #38bdf8 : AppTheme.border_subtle;

                                TouchArea {
                                    mouse-cursor: pointer;
                                    pointer-event(event) => {
                                        if event.kind == PointerEventKind.move { root.hovered_id = "kb:none"; }
                                    }
                                    clicked => { root.ov_keyboard = "none"; }
                                }

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 6px;
                                    alignment: center;

                                    Rectangle {
                                        width: 8px;
                                        height: 8px;
                                        border-radius: 4px;
                                        background: root.eff_kb == "none" ? #38bdf8 : transparent;
                                        border-width: 1.5px;
                                        border-color: root.eff_kb == "none" ? #38bdf8 : #64748b;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: "无背光/禁用";
                                        font-size: 11px;
                                        font-weight: root.eff_kb == "none" ? 700 : 500;
                                        color: root.eff_kb == "none" ? #ffffff : AppTheme.text_secondary;
                                        vertical-alignment: center;
                                    }
                                    if root.base_keyboard == "none": Rectangle {
                                        height: 15px;
                                        border-radius: 3px;
                                        background: #0284c725;
                                        border-width: 1px;
                                        border-color: #38bdf877;
                                        y: (parent.height - self.height) / 2;
                                        HorizontalLayout { padding-left: 4px; padding-right: 4px; Text { text: "自动"; font-size: 9px; font-weight: 700; color: #38bdf8; vertical-alignment: center; } }
                                    }
                                    Text { text: "ⓘ"; font-size: 11px; color: #64748b; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                }

                // Row 2: 前置海岸灯条
                Rectangle {
                    height: 58px;
                    border-radius: 8px;
                    background: AppTheme.is_light ? #f8fafc : #11182745;
                    border-width: 1px;
                    border-color: AppTheme.border_subtle;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        alignment: space-between;

                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;
                            min-width: 160px;

                            Text {
                                text: "🌊 2. 前置海岸灯条";
                                font-size: 12px;
                                font-weight: 700;
                                color: AppTheme.text_primary;
                            }
                            HorizontalLayout {
                                spacing: 4px;
                                Text {
                                    text: "自动探测: ";
                                    font-size: 11px;
                                    color: AppTheme.text_muted;
                                }
                                Text {
                                    text: root.base_front_bar == "present" ? "具备灯条" : "未检测到";
                                    font-size: 11px;
                                    font-weight: 600;
