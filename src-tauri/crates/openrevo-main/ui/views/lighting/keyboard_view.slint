import { AppTheme } from "../../theme.slint";
import { ColorPaletteRow } from "color_palette.slint";
import { KeyboardEngineBar } from "keyboard_engine_bar.slint";
import { KeyboardEffectsGrid } from "keyboard_effects_grid.slint";
import { KeyboardControlsBar } from "keyboard_controls_bar.slint";

export component KeyboardLightingView inherits Rectangle {
    in-out property <bool> kb_enabled: true;
    in-out property <int> kb_engine: 1; // 0: hardware, 1: streamer, 2: custom
    in-out property <int> kb_fps: 30; // 15, 30, 45, 60
    in-out property <int> kb_effect: 101; // effect id (101: Wave, etc.)
    in-out property <int> kb_direction: 0; // 0: Right, 1: Left, 2: Up, 3: Down
    in-out property <int> kb_brightness: 3; // 0..4
    in-out property <int> kb_speed: 2; // 0..4
    in-out property <string> kb_color_hex: "#6366F1";
    in-out property <color> kb_color: #6366f1;

    // Custom BRFX Script properties
    in-out property <int> custom_script_idx: 0; // 0: 龟派气功, 1: 万象莲花, 2: 奇点黑洞, 3: 像素跑马灯
    in-out property <int> custom_scale: 100; // 50..200 (%)
    in-out property <bool> custom_reactive: false;

    in property <string> hw_desc: "ITE 8291 原生 RGB 控制器 (21633 固件 1610)";
    in property <bool> is_four_zone: false;
    in property <bool> is_single_zone: false;

    callback toggle_enabled();
    callback select_engine(int);
    callback select_fps(int);
    callback select_effect(int);
    callback select_direction(int);
    callback change_brightness(int);
    callback change_speed(int);
    callback change_color(string, color);

    callback select_custom_script(int);
    callback toggle_custom_reactive();
    callback change_custom_scale(int);

    border-radius: AppTheme.radius_md;
    background: AppTheme.surface_card;
    border-width: 1px;
    border-color: AppTheme.border_subtle;

    VerticalLayout {
        padding: 18px;
        spacing: 16px;
        alignment: start; // Crucial: prevent vertical scattering!

        // 1. Header Banner & Main Power Switch
        HorizontalLayout {
            alignment: space-between;

            VerticalLayout {
                spacing: 3px;
                alignment: center;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: "键盘背光工作台";
                        font-size: 14px;
                        font-weight: 700;
                        color: AppTheme.text_primary;
                        vertical-alignment: center;
                    }

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 20px;
                            border-radius: AppTheme.radius_xs;
                            background: #6366f120;
                            border-width: 1px;
                            border-color: #6366f150;

                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                Text {
                                    text: root.hw_desc;
                                    font-size: 10px;
                                    font-weight: 600;
                                    color: #818cf8;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                Text {
                    text: "12 种硬件内建与动态特效，支持方向、亮度与色态毫秒级原生生效";
                    font-size: 11px;
                    color: AppTheme.text_muted;
                }
            }

            // Big Power Switch
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 92px;
                    height: 32px;
                    border-radius: AppTheme.radius_sm;
                    background: root.kb_enabled ? #6366f1 : AppTheme.surface_pill;
                    border-width: 1px;
                    border-color: root.kb_enabled ? #818cf8 : AppTheme.border_medium;

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.toggle_enabled(); }
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../../assets/icons/power.svg");
                                width: 14px;
                                height: 14px;
                                colorize: root.kb_enabled ? #ffffff : AppTheme.text_muted;
                            }
                        }

                        Text {
                            text: root.kb_enabled ? "已开启" : "已关闭";
                            font-size: 12px;
                            font-weight: 700;
                            color: root.kb_enabled ? #ffffff : AppTheme.text_muted;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // 2. Engine & FPS Bar
        KeyboardEngineBar {
            kb_engine <=> root.kb_engine;
            kb_fps <=> root.kb_fps;
            select_engine(eng) => { root.select_engine(eng); }
            select_fps(fps) => { root.select_fps(fps); }
        }

        // 3. Effects Grid / Custom BRFX Studio Panel
        KeyboardEffectsGrid {
            kb_engine <=> root.kb_engine;
            kb_effect <=> root.kb_effect;
            custom_script_idx <=> root.custom_script_idx;
            custom_reactive <=> root.custom_reactive;
            select_effect(eff) => { root.select_effect(eff); }
            select_custom_script(idx) => { root.select_custom_script(idx); }
            toggle_custom_reactive() => { root.toggle_custom_reactive(); }
        }

        // 4. Direction & Sliders Row
        KeyboardControlsBar {
            kb_direction <=> root.kb_direction;
            kb_brightness <=> root.kb_brightness;
            kb_speed <=> root.kb_speed;
            select_direction(dir) => { root.select_direction(dir); }
            change_brightness(b) => { root.change_brightness(b); }
            change_speed(s) => { root.change_speed(s); }
        }

        // 5. Color Palette Row
        ColorPaletteRow {
            active_color_hex <=> root.kb_color_hex;
            active_color <=> root.kb_color;
            color_selected(hex, c) => {
                root.change_color(hex, c);
            }
        }
    }
}
