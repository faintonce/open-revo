import { AppTheme } from "../../theme.slint";
import { ColorPaletteRow } from "color_palette.slint";

export component AmbientLightingView inherits Rectangle {
    in-out property <bool> hinge_enabled: true;
    in-out property <int> hinge_effect: 1; // 1: Static, 2: Breath, 20: Rainbow Breath, 3: Wave, 4: Collision, 6: Meteor, 9: Marquee, 10: Sparkle
    in-out property <int> hinge_brightness: 3; // 0..4
    in-out property <int> hinge_speed: 2; // 0..4
    in-out property <string> hinge_color_hex: "#00FFFF";
    in-out property <color> hinge_color: #00ffff;

    in property <string> hw_desc: "转轴氛围流光硬件";

    callback toggle_enabled();
    callback select_effect(int);
    callback change_brightness(int);
    callback change_speed(int);
    callback change_color(string, color);

    border-radius: AppTheme.radius_md;
    background: AppTheme.surface_card;
    border-width: 1px;
    border-color: AppTheme.border_subtle;

    VerticalLayout {
        padding: 18px;
        spacing: 16px;
        alignment: start;

        // 1. Header Banner & Main Power Switch
        HorizontalLayout {
            alignment: space-between;

            VerticalLayout {
                spacing: 3px;
                alignment: center;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: "机身尾部氛围灯";
                        font-size: 14px;
                        font-weight: 700;
                        color: AppTheme.text_primary;
                        vertical-alignment: center;
                    }

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 20px;
                            border-radius: AppTheme.radius_xs;
                            background: #06b6d420;
                            border-width: 1px;
                            border-color: #06b6d450;

                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                Text {
                                    text: root.hw_desc;
                                    font-size: 10px;
                                    font-weight: 600;
                                    color: #22d3ee;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                Text {
                    text: "机身尾部双出风口与转轴氛围流光灯，支持双模波浪、律动呼吸与极速流星";
                    font-size: 11px;
                    color: AppTheme.text_muted;
                }
            }

            // Power Switch
            VerticalLayout {
                alignment: center;

                Rectangle {
                    width: 92px;
                    height: 32px;
                    border-radius: AppTheme.radius_sm;
                    background: root.hinge_enabled ? #06b6d4 : AppTheme.surface_pill;
                    border-width: 1px;
                    border-color: root.hinge_enabled ? #22d3ee : AppTheme.border_medium;

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.toggle_enabled(); }
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../../assets/icons/power.svg");
                                width: 14px;
                                height: 14px;
                                colorize: root.hinge_enabled ? #ffffff : AppTheme.text_muted;
                            }
                        }

                        Text {
                            text: root.hinge_enabled ? "已开启" : "已关闭";
                            font-size: 12px;
                            font-weight: 700;
                            color: root.hinge_enabled ? #ffffff : AppTheme.text_muted;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // 2. Modes Grid
        VerticalLayout {
            spacing: 8px;

            Text {
                text: "氛围灯效模式 (Ambient Modes):";
                font-size: 11px;
                font-weight: 700;
                color: AppTheme.text_muted;
            }

            HorizontalLayout {
                spacing: 8px;

                Rectangle {
                    horizontal-stretch: 1;
                    height: 38px;
                    border-radius: AppTheme.radius_xs;
                    background: root.hinge_effect == 1 ? #06b6d425 : AppTheme.surface_pill;
                    border-width: 1px;
                    border-color: root.hinge_effect == 1 ? #06b6d4 : AppTheme.border_subtle;
                    TouchArea { mouse-cursor: pointer; clicked => { root.select_effect(1); } }
                    Text { text: "单色常亮"; font-size: 11px; font-weight: 700; color: root.hinge_effect == 1 ? #22d3ee : AppTheme.text_secondary; horizontal-alignment: center; vertical-alignment: center; }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    height: 38px;
                    border-radius: AppTheme.radius_xs;
                    background: root.hinge_effect == 2 ? #06b6d425 : AppTheme.surface_pill;
                    border-width: 1px;
                    border-color: root.hinge_effect == 2 ? #06b6d4 : AppTheme.border_subtle;
                    TouchArea { mouse-cursor: pointer; clicked => { root.select_effect(2); } }
                    Text { text: "能量呼吸"; font-size: 11px; font-weight: 700; color: root.hinge_effect == 2 ? #22d3ee : AppTheme.text_secondary; horizontal-alignment: center; vertical-alignment: center; }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    height: 38px;
                    border-radius: AppTheme.radius_xs;
                    background: root.hinge_effect == 20 ? #06b6d425 : AppTheme.surface_pill;
                    border-width: 1px;
                    border-color: root.hinge_effect == 20 ? #06b6d4 : AppTheme.border_subtle;
                    TouchArea { mouse-cursor: pointer; clicked => { root.select_effect(20); } }
                    Text { text: "彩虹呼吸"; font-size: 11px; font-weight: 700; color: root.hinge_effect == 20 ? #22d3ee : AppTheme.text_secondary; horizontal-alignment: center; vertical-alignment: center; }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    height: 38px;
                    border-radius: AppTheme.radius_xs;
                    background: root.hinge_effect == 3 ? #06b6d425 : AppTheme.surface_pill;
                    border-width: 1px;
                    border-color: root.hinge_effect == 3 ? #06b6d4 : AppTheme.border_subtle;
                    TouchArea { mouse-cursor: pointer; clicked => { root.select_effect(3); } }
                    Text { text: "全彩波浪"; font-size: 11px; font-weight: 700; color: root.hinge_effect == 3 ? #22d3ee : AppTheme.text_secondary; horizontal-alignment: center; vertical-alignment: center; }
                }
            }

            HorizontalLayout {
                spacing: 8px;

                Rectangle {
                    horizontal-stretch: 1;
                    height: 38px;
                    border-radius: AppTheme.radius_xs;
                    background: root.hinge_effect == 4 ? #06b6d425 : AppTheme.surface_pill;
                    border-width: 1px;
                    border-color: root.hinge_effect == 4 ? #06b6d4 : AppTheme.border_subtle;
                    TouchArea { mouse-cursor: pointer; clicked => { root.select_effect(4); } }
                    Text { text: "动态对撞"; font-size: 11px; font-weight: 700; color: root.hinge_effect == 4 ? #22d3ee : AppTheme.text_secondary; horizontal-alignment: center; vertical-alignment: center; }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    height: 38px;
                    border-radius: AppTheme.radius_xs;
                    background: root.hinge_effect == 6 ? #06b6d425 : AppTheme.surface_pill;
                    border-width: 1px;
                    border-color: root.hinge_effect == 6 ? #06b6d4 : AppTheme.border_subtle;
                    TouchArea { mouse-cursor: pointer; clicked => { root.select_effect(6); } }
                    Text { text: "极速流星"; font-size: 11px; font-weight: 700; color: root.hinge_effect == 6 ? #22d3ee : AppTheme.text_secondary; horizontal-alignment: center; vertical-alignment: center; }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    height: 38px;
                    border-radius: AppTheme.radius_xs;
                    background: root.hinge_effect == 9 ? #06b6d425 : AppTheme.surface_pill;
                    border-width: 1px;
                    border-color: root.hinge_effect == 9 ? #06b6d4 : AppTheme.border_subtle;
                    TouchArea { mouse-cursor: pointer; clicked => { root.select_effect(9); } }
                    Text { text: "跑马流水"; font-size: 11px; font-weight: 700; color: root.hinge_effect == 9 ? #22d3ee : AppTheme.text_secondary; horizontal-alignment: center; vertical-alignment: center; }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    height: 38px;
                    border-radius: AppTheme.radius_xs;
                    background: root.hinge_effect == 10 ? #06b6d425 : AppTheme.surface_pill;
                    border-width: 1px;
                    border-color: root.hinge_effect == 10 ? #06b6d4 : AppTheme.border_subtle;
                    TouchArea { mouse-cursor: pointer; clicked => { root.select_effect(10); } }
                    Text { text: "璀璨闪烁"; font-size: 11px; font-weight: 700; color: root.hinge_effect == 10 ? #22d3ee : AppTheme.text_secondary; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }

        // 3. Sliders Row (56px)
        Rectangle {
            height: 56px;
            background: AppTheme.surface_sunken;
            border-radius: AppTheme.radius_md;
            border-width: 1px;
            border-color: AppTheme.border_subtle;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 24px;

                // Brightness Slider
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 4px;

                    HorizontalLayout {
                        alignment: space-between;
                        HorizontalLayout {
                            spacing: 4px;
                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("../../assets/icons/sun.svg");
                                    width: 12px;
                                    height: 12px;
                                    colorize: #f59e0b;
                                }
                            }
                            Text {
                                text: "氛围灯亮度";
                                font-size: 10px;
                                font-weight: 600;
                                color: AppTheme.text_secondary;
                                vertical-alignment: center;
                            }
                        }
                        Text {
                            text: root.hinge_brightness == 0 ? "关闭 (0)" : (root.hinge_brightness + " 档");
                            font-size: 10px;
                            font-weight: 700;
                            color: #22d3ee;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        height: 16px;
                        background: transparent;

                        Rectangle {
                            x: 0;
                            y: (parent.height - self.height) / 2;
                            width: parent.width;
                            height: 4px;
                            background: AppTheme.surface_pill;
                            border-radius: 2px;

                            Rectangle {
                                x: 0;
                                y: 0;
                                width: Math.max(0px, (root.hinge_brightness / 4.0) * parent.width);
                                height: parent.height;
                                background: #06b6d4;
                                border-radius: 2px;
                            }
                        }

                        Rectangle {
                            x: Math.max(0px, Math.min(parent.width - self.width, (root.hinge_brightness / 4.0) * parent.width - self.width / 2));
                            y: (parent.height - self.height) / 2;
                            width: 12px;
                            height: 12px;
                            border-radius: 6px;
                            background: #ffffff;
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            pointer-event(event) => {
                                if event.kind == PointerEventKind.down {
                                    let ratio = Math.clamp(self.mouse-x / parent.width, 0.0, 1.0);
                                    let val = Math.round(ratio * 4.0);
                                    root.hinge_brightness = val;
                                    root.change_brightness(val);
                                }
                            }
                            moved => {
                                let ratio = Math.clamp(self.mouse-x / parent.width, 0.0, 1.0);
                                let val = Math.round(ratio * 4.0);
                                if val != root.hinge_brightness {
                                    root.hinge_brightness = val;
                                    root.change_brightness(val);
                                }
                            }
                        }
                    }
                }

                // Speed Slider
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 4px;

                    HorizontalLayout {
                        alignment: space-between;
                        HorizontalLayout {
                            spacing: 4px;
                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("../../assets/icons/zap.svg");
                                    width: 12px;
                                    height: 12px;
                                    colorize: #06b6d4;
                                }
                            }
                            Text {
                                text: "流动速度";
                                font-size: 10px;
                                font-weight: 600;
                                color: AppTheme.text_secondary;
                                vertical-alignment: center;
                            }
                        }
                        Text {
                            text: (root.hinge_speed + 1) + " 档";
                            font-size: 10px;
                            font-weight: 700;
                            color: #06b6d4;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        height: 16px;
                        background: transparent;

                        Rectangle {
                            x: 0;
                            y: (parent.height - self.height) / 2;
                            width: parent.width;
                            height: 4px;
                            background: AppTheme.surface_pill;
                            border-radius: 2px;

                            Rectangle {
                                x: 0;
                                y: 0;
                                width: Math.max(0px, (root.hinge_speed / 4.0) * parent.width);
                                height: parent.height;
                                background: #06b6d4;
                                border-radius: 2px;
                            }
                        }

                        Rectangle {
                            x: Math.max(0px, Math.min(parent.width - self.width, (root.hinge_speed / 4.0) * parent.width - self.width / 2));
                            y: (parent.height - self.height) / 2;
                            width: 12px;
                            height: 12px;
                            border-radius: 6px;
                            background: #ffffff;
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            pointer-event(event) => {
                                if event.kind == PointerEventKind.down {
                                    let ratio = Math.clamp(self.mouse-x / parent.width, 0.0, 1.0);
                                    let val = Math.round(ratio * 4.0);
                                    root.hinge_speed = val;
                                    root.change_speed(val);
                                }
                            }
                            moved => {
                                let ratio = Math.clamp(self.mouse-x / parent.width, 0.0, 1.0);
                                let val = Math.round(ratio * 4.0);
                                if val != root.hinge_speed {
                                    root.hinge_speed = val;
                                    root.change_speed(val);
                                }
                            }
                        }
                    }
                }
            }
        }

        // 4. Color Palette
        ColorPaletteRow {
            active_color_hex <=> root.hinge_color_hex;
            active_color <=> root.hinge_color;
            label_text: "氛围主色调:";
            color_selected(hex, c) => {
                root.change_color(hex, c);
            }
        }
    }
}
