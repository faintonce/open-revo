import { LineEdit } from "std-widgets.slint";
import { AppTheme } from "../../theme.slint";
import { ColorPaletteRow } from "color_palette.slint";
import { BrfxScriptItem } from "lighting_types.slint";

export component KeyboardEffectsGrid inherits VerticalLayout {
    in-out property <int> kb_engine: 1; // 0: hardware, 1: streamer, 2: custom
    in-out property <int> kb_effect: 101; // effect id (101: Wave, etc.)
    in property <bool> is_single_zone: false;
    in property <bool> is_four_zone: false;

    // Custom BRFX Studio Properties
    in-out property <[BrfxScriptItem]> custom_scripts: [];
    in-out property <string> custom_script_id: "kamehameha";
    in-out property <string> custom_script_name: "龟派气功 vs 终极闪光 (Kamehameha)";
    in-out property <string> custom_script_file_name: "kamehameha.brfx";
    in-out property <string> custom_script_author: "OpenRevo Community";
    in-out property <string> custom_script_desc: "";
    in-out property <int> custom_speed_x10: 12; // 2..30 -> 0.2x..3.0x
    in-out property <int> custom_scale_pct: 100; // 50..250 -> 50%..250%
    in-out property <int> kb_direction: 0;
    in-out property <bool> custom_reactive: false;
    in-out property <string> kb_color_hex: "#00F0FF";
    in-out property <color> kb_color: #00f0ff;
    in-out property <bool> custom_is_marquee: false;
    in-out property <string> custom_marquee_text: "I LOVE OPEN-REVO";
    in-out property <int> custom_default_speed_x10: 12;
    in-out property <int> custom_default_scale_pct: 100;
    in-out property <int> custom_default_direction: 0;
    in-out property <bool> custom_default_reactive: false;
    in-out property <string> custom_default_color_hex: "#00F0FF";

    callback select_effect(int);
    callback select_custom_script_id(string);
    callback refresh_custom_scripts();
    callback view_custom_script_source(string);
    callback import_custom_script();
    callback export_custom_script(string);
    callback update_custom_tuning(int, int, int, bool, string, string);
    callback reset_custom_tuning();

    spacing: 8px;
    alignment: start; // Crucial: tight packing!

    Text {
        text: root.is_single_zone ? "极客高刷流光动效 (BetterRGB 空间投影算法 - 华丽多变):" : (root.is_four_zone ? "4区原厂硬件灯效 (ITE 8291 r2 固件驱动):" : (root.kb_engine == 0 ? "原厂硬件独立灯效 (内置 MCU 固件算法 - 稳定节能):" : (root.kb_engine == 1 ? "轻量级空间流动矩阵 (BetterRGB 空间投影引擎 - 苹果原彩):" : "定制动效脚本工作室 (外部 .brfx 脚本热重载 & 参数微调):")));
        font-size: 11px;
        font-weight: 700;
        color: AppTheme.text_muted;
    }

    // Single Zone Modes (2 modes: 1: 常亮, 2: 彩虹呼吸循环)
    if root.is_single_zone : HorizontalLayout {
        spacing: 8px;

        // 1: 单色常亮
        Rectangle {
            horizontal-stretch: 1;
            height: 48px;
            border-radius: AppTheme.radius_xs;
            background: root.kb_effect == 1 ? #10b98125 : AppTheme.surface_pill;
            border-width: 1px;
            border-color: root.kb_effect == 1 ? #10b981 : AppTheme.border_subtle;
            TouchArea { mouse-cursor: pointer; clicked => { root.select_effect(1); } }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text { text: "单色常亮"; font-size: 12px; font-weight: 700; color: root.kb_effect == 1 ? #34d399 : AppTheme.text_primary; horizontal-alignment: center; }
                Text { text: "全键盘同色静态照明"; font-size: 10px; color: root.kb_effect == 1 ? #34d399 : AppTheme.text_muted; horizontal-alignment: center; }
            }
        }

        // 2: 彩虹循环
        Rectangle {
            horizontal-stretch: 1;
            height: 48px;
            border-radius: AppTheme.radius_xs;
            background: root.kb_effect == 2 ? #10b98125 : AppTheme.surface_pill;
            border-width: 1px;
            border-color: root.kb_effect == 2 ? #10b981 : AppTheme.border_subtle;
            TouchArea { mouse-cursor: pointer; clicked => { root.select_effect(2); } }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text { text: "彩虹循环"; font-size: 12px; font-weight: 700; color: root.kb_effect == 2 ? #34d399 : AppTheme.text_primary; horizontal-alignment: center; }
                Text { text: "全键盘呼吸渐变循环"; font-size: 10px; color: root.kb_effect == 2 ? #34d399 : AppTheme.text_muted; horizontal-alignment: center; }
            }
        }
    }

    // Four-Zone Modes (6 modes: 1, 2, 3, 5, 12, 13)
    if root.is_four_zone : HorizontalLayout {
        spacing: 8px;

        // 1: 单色常亮
        Rectangle {
            horizontal-stretch: 1;
            height: 42px;
            border-radius: AppTheme.radius_xs;
            background: root.kb_effect == 1 ? #06b6d425 : AppTheme.surface_pill;
            border-width: 1px;
            border-color: root.kb_effect == 1 ? #06b6d4 : AppTheme.border_subtle;
            TouchArea { mouse-cursor: pointer; clicked => { root.select_effect(1); } }
            VerticalLayout {
                alignment: center;
                spacing: 1px;
                Text { text: "单色常亮"; font-size: 11px; font-weight: 700; color: root.kb_effect == 1 ? #22d3ee : AppTheme.text_primary; horizontal-alignment: center; }
                Text { text: "4分区独立配色"; font-size: 9px; color: root.kb_effect == 1 ? #22d3ee : AppTheme.text_muted; horizontal-alignment: center; }
            }
        }

        // 2: 单色呼吸
        Rectangle {
            horizontal-stretch: 1;
            height: 42px;
            border-radius: AppTheme.radius_xs;
            background: root.kb_effect == 2 ? #06b6d425 : AppTheme.surface_pill;
            border-width: 1px;
            border-color: root.kb_effect == 2 ? #06b6d4 : AppTheme.border_subtle;
            TouchArea { mouse-cursor: pointer; clicked => { root.select_effect(2); } }
            VerticalLayout {
                alignment: center;
                spacing: 1px;
                Text { text: "单色呼吸"; font-size: 11px; font-weight: 700; color: root.kb_effect == 2 ? #22d3ee : AppTheme.text_primary; horizontal-alignment: center; }
                Text { text: "平滑律动"; font-size: 9px; color: root.kb_effect == 2 ? #22d3ee : AppTheme.text_muted; horizontal-alignment: center; }
            }
        }

        // 3: 全彩波浪
        Rectangle {
            horizontal-stretch: 1;
            height: 42px;
            border-radius: AppTheme.radius_xs;
            background: root.kb_effect == 3 ? #06b6d425 : AppTheme.surface_pill;
            border-width: 1px;
            border-color: root.kb_effect == 3 ? #06b6d4 : AppTheme.border_subtle;
            TouchArea { mouse-cursor: pointer; clicked => { root.select_effect(3); } }
            VerticalLayout {
                alignment: center;
                spacing: 1px;
                Text { text: "全彩波浪"; font-size: 11px; font-weight: 700; color: root.kb_effect == 3 ? #22d3ee : AppTheme.text_primary; horizontal-alignment: center; }
                Text { text: "流动幻彩波"; font-size: 9px; color: root.kb_effect == 3 ? #22d3ee : AppTheme.text_muted; horizontal-alignment: center; }
            }
        }

        // 5: 彩虹循环
        Rectangle {
            horizontal-stretch: 1;
            height: 42px;
            border-radius: AppTheme.radius_xs;
            background: root.kb_effect == 5 ? #06b6d425 : AppTheme.surface_pill;
            border-width: 1px;
            border-color: root.kb_effect == 5 ? #06b6d4 : AppTheme.border_subtle;
            TouchArea { mouse-cursor: pointer; clicked => { root.select_effect(5); } }
            VerticalLayout {
                alignment: center;
                spacing: 1px;
                Text { text: "彩虹循环"; font-size: 11px; font-weight: 700; color: root.kb_effect == 5 ? #22d3ee : AppTheme.text_primary; horizontal-alignment: center; }
                Text { text: "七彩同步轮播"; font-size: 9px; color: root.kb_effect == 5 ? #22d3ee : AppTheme.text_muted; horizontal-alignment: center; }
            }
        }

        // 12: 闪烁跳变
        Rectangle {
            horizontal-stretch: 1;
            height: 42px;
            border-radius: AppTheme.radius_xs;
            background: root.kb_effect == 12 ? #06b6d425 : AppTheme.surface_pill;
            border-width: 1px;
            border-color: root.kb_effect == 12 ? #06b6d4 : AppTheme.border_subtle;
            TouchArea { mouse-cursor: pointer; clicked => { root.select_effect(12); } }
            VerticalLayout {
                alignment: center;
                spacing: 1px;
                Text { text: "闪烁跳变"; font-size: 11px; font-weight: 700; color: root.kb_effect == 12 ? #22d3ee : AppTheme.text_primary; horizontal-alignment: center; }
                Text { text: "动感跳变"; font-size: 9px; color: root.kb_effect == 12 ? #22d3ee : AppTheme.text_muted; horizontal-alignment: center; }
            }
        }

        // 13: 混合流光
        Rectangle {
            horizontal-stretch: 1;
            height: 42px;
            border-radius: AppTheme.radius_xs;
            background: root.kb_effect == 13 ? #06b6d425 : AppTheme.surface_pill;
            border-width: 1px;
            border-color: root.kb_effect == 13 ? #06b6d4 : AppTheme.border_subtle;
            TouchArea { mouse-cursor: pointer; clicked => { root.select_effect(13); } }
            VerticalLayout {
                alignment: center;
                spacing: 1px;
                Text { text: "混合流光"; font-size: 11px; font-weight: 700; color: root.kb_effect == 13 ? #22d3ee : AppTheme.text_primary; horizontal-alignment: center; }
                Text { text: "多色交替流光"; font-size: 9px; color: root.kb_effect == 13 ? #22d3ee : AppTheme.text_muted; horizontal-alignment: center; }
            }
        }
    }

    // Mode 1: BetterRGB Streamer Grid (14 modes, height: 36px, spacing: 8px)
    if !root.is_single_zone && !root.is_four_zone && root.kb_engine == 1 : VerticalLayout {
        spacing: 8px;
        alignment: start;

        // Row 1: Wave, Breath, Ripple, Quicksand, Current, Wheel, Rainbow
        HorizontalLayout {
            spacing: 8px;

            // 101: 波浪 (Wave)
            Rectangle {
                horizontal-stretch: 1;
                height: 36px;
                border-radius: AppTheme.radius_xs;
                background: root.kb_effect == 101 ? #6366f125 : AppTheme.surface_pill;
                border-width: 1px;
                border-color: root.kb_effect == 101 ? #6366f1 : AppTheme.border_subtle;
                TouchArea { mouse-cursor: pointer; clicked => { root.select_effect(101); } }
                Text { text: "波浪 (Wave)"; font-size: 11px; font-weight: 700; color: root.kb_effect == 101 ? #818cf8 : AppTheme.text_secondary; horizontal-alignment: center; vertical-alignment: center; }
            }

            // 100: 呼吸 (Breath)
            Rectangle {
                horizontal-stretch: 1;
                height: 36px;
                border-radius: AppTheme.radius_xs;
                background: root.kb_effect == 100 ? #6366f125 : AppTheme.surface_pill;
                border-width: 1px;
                border-color: root.kb_effect == 100 ? #6366f1 : AppTheme.border_subtle;
                TouchArea { mouse-cursor: pointer; clicked => { root.select_effect(100); } }
                Text { text: "呼吸 (Breath)"; font-size: 11px; font-weight: 700; color: root.kb_effect == 100 ? #818cf8 : AppTheme.text_secondary; horizontal-alignment: center; vertical-alignment: center; }
            }

            // 102: 涟漪 (Ripple)
            Rectangle {
                horizontal-stretch: 1;
                height: 36px;
                border-radius: AppTheme.radius_xs;
                background: root.kb_effect == 102 ? #6366f125 : AppTheme.surface_pill;
                border-width: 1px;
                border-color: root.kb_effect == 102 ? #6366f1 : AppTheme.border_subtle;
                TouchArea { mouse-cursor: pointer; clicked => { root.select_effect(102); } }
                Text { text: "涟漪 (Ripple)"; font-size: 11px; font-weight: 700; color: root.kb_effect == 102 ? #818cf8 : AppTheme.text_secondary; horizontal-alignment: center; vertical-alignment: center; }
            }

            // 103: 流沙 (Quicksand)
            Rectangle {
                horizontal-stretch: 1;
                height: 36px;
                border-radius: AppTheme.radius_xs;
                background: root.kb_effect == 103 ? #6366f125 : AppTheme.surface_pill;
                border-width: 1px;
                border-color: root.kb_effect == 103 ? #6366f1 : AppTheme.border_subtle;
                TouchArea { mouse-cursor: pointer; clicked => { root.select_effect(103); } }
                Text { text: "流沙 (Quicksand)"; font-size: 11px; font-weight: 700; color: root.kb_effect == 103 ? #818cf8 : AppTheme.text_secondary; horizontal-alignment: center; vertical-alignment: center; }
            }

            // 104: 电流 (Current)
            Rectangle {
                horizontal-stretch: 1;
                height: 36px;
                border-radius: AppTheme.radius_xs;
                background: root.kb_effect == 104 ? #6366f125 : AppTheme.surface_pill;
                border-width: 1px;
                border-color: root.kb_effect == 104 ? #6366f1 : AppTheme.border_subtle;
                TouchArea { mouse-cursor: pointer; clicked => { root.select_effect(104); } }
                Text { text: "电流 (Current)"; font-size: 11px; font-weight: 700; color: root.kb_effect == 104 ? #818cf8 : AppTheme.text_secondary; horizontal-alignment: center; vertical-alignment: center; }
            }

            // 105: 色轮 (Wheel)
            Rectangle {
                horizontal-stretch: 1;
                height: 36px;
                border-radius: AppTheme.radius_xs;
                background: root.kb_effect == 105 ? #6366f125 : AppTheme.surface_pill;
                border-width: 1px;
                border-color: root.kb_effect == 105 ? #6366f1 : AppTheme.border_subtle;
                TouchArea { mouse-cursor: pointer; clicked => { root.select_effect(105); } }
                Text { text: "色轮 (Wheel)"; font-size: 11px; font-weight: 700; color: root.kb_effect == 105 ? #818cf8 : AppTheme.text_secondary; horizontal-alignment: center; vertical-alignment: center; }
            }

            // 106: 彩虹 (Rainbow)
            Rectangle {
                horizontal-stretch: 1;
                height: 36px;
                border-radius: AppTheme.radius_xs;
                background: root.kb_effect == 106 ? #6366f125 : AppTheme.surface_pill;
                border-width: 1px;
                border-color: root.kb_effect == 106 ? #6366f1 : AppTheme.border_subtle;
                TouchArea { mouse-cursor: pointer; clicked => { root.select_effect(106); } }
                Text { text: "彩虹 (Rainbow)"; font-size: 11px; font-weight: 700; color: root.kb_effect == 106 ? #818cf8 : AppTheme.text_secondary; horizontal-alignment: center; vertical-alignment: center; }
            }
        }

        // Row 2: Matrix, Lightning, Flame, Rain, Sparkle, Touch Current, Static
        HorizontalLayout {
            spacing: 8px;

            // 107: 矩阵 (Matrix)
            Rectangle {
                horizontal-stretch: 1;
                height: 36px;
                border-radius: AppTheme.radius_xs;
                background: root.kb_effect == 107 ? #6366f125 : AppTheme.surface_pill;
                border-width: 1px;
                border-color: root.kb_effect == 107 ? #6366f1 : AppTheme.border_subtle;
                TouchArea { mouse-cursor: pointer; clicked => { root.select_effect(107); } }
                Text { text: "矩阵 (Matrix)"; font-size: 11px; font-weight: 700; color: root.kb_effect == 107 ? #818cf8 : AppTheme.text_secondary; horizontal-alignment: center; vertical-alignment: center; }
            }

            // 108: 闪电 (Lightning)
            Rectangle {
                horizontal-stretch: 1;
                height: 36px;
                border-radius: AppTheme.radius_xs;
                background: root.kb_effect == 108 ? #6366f125 : AppTheme.surface_pill;
                border-width: 1px;
                border-color: root.kb_effect == 108 ? #6366f1 : AppTheme.border_subtle;
                TouchArea { mouse-cursor: pointer; clicked => { root.select_effect(108); } }
                Text { text: "闪电 (Lightning)"; font-size: 11px; font-weight: 700; color: root.kb_effect == 108 ? #818cf8 : AppTheme.text_secondary; horizontal-alignment: center; vertical-alignment: center; }
            }

            // 109: 火焰 (Flame)
            Rectangle {
                horizontal-stretch: 1;
                height: 36px;
                border-radius: AppTheme.radius_xs;
                background: root.kb_effect == 109 ? #6366f125 : AppTheme.surface_pill;
                border-width: 1px;
                border-color: root.kb_effect == 109 ? #6366f1 : AppTheme.border_subtle;
                TouchArea { mouse-cursor: pointer; clicked => { root.select_effect(109); } }
                Text { text: "火焰 (Flame)"; font-size: 11px; font-weight: 700; color: root.kb_effect == 109 ? #818cf8 : AppTheme.text_secondary; horizontal-alignment: center; vertical-alignment: center; }
            }

            // 110: 雨滴 (Rain)
            Rectangle {
                horizontal-stretch: 1;
                height: 36px;
                border-radius: AppTheme.radius_xs;
                background: root.kb_effect == 110 ? #6366f125 : AppTheme.surface_pill;
                border-width: 1px;
                border-color: root.kb_effect == 110 ? #6366f1 : AppTheme.border_subtle;
                TouchArea { mouse-cursor: pointer; clicked => { root.select_effect(110); } }
                Text { text: "雨滴 (Rain)"; font-size: 11px; font-weight: 700; color: root.kb_effect == 110 ? #818cf8 : AppTheme.text_secondary; horizontal-alignment: center; vertical-alignment: center; }
            }

            // 111: 星光 (Sparkle)
            Rectangle {
                horizontal-stretch: 1;
                height: 36px;
                border-radius: AppTheme.radius_xs;
                background: root.kb_effect == 111 ? #6366f125 : AppTheme.surface_pill;
                border-width: 1px;
                border-color: root.kb_effect == 111 ? #6366f1 : AppTheme.border_subtle;
                TouchArea { mouse-cursor: pointer; clicked => { root.select_effect(111); } }
                Text { text: "星光 (Sparkle)"; font-size: 11px; font-weight: 700; color: root.kb_effect == 111 ? #818cf8 : AppTheme.text_secondary; horizontal-alignment: center; vertical-alignment: center; }
            }

            // 112: 极光电流
            Rectangle {
                horizontal-stretch: 1;
                height: 36px;
                border-radius: AppTheme.radius_xs;
                background: root.kb_effect == 112 ? #6366f125 : AppTheme.surface_pill;
                border-width: 1px;
                border-color: root.kb_effect == 112 ? #6366f1 : AppTheme.border_subtle;
                TouchArea { mouse-cursor: pointer; clicked => { root.select_effect(112); } }
                Text { text: "极光电流"; font-size: 11px; font-weight: 700; color: root.kb_effect == 112 ? #818cf8 : AppTheme.text_secondary; horizontal-alignment: center; vertical-alignment: center; }
            }

            // 113: 单色极简 (Static)
            Rectangle {
                horizontal-stretch: 1;
                height: 36px;
                border-radius: AppTheme.radius_xs;
                background: root.kb_effect == 113 ? #6366f125 : AppTheme.surface_pill;
                border-width: 1px;
                border-color: root.kb_effect == 113 ? #6366f1 : AppTheme.border_subtle;
                TouchArea { mouse-cursor: pointer; clicked => { root.select_effect(113); } }
                Text { text: "单色极简 (Static)"; font-size: 11px; font-weight: 700; color: root.kb_effect == 113 ? #818cf8 : AppTheme.text_secondary; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
    }

    // Mode 0: Hardware Built-in Grid (11 modes, height: 36px, spacing: 8px)
    if !root.is_single_zone && !root.is_four_zone && root.kb_engine == 0 : VerticalLayout {
        spacing: 8px;
        alignment: start;

        HorizontalLayout {
            spacing: 8px;

            // 1: 单色常亮
            Rectangle {
                horizontal-stretch: 1;
                height: 36px;
                border-radius: AppTheme.radius_xs;
                background: root.kb_effect == 1 ? #10b98125 : AppTheme.surface_pill;
                border-width: 1px;
                border-color: root.kb_effect == 1 ? #10b981 : AppTheme.border_subtle;
                TouchArea { mouse-cursor: pointer; clicked => { root.select_effect(1); } }
                Text { text: "单色常亮"; font-size: 11px; font-weight: 700; color: root.kb_effect == 1 ? #10b981 : AppTheme.text_secondary; horizontal-alignment: center; vertical-alignment: center; }
            }

            // 2: 单色呼吸
            Rectangle {
                horizontal-stretch: 1;
                height: 36px;
                border-radius: AppTheme.radius_xs;
                background: root.kb_effect == 2 ? #10b98125 : AppTheme.surface_pill;
                border-width: 1px;
                border-color: root.kb_effect == 2 ? #10b981 : AppTheme.border_subtle;
                TouchArea { mouse-cursor: pointer; clicked => { root.select_effect(2); } }
                Text { text: "单色呼吸"; font-size: 11px; font-weight: 700; color: root.kb_effect == 2 ? #10b981 : AppTheme.text_secondary; horizontal-alignment: center; vertical-alignment: center; }
            }

            // 3: 波浪流光
            Rectangle {
                horizontal-stretch: 1;
                height: 36px;
                border-radius: AppTheme.radius_xs;
                background: root.kb_effect == 3 ? #10b98125 : AppTheme.surface_pill;
                border-width: 1px;
                border-color: root.kb_effect == 3 ? #10b981 : AppTheme.border_subtle;
                TouchArea { mouse-cursor: pointer; clicked => { root.select_effect(3); } }
                Text { text: "波浪流光"; font-size: 11px; font-weight: 700; color: root.kb_effect == 3 ? #10b981 : AppTheme.text_secondary; horizontal-alignment: center; vertical-alignment: center; }
            }

            // 4: 按键微光
            Rectangle {
                horizontal-stretch: 1;
                height: 36px;
                border-radius: AppTheme.radius_xs;
                background: root.kb_effect == 4 ? #10b98125 : AppTheme.surface_pill;
                border-width: 1px;
                border-color: root.kb_effect == 4 ? #10b981 : AppTheme.border_subtle;
                TouchArea { mouse-cursor: pointer; clicked => { root.select_effect(4); } }
                Text { text: "按键微光"; font-size: 11px; font-weight: 700; color: root.kb_effect == 4 ? #10b981 : AppTheme.text_secondary; horizontal-alignment: center; vertical-alignment: center; }
            }

            // 5: 彩虹相环
            Rectangle {
                horizontal-stretch: 1;
                height: 36px;
                border-radius: AppTheme.radius_xs;
                background: root.kb_effect == 5 ? #10b98125 : AppTheme.surface_pill;
                border-width: 1px;
                border-color: root.kb_effect == 5 ? #10b981 : AppTheme.border_subtle;
                TouchArea { mouse-cursor: pointer; clicked => { root.select_effect(5); } }
                Text { text: "彩虹相环"; font-size: 11px; font-weight: 700; color: root.kb_effect == 5 ? #10b981 : AppTheme.text_secondary; horizontal-alignment: center; vertical-alignment: center; }
            }

            // 6: 涟漪扩散
            Rectangle {
                horizontal-stretch: 1;
                height: 36px;
                border-radius: AppTheme.radius_xs;
                background: root.kb_effect == 6 ? #10b98125 : AppTheme.surface_pill;
                border-width: 1px;
                border-color: root.kb_effect == 6 ? #10b981 : AppTheme.border_subtle;
                TouchArea { mouse-cursor: pointer; clicked => { root.select_effect(6); } }
                Text { text: "涟漪扩散"; font-size: 11px; font-weight: 700; color: root.kb_effect == 6 ? #10b981 : AppTheme.text_secondary; horizontal-alignment: center; vertical-alignment: center; }
            }
        }

        HorizontalLayout {
            spacing: 8px;

            // 10: 随机雨滴
            Rectangle {
                horizontal-stretch: 1;
                height: 36px;
                border-radius: AppTheme.radius_xs;
                background: root.kb_effect == 10 ? #10b98125 : AppTheme.surface_pill;
                border-width: 1px;
                border-color: root.kb_effect == 10 ? #10b981 : AppTheme.border_subtle;
                TouchArea { mouse-cursor: pointer; clicked => { root.select_effect(10); } }
                Text { text: "随机雨滴"; font-size: 11px; font-weight: 700; color: root.kb_effect == 10 ? #10b981 : AppTheme.text_secondary; horizontal-alignment: center; vertical-alignment: center; }
            }

            // 9: 全彩跑马
            Rectangle {
                horizontal-stretch: 1;
                height: 36px;
                border-radius: AppTheme.radius_xs;
                background: root.kb_effect == 9 ? #10b98125 : AppTheme.surface_pill;
                border-width: 1px;
                border-color: root.kb_effect == 9 ? #10b981 : AppTheme.border_subtle;
                TouchArea { mouse-cursor: pointer; clicked => { root.select_effect(9); } }
                Text { text: "全彩跑马"; font-size: 11px; font-weight: 700; color: root.kb_effect == 9 ? #10b981 : AppTheme.text_secondary; horizontal-alignment: center; vertical-alignment: center; }
            }

            // 17: 璀璨烟花
            Rectangle {
                horizontal-stretch: 1;
                height: 36px;
                border-radius: AppTheme.radius_xs;
                background: root.kb_effect == 17 ? #10b98125 : AppTheme.surface_pill;
                border-width: 1px;
                border-color: root.kb_effect == 17 ? #10b981 : AppTheme.border_subtle;
                TouchArea { mouse-cursor: pointer; clicked => { root.select_effect(17); } }
                Text { text: "璀璨烟花"; font-size: 11px; font-weight: 700; color: root.kb_effect == 17 ? #10b981 : AppTheme.text_secondary; horizontal-alignment: center; vertical-alignment: center; }
            }

            // 14: 幽静极光
            Rectangle {
                horizontal-stretch: 1;
                height: 36px;
                border-radius: AppTheme.radius_xs;
                background: root.kb_effect == 14 ? #10b98125 : AppTheme.surface_pill;
                border-width: 1px;
                border-color: root.kb_effect == 14 ? #10b981 : AppTheme.border_subtle;
                TouchArea { mouse-cursor: pointer; clicked => { root.select_effect(14); } }
                Text { text: "幽静极光"; font-size: 11px; font-weight: 700; color: root.kb_effect == 14 ? #10b981 : AppTheme.text_secondary; horizontal-alignment: center; vertical-alignment: center; }
            }

            // 21: 电竞高亮
            Rectangle {
                horizontal-stretch: 1;
                height: 36px;
                border-radius: AppTheme.radius_xs;
                background: root.kb_effect == 21 ? #10b98125 : AppTheme.surface_pill;
                border-width: 1px;
                border-color: root.kb_effect == 21 ? #10b981 : AppTheme.border_subtle;
                TouchArea { mouse-cursor: pointer; clicked => { root.select_effect(21); } }
                Text { text: "电竞高亮"; font-size: 11px; font-weight: 700; color: root.kb_effect == 21 ? #10b981 : AppTheme.text_secondary; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
    }

    // Mode 2: Custom BRFX Studio Panel (Aligned with Tauri BrfxSelectorBar + BrfxTuningPanel)
    if !root.is_single_zone && !root.is_four_zone && root.kb_engine == 2 : VerticalLayout {
        spacing: 10px;
        alignment: start;

        // 1. BrfxSelectorBar
        Rectangle {
            border-radius: AppTheme.radius_md;
            background: AppTheme.surface_sunken;
            border-width: 1px;
            border-color: AppTheme.border_subtle;

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: space-between;

                    // Left: Label + Dropdown
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        horizontal-stretch: 1;

                        Text {
                            text: "动效脚本:";
                            font-size: 11px;
                            font-weight: 600;
                            color: AppTheme.text_muted;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            width: 280px;
                            height: 30px;
                            border-radius: AppTheme.radius_sm;
                            background: AppTheme.surface_pill;
                            border-width: 1px;
                            border-color: script_drop_ta.has-hover ? AppTheme.border_medium : AppTheme.border_subtle;

                            script_drop_ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { script_popup.show(); }
                            }

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                alignment: space-between;

                                Text {
                                    text: root.custom_script_name;
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: AppTheme.text_primary;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("../../assets/icons/chevron-down.svg");
                                        width: 12px;
                                        height: 12px;
                                        colorize: AppTheme.text_muted;
                                    }
                                }
                            }

                            script_popup := PopupWindow {
                                x: 0px;
                                y: 32px;
                                width: 320px;

                                Rectangle {
                                    background: AppTheme.surface_elevated;
                                    border-radius: AppTheme.radius_sm;
                                    border-width: 1px;
                                    border-color: AppTheme.border_medium;
                                    drop-shadow-blur: 10px;
                                    drop-shadow-color: #00000090;

                                    VerticalLayout {
                                        padding: 4px;
                                        spacing: 2px;

                                        for item in root.custom_scripts: Rectangle {
                                            height: 28px;
                                            border-radius: 4px;
                                            background: item.id == root.custom_script_id ? #6366f125 : (opt_ta.has-hover ? AppTheme.surface_pill : transparent);

                                            opt_ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.custom_script_id = item.id;
                                                    root.custom_script_name = item.name;
                                                    root.custom_script_file_name = item.file_name;
                                                    root.custom_script_author = item.author;
                                                    root.custom_script_desc = item.description;
                                                    root.custom_is_marquee = item.is_marquee;
                                                    root.select_custom_script_id(item.id);
                                                }
                                            }

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;
                                                Text {
                                                    text: item.name;
                                                    font-size: 11px;
                                                    font-weight: item.id == root.custom_script_id ? 700 : 500;
                                                    color: item.id == root.custom_script_id ? #818cf8 : AppTheme.text_primary;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Right: Refresh, View Source, Import, Export
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: end;

                        // Refresh
                        Rectangle {
                            height: 30px;
                            border-radius: AppTheme.radius_sm;
                            background: ref_ta.has-hover ? AppTheme.surface_elevated : AppTheme.surface_pill;
                            border-width: 1px;
                            border-color: AppTheme.border_medium;
                            ref_ta := TouchArea { mouse-cursor: pointer; clicked => { root.refresh_custom_scripts(); } }
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 4px;
                                alignment: center;
                                VerticalLayout {
                                    alignment: center;
                                    Image { source: @image-url("../../assets/icons/refresh-cw.svg"); width: 11px; height: 11px; colorize: AppTheme.text_primary; }
                                }
                                Text { text: "刷新"; font-size: 11px; font-weight: 600; color: AppTheme.text_primary; vertical-alignment: center; }
                            }
                        }

                        // View Source (Opens in Notepad for editing)
                        Rectangle {
                            height: 30px;
                            border-radius: AppTheme.radius_sm;
                            background: src_ta.has-hover ? #6366f140 : #6366f125;
                            border-width: 1px;
                            border-color: #6366f180;
                            src_ta := TouchArea { mouse-cursor: pointer; clicked => { root.view_custom_script_source(root.custom_script_file_name); } }
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 4px;
                                alignment: center;
                                VerticalLayout {
                                    alignment: center;
                                    Image { source: @image-url("../../assets/icons/edit.svg"); width: 11px; height: 11px; colorize: #818cf8; }
                                }
                                Text { text: "查看源码"; font-size: 11px; font-weight: 600; color: #818cf8; vertical-alignment: center; }
                            }
                        }

                        // Import & Export Capsule
                        Rectangle {
                            height: 30px;
                            border-radius: AppTheme.radius_sm;
                            background: AppTheme.surface_pill;
                            border-width: 1px;
                            border-color: AppTheme.border_medium;
                            clip: true;

                            HorizontalLayout {
                                spacing: 0px;

                                Rectangle {
                                    background: imp_ta.has-hover ? AppTheme.surface_elevated : transparent;
                                    imp_ta := TouchArea { mouse-cursor: pointer; clicked => { root.import_custom_script(); } }
                                    HorizontalLayout {
                                        padding-left: 9px;
                                        padding-right: 9px;
                                        spacing: 4px;
                                        alignment: center;
                                        VerticalLayout {
                                            alignment: center;
                                            Image { source: @image-url("../../assets/icons/upload.svg"); width: 11px; height: 11px; colorize: AppTheme.text_primary; }
                                        }
                                        Text { text: "导入"; font-size: 11px; font-weight: 600; color: AppTheme.text_primary; vertical-alignment: center; }
                                    }
                                }

                                Rectangle { width: 1px; background: AppTheme.border_subtle; }

                                Rectangle {
                                    background: exp_ta.has-hover ? AppTheme.surface_elevated : transparent;
                                    exp_ta := TouchArea { mouse-cursor: pointer; clicked => { root.export_custom_script(root.custom_script_id); } }
                                    HorizontalLayout {
                                        padding-left: 9px;
                                        padding-right: 9px;
                                        spacing: 4px;
                                        alignment: center;
                                        VerticalLayout {
                                            alignment: center;
                                            Image { source: @image-url("../../assets/icons/download.svg"); width: 11px; height: 11px; colorize: AppTheme.text_primary; }
                                        }
                                        Text { text: "导出"; font-size: 11px; font-weight: 600; color: AppTheme.text_primary; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                    }
                }

                // Description & Author
                if root.custom_script_desc != "" : Text {
                    text: root.custom_script_desc + (root.custom_script_author != "" ? ("  by " + root.custom_script_author) : "");
                    font-size: 11px;
                    color: AppTheme.text_muted;
                    wrap: word-wrap;
                }
            }
        }

        // 2. BrfxTuningPanel
        tuning_panel := Rectangle {
            border-radius: AppTheme.radius_md;
            background: AppTheme.surface_sunken;
            border-width: 1px;
            border-color: AppTheme.border_subtle;

            property <bool> is_modified: root.custom_speed_x10 != root.custom_default_speed_x10
                || root.custom_scale_pct != root.custom_default_scale_pct
                || root.kb_direction != root.custom_default_direction
                || root.custom_reactive != root.custom_default_reactive
                || root.kb_color_hex != root.custom_default_color_hex;

            VerticalLayout {
                padding: 12px;
                spacing: 10px;

                // Header + Reset Default
                HorizontalLayout {
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        VerticalLayout {
                            alignment: center;
                            Image { source: @image-url("../../assets/icons/sliders.svg"); width: 13px; height: 13px; colorize: #818cf8; }
                        }
                        Text {
                            text: "上位通用参数微调 (实时映射物理键盘)";
                            font-size: 12px;
                            font-weight: 700;
                            color: AppTheme.text_primary;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        height: 24px;
                        border-radius: 4px;
                        background: tuning_panel.is_modified ? AppTheme.surface_pill : transparent;
                        border-width: 1px;
                        border-color: tuning_panel.is_modified ? AppTheme.border_medium : transparent;
                        opacity: tuning_panel.is_modified ? 1.0 : 0.4;

                        reset_ta := TouchArea {
                            mouse-cursor: tuning_panel.is_modified ? pointer : default;
                            enabled: tuning_panel.is_modified;
                            clicked => { root.reset_custom_tuning(); }
                        }

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 4px;
                            alignment: center;
                            VerticalLayout {
                                alignment: center;
                                Image { source: @image-url("../../assets/icons/rotate-ccw.svg"); width: 11px; height: 11px; colorize: AppTheme.text_primary; }
                            }
                            Text { text: "恢复默认"; font-size: 11px; font-weight: 600; color: AppTheme.text_primary; vertical-alignment: center; }
                        }
                    }
                }

                // 2-Column Sliders: Speed & Scale
                HorizontalLayout {
                    spacing: 16px;

                    // Speed Slider (0.2x .. 3.0x)
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 4px;

                        HorizontalLayout {
                            alignment: space-between;
                            HorizontalLayout {
                                spacing: 4px;
                                VerticalLayout {
                                    alignment: center;
                                    Image { source: @image-url("../../assets/icons/zap.svg"); width: 11px; height: 11px; colorize: #38bdf8; }
                                }
                                Text { text: "动效流速"; font-size: 11px; font-weight: 600; color: AppTheme.text_muted; vertical-alignment: center; }
                            }
                            Text {
                                text: Math.floor(root.custom_speed_x10 / 10) + "." + Math.mod(root.custom_speed_x10, 10) + "x";
                                font-size: 11px;
                                font-weight: 700;
                                color: #38bdf8;
                                vertical-alignment: center;
                            }
                        }

                        spd_track := Rectangle {
                            height: 16px;
                            background: transparent;
                            Rectangle {
                                x: 0; y: (parent.height - self.height) / 2;
                                width: parent.width; height: 4px;
                                background: AppTheme.surface_pill;
                                border-radius: 2px;
                                Rectangle {
                                    x: 0; y: 0;
                                    width: Math.max(0px, ((root.custom_speed_x10 - 2) / 28.0) * parent.width);
                                    height: parent.height;
                                    background: #38bdf8;
                                    border-radius: 2px;
                                }
                            }
                            Rectangle {
                                x: Math.max(0px, Math.min(parent.width - self.width, ((root.custom_speed_x10 - 2) / 28.0) * parent.width - self.width / 2));
                                y: (parent.height - self.height) / 2;
                                width: 12px; height: 12px; border-radius: 6px; background: #ffffff;
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                pointer-event(event) => {
                                    if event.kind == PointerEventKind.down || (event.kind == PointerEventKind.move && self.pressed) {
                                        let ratio = Math.clamp(self.mouse-x / parent.width, 0.0, 1.0);
                                        let next_val = Math.round(2.0 + ratio * 28.0);
                                        if (next_val != root.custom_speed_x10) {
                                            root.custom_speed_x10 = next_val;
                                            root.update_custom_tuning(next_val, root.custom_scale_pct, root.kb_direction, root.custom_reactive, root.kb_color_hex, root.custom_marquee_text);
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Scale Slider (50% .. 250%)
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 4px;

                        HorizontalLayout {
                            alignment: space-between;
                            HorizontalLayout {
                                spacing: 4px;
                                VerticalLayout {
                                    alignment: center;
                                    Image { source: @image-url("../../assets/icons/maximize2.svg"); width: 11px; height: 11px; colorize: #818cf8; }
                                }
                                Text { text: "空间尺度 / 扩散"; font-size: 11px; font-weight: 600; color: AppTheme.text_muted; vertical-alignment: center; }
                            }
                            Text {
                                text: root.custom_scale_pct + "%";
                                font-size: 11px;
                                font-weight: 700;
                                color: #818cf8;
                                vertical-alignment: center;
                            }
                        }

                        scl_track := Rectangle {
                            height: 16px;
                            background: transparent;
                            Rectangle {
                                x: 0; y: (parent.height - self.height) / 2;
                                width: parent.width; height: 4px;
                                background: AppTheme.surface_pill;
                                border-radius: 2px;
                                Rectangle {
                                    x: 0; y: 0;
                                    width: Math.max(0px, ((root.custom_scale_pct - 50) / 200.0) * parent.width);
                                    height: parent.height;
                                    background: #818cf8;
                                    border-radius: 2px;
                                }
                            }
                            Rectangle {
                                x: Math.max(0px, Math.min(parent.width - self.width, ((root.custom_scale_pct - 50) / 200.0) * parent.width - self.width / 2));
                                y: (parent.height - self.height) / 2;
                                width: 12px; height: 12px; border-radius: 6px; background: #ffffff;
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                pointer-event(event) => {
                                    if event.kind == PointerEventKind.down || (event.kind == PointerEventKind.move && self.pressed) {
                                        let ratio = Math.clamp(self.mouse-x / parent.width, 0.0, 1.0);
                                        let next_val = Math.round(5.0 + ratio * 20.0) * 10;
                                        if (next_val != root.custom_scale_pct) {
                                            root.custom_scale_pct = next_val;
                                            root.update_custom_tuning(root.custom_speed_x10, next_val, root.kb_direction, root.custom_reactive, root.kb_color_hex, root.custom_marquee_text);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Divider
                Rectangle { height: 1px; background: AppTheme.border_subtle; }

                // Direction & Keypress Reaction Row
                HorizontalLayout {
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        Text { text: "流动方向:"; font-size: 11px; font-weight: 600; color: AppTheme.text_muted; vertical-alignment: center; }

                        HorizontalLayout {
                            spacing: 4px;
                            // 0: Right, 1: Left, 2: Up, 3: Down
                            Rectangle {
                                width: 28px; height: 28px; border-radius: 4px;
                                background: root.kb_direction == 0 ? #6366f1 : AppTheme.surface_pill;
                                border-width: 1px;
                                border-color: root.kb_direction == 0 ? #818cf8 : AppTheme.border_subtle;
                                TouchArea { mouse-cursor: pointer; clicked => { root.kb_direction = 0; root.update_custom_tuning(root.custom_speed_x10, root.custom_scale_pct, 0, root.custom_reactive, root.kb_color_hex, root.custom_marquee_text); } }
                                VerticalLayout { alignment: center; Image { source: @image-url("../../assets/icons/arrow-right.svg"); width: 13px; height: 13px; colorize: root.kb_direction == 0 ? #ffffff : AppTheme.text_muted; horizontal-alignment: center; } }
                            }
                            Rectangle {
                                width: 28px; height: 28px; border-radius: 4px;
                                background: root.kb_direction == 1 ? #6366f1 : AppTheme.surface_pill;
                                border-width: 1px;
                                border-color: root.kb_direction == 1 ? #818cf8 : AppTheme.border_subtle;
                                TouchArea { mouse-cursor: pointer; clicked => { root.kb_direction = 1; root.update_custom_tuning(root.custom_speed_x10, root.custom_scale_pct, 1, root.custom_reactive, root.kb_color_hex, root.custom_marquee_text); } }
                                VerticalLayout { alignment: center; Image { source: @image-url("../../assets/icons/arrow-left.svg"); width: 13px; height: 13px; colorize: root.kb_direction == 1 ? #ffffff : AppTheme.text_muted; horizontal-alignment: center; } }
                            }
                            Rectangle {
                                width: 28px; height: 28px; border-radius: 4px;
                                background: root.kb_direction == 2 ? #6366f1 : AppTheme.surface_pill;
                                border-width: 1px;
                                border-color: root.kb_direction == 2 ? #818cf8 : AppTheme.border_subtle;
                                TouchArea { mouse-cursor: pointer; clicked => { root.kb_direction = 2; root.update_custom_tuning(root.custom_speed_x10, root.custom_scale_pct, 2, root.custom_reactive, root.kb_color_hex, root.custom_marquee_text); } }
                                VerticalLayout { alignment: center; Image { source: @image-url("../../assets/icons/arrow-up.svg"); width: 13px; height: 13px; colorize: root.kb_direction == 2 ? #ffffff : AppTheme.text_muted; horizontal-alignment: center; } }
                            }
                            Rectangle {
                                width: 28px; height: 28px; border-radius: 4px;
                                background: root.kb_direction == 3 ? #6366f1 : AppTheme.surface_pill;
                                border-width: 1px;
                                border-color: root.kb_direction == 3 ? #818cf8 : AppTheme.border_subtle;
                                TouchArea { mouse-cursor: pointer; clicked => { root.kb_direction = 3; root.update_custom_tuning(root.custom_speed_x10, root.custom_scale_pct, 3, root.custom_reactive, root.kb_color_hex, root.custom_marquee_text); } }
                                VerticalLayout { alignment: center; Image { source: @image-url("../../assets/icons/arrow-down.svg"); width: 13px; height: 13px; colorize: root.kb_direction == 3 ? #ffffff : AppTheme.text_muted; horizontal-alignment: center; } }
                            }
                        }
                    }

                    // Reactive Toggle
                    Rectangle {
                        height: 28px;
                        border-radius: 4px;
                        background: root.custom_reactive ? #10b98125 : AppTheme.surface_pill;
                        border-width: 1px;
                        border-color: root.custom_reactive ? #10b981 : AppTheme.border_subtle;

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.custom_reactive = !root.custom_reactive;
                                root.update_custom_tuning(root.custom_speed_x10, root.custom_scale_pct, root.kb_direction, root.custom_reactive, root.kb_color_hex, root.custom_marquee_text);
                            }
                        }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 6px;
                            alignment: center;
                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("../../assets/icons/activity.svg");
                                    width: 12px;
                                    height: 12px;
                                    colorize: root.custom_reactive ? #10b981 : AppTheme.text_muted;
                                }
                            }
                            Text {
                                text: root.custom_reactive ? "击键互动: 开启" : "击键互动: 关闭";
                                font-size: 11px;
                                font-weight: 600;
                                color: root.custom_reactive ? #10b981 : AppTheme.text_muted;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Divider
                Rectangle { height: 1px; background: AppTheme.border_subtle; }

                // Color Palette Row
                ColorPaletteRow {
                    active_color_hex <=> root.kb_color_hex;
                    active_color <=> root.kb_color;
                    label_text: "定制主色调:";
                    color_selected(hex, c) => {
                        root.kb_color_hex = hex;
                        root.kb_color = c;
                        root.update_custom_tuning(root.custom_speed_x10, root.custom_scale_pct, root.kb_direction, root.custom_reactive, hex, root.custom_marquee_text);
                    }
                }

                // Optional Marquee Text Input
                if root.custom_is_marquee : VerticalLayout {
                    spacing: 6px;
                    Rectangle { height: 1px; background: AppTheme.border_subtle; }
                    HorizontalLayout {
                        alignment: space-between;
                        Text { text: "滚动弹幕文本 (实时映射物理键盘)"; font-size: 11px; color: AppTheme.text_muted; }
                        Text { text: "支持大写英文、数字与符号"; font-size: 10px; color: AppTheme.text_muted; }
                    }
                    LineEdit {
                        text <=> root.custom_marquee_text;
                        placeholder-text: "输入弹幕文字，例如: I LOVE OPEN-REVO";
                        font-size: 12px;
                        edited(txt) => {
                            root.custom_marquee_text = txt;
                            root.update_custom_tuning(root.custom_speed_x10, root.custom_scale_pct, root.kb_direction, root.custom_reactive, root.kb_color_hex, txt);
                        }
                    }
                }
            }
        }
    }
}

