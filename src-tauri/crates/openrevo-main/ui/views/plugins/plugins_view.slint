import { AppTheme } from "../../theme.slint";

export struct CustomPluginItem {
    id: string,
    name: string,
    version: string,
    author: string,
    description: string,
    plugin_type: string,
    enabled: bool,
    tag: string,
    min_version: string,
    dir_name: string,
}

component PluginSwitch inherits Rectangle {
    in-out property <bool> checked: false;
    callback toggled();

    width: 44px;
    height: 24px;
    border-radius: 12px;
    background: checked ? (AppTheme.is_mono ? #ffffff : #10b981) : AppTheme.surface_pill;
    border-width: 1px;
    border-color: checked ? (AppTheme.is_mono ? #ffffff : #10b981) : AppTheme.border_medium;

    animate background { duration: 150ms; }
    animate border-color { duration: 150ms; }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }

    Rectangle {
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: checked ? (AppTheme.is_mono ? #000000 : #ffffff) : (AppTheme.is_mono ? #777777 : #94a3b8);
        x: checked ? parent.width - 21px : 3px;
        y: 2px;
        animate x { duration: 150ms; easing: ease-out; }
    }
}

component ActionButton inherits Rectangle {
    in-out property <string> text;
    in-out property <image> icon;
    callback clicked();

    height: 30px;
    border-radius: 6px;
    background: touch.has-hover ? AppTheme.surface_card_hover : AppTheme.surface_pill;
    border-width: 1px;
    border-color: touch.has-hover ? AppTheme.border_highlight : AppTheme.border_subtle;

    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 6px;
        alignment: center;

        Image {
            source: root.icon;
            width: 13px;
            height: 13px;
            colorize: touch.has-hover ? AppTheme.text_primary : AppTheme.text_secondary;
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: root.text;
            font-size: 11px;
            font-weight: 600;
            color: touch.has-hover ? AppTheme.text_primary : AppTheme.text_secondary;
            vertical-alignment: center;
        }
    }
}

component BuiltinModuleCard inherits Rectangle {
    in-out property <string> title;
    in-out property <string> tag_id;
    in-out property <string> desc;
    in-out property <image> icon;
    in-out property <bool> enabled: true;
    callback toggled();

    height: 64px;
    border-radius: 8px;
    background: AppTheme.surface_card;
    border-width: 1px;
    border-color: AppTheme.border_subtle;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: 8px;
                background: AppTheme.surface_pill;
                border-width: 1px;
                border-color: AppTheme.border_subtle;

                Image {
                    source: root.icon;
                    width: 18px;
                    height: 18px;
                    colorize: root.enabled ? AppTheme.accent_active : AppTheme.text_muted;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;

            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.title;
                    font-size: 13px;
                    font-weight: 700;
                    color: AppTheme.text_primary;
                    vertical-alignment: center;
                }
                Rectangle {
                    border-radius: 3px;
                    background: AppTheme.surface_pill;
                    height: 18px;
                    y: (parent.height - self.height) / 2;
                    HorizontalLayout {
                        padding-left: 5px;
                        padding-right: 5px;
                        Text {
                            text: "[" + root.tag_id + "]";
                            font-size: 9px;
                            font-weight: 600;
                            color: AppTheme.text_muted;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Text {
                text: root.desc;
                font-size: 11px;
                color: AppTheme.text_secondary;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            PluginSwitch {
                checked: root.enabled;
                toggled => { root.toggled(); }
            }
        }
    }
}

component CustomPluginCard inherits Rectangle {
    in-out property <CustomPluginItem> item;
    callback toggled();

    border-radius: 8px;
    background: AppTheme.surface_card;
    border-width: 1px;
    border-color: AppTheme.border_subtle;

    VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 12px;

            VerticalLayout {
                alignment: start;
                Rectangle {
                    width: 36px;
                    height: 36px;
                    border-radius: 8px;
                    background: AppTheme.surface_pill;
                    border-width: 1px;
                    border-color: AppTheme.border_subtle;

                    Image {
                        source: @image-url("../../assets/icons/layers.svg");
                        width: 18px;
                        height: 18px;
                        colorize: root.item.enabled ? #10b981 : AppTheme.text_muted;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 5px;

                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    Text {
                        text: root.item.name;
                        font-size: 13px;
                        font-weight: 700;
                        color: AppTheme.text_primary;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        border-radius: 3px;
                        background: AppTheme.surface_pill;
                        height: 18px;
                        y: (parent.height - self.height) / 2;
                        HorizontalLayout {
                            padding-left: 4px;
                            padding-right: 4px;
                            Text {
                                text: "[" + root.item.id + "]";
                                font-size: 9px;
                                font-weight: 600;
                                color: AppTheme.text_muted;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle {
                        border-radius: 3px;
                        background: AppTheme.accent_active_bg;
                        border-width: 1px;
                        border-color: AppTheme.accent_active_border;
                        height: 18px;
                        y: (parent.height - self.height) / 2;
                        HorizontalLayout {
                            padding-left: 5px;
                            padding-right: 5px;
                            Text {
                                text: root.item.version;
                                font-size: 9px;
                                font-weight: 700;
                                color: AppTheme.accent_active;
                                vertical-alignment: center;
                            }
                        }
                    }

                    if root.item.tag != "": Rectangle {
                        border-radius: 3px;
                        background: AppTheme.surface_pill;
                        height: 18px;
                        y: (parent.height - self.height) / 2;
                        HorizontalLayout {
                            padding-left: 5px;
                            padding-right: 5px;
                            Text {
                                text: root.item.tag;
                                font-size: 9px;
                                font-weight: 600;
                                color: AppTheme.text_secondary;
                                vertical-alignment: center;
                            }
                        }
                    }

                    if root.item.min_version != "": Rectangle {
                        border-radius: 3px;
                        background: AppTheme.surface_pill;
                        height: 18px;
                        y: (parent.height - self.height) / 2;
                        HorizontalLayout {
                            padding-left: 5px;
                            padding-right: 5px;
                            Text {
                                text: root.item.min_version;
                                font-size: 9px;
                                font-weight: 600;
                                color: AppTheme.text_muted;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                Text {
                    text: root.item.description;
                    font-size: 11px;
                    color: AppTheme.text_secondary;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 12px;
                    Text {
                        text: "Автор: " + root.item.author;
                        font-size: 10px;
                        color: AppTheme.text_muted;
                    }
                    Text {
                        text: "Каталог: " + root.item.dir_name;
                        font-size: 10px;
                        color: AppTheme.text_muted;
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                PluginSwitch {
                    checked: root.item.enabled;
                    toggled => { root.toggled(); }
                }
            }
        }
    }
}

export component DashboardPluginsView inherits Rectangle {
    background: AppTheme.bg_root;

    in-out property <bool> is_overview_enabled: true;
    in-out property <bool> is_gpu_enabled: true;
    in-out property <bool> is_tuning_enabled: true;
    in-out property <bool> is_lighting_enabled: true;
    in-out property <bool> is_water_enabled: true;

    in-out property <[CustomPluginItem]> custom_plugins: [
        {
            id: "battery-hardware-limit",
            name: "Хранитель верхнего порога заряда батареи",
            version: "v2.1.0",
            author: "OpenRevo Official & Community",
            description: "Рекомендованный автором плагин: точная фиксация аппаратного порога заряда батареи через драйвер уровня ядра. Умное переключение режима ухода и безопасного предельного разряда, порог заряда 1–100% против вздутия — без постоянного фонового процесса и потребления в простое.",
            plugin_type: "service",
            enabled: true,
            tag: "Фоновый сторож",
            min_version: "v0.9.4+",
            dir_name: "battery-hardware-limit"
        },
        {
            id: "cpu-guardian",
            name: "Защитник от скрытого снижения частот CPU 13/14 поколения",
            version: "v1.0.0",
            author: "OpenRevo Community",
            description: "Для скрытого снижения частот при высоком напряжении у процессоров Intel 13/14 поколения HX: динамический мониторинг состояния CEP, защита клампингом пиковых токов PL4 и перехват перегрева/перенапряжения с предупреждением.",
            plugin_type: "service",
            enabled: true,
            tag: "Фоновый сторож",
            min_version: "v0.9.4+",
            dir_name: "cpu-guardian"
        }
    ];

    callback toggle_builtin_module(string, bool);
    callback toggle_custom_plugin(string, bool);
    callback open_plugins_dir();
    callback reload_plugins();

    Flickable {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;

        VerticalLayout {
            padding-left: 20px;
            padding-right: 24px;
            padding-top: 14px;
            padding-bottom: 24px;
            spacing: 16px;
            alignment: start;

            // 1. Top Section - Builtin Plugins
            VerticalLayout {
                spacing: 10px;

                HorizontalLayout {
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../../assets/icons/layers.svg");
                                width: 16px;
                                height: 16px;
                                colorize: AppTheme.accent_active;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: "Встроенные плагины";
                                font-size: 13.5px;
                                font-weight: 700;
                                color: AppTheme.text_primary;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                border-radius: 4px;
                                background: AppTheme.accent_active_bg;
                                border-width: 1px;
                                border-color: AppTheme.accent_active_border;
                                height: 20px;
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    Text {
                                        text: "Изоляция на уровне драйвера в Safe-Mode";
                                        font-size: 9.5px;
                                        font-weight: 700;
                                        color: AppTheme.accent_active;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "Всего 5 шт.";
                            font-size: 11px;
                            color: AppTheme.text_muted;
                        }
                    }
                }

                Text {
                    text: "Основные функциональные компоненты системы: включайте и отключайте под конфигурацию вашей модели и предпочтения. Отключённые плагины исчезают из навигации боковой панели и фоновой диспетчеризации";
                    font-size: 11px;
                    color: AppTheme.text_muted;
                }

                // 5 Builtin Cards
                VerticalLayout {
                    spacing: 6px;

                    BuiltinModuleCard {
                        title: "Общий обзор состояния";
                        tag_id: "overview";
                        desc: "Мониторинг датчиков всего устройства в реальном времени, панель переключения режимов и доска здоровья батареи";
                        icon: @image-url("../../assets/icons/grid.svg");
                        enabled: root.is_overview_enabled;
                        toggled => {
                            root.is_overview_enabled = !root.is_overview_enabled;
                            root.toggle_builtin_module("overview", root.is_overview_enabled);
                        }
                    }

                    BuiltinModuleCard {
                        title: "Режим графики";
                        tag_id: "gpu";
                        desc: "Переключение MUX (прямой вывод dGPU / гибридный), динамический разгон, яркость экрана и ICC-калибровка";
                        icon: @image-url("../../assets/icons/monitor.svg");
                        enabled: root.is_gpu_enabled;
                        toggled => {
                            root.is_gpu_enabled = !root.is_gpu_enabled;
                            root.toggle_builtin_module("gpu", root.is_gpu_enabled);
                        }
                    }

                    BuiltinModuleCard {
                        title: "Управление питанием";
                        tag_id: "tuning";
                        desc: "Точная настройка лимитов мощности CPU PL1/PL2/PL4, двухканальные кривые вентиляторов и температурные защитные пороги";
                        icon: @image-url("../../assets/icons/zap.svg");
                        enabled: root.is_tuning_enabled;
                        toggled => {
                            root.is_tuning_enabled = !root.is_tuning_enabled;
                            root.toggle_builtin_module("tuning", root.is_tuning_enabled);
                        }
                    }

                    BuiltinModuleCard {
                        title: "Мастерская RGB";
                        tag_id: "lighting";
                        desc: "4-зонная полноцветная подсветка клавиатуры, хвостовая световая полоса, логотип и пользовательские эффекты перелива";
                        icon: @image-url("../../assets/icons/keyboard.svg");
                        enabled: root.is_lighting_enabled;
                        toggled => {
                            root.is_lighting_enabled = !root.is_lighting_enabled;
                            root.toggle_builtin_module("lighting", root.is_lighting_enabled);
                        }
                    }

                    BuiltinModuleCard {
                        title: "Блок СЖО (BLE)";
                        tag_id: "water";
                        desc: "Bluetooth LE управление СЖО второго поколения, телеметрия температуры воды и умные температурные кривые";
                        icon: @image-url("../../assets/icons/droplet.svg");
                        enabled: root.is_water_enabled;
                        toggled => {
                            root.is_water_enabled = !root.is_water_enabled;
                            root.toggle_builtin_module("water", root.is_water_enabled);
                        }
                    }
                }
            }

            // Divider between Builtin and Custom
            Rectangle {
                height: 1px;
                background: AppTheme.border_subtle;
            }

            // 2. Bottom Section - Custom Plugins
            VerticalLayout {
                spacing: 10px;

                HorizontalLayout {
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../../assets/icons/layers.svg");
                                width: 16px;
                                height: 16px;
                                colorize: #10b981;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: "Пользовательские плагины";
                                font-size: 13.5px;
                                font-weight: 700;
                                color: AppTheme.text_primary;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                border-radius: 4px;
                                background: #10b98118;
                                border-width: 1px;
                                border-color: #10b98140;
                                height: 20px;
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    Text {
                                        text: "Безопасная изоляция в песочнице";
                                        font-size: 9.5px;
                                        font-weight: 700;
                                        color: #10b981;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        ActionButton {
                            text: "Открыть каталог плагинов";
                            icon: @image-url("../../assets/icons/folder.svg");
                            clicked => { root.open_plugins_dir(); }
                        }
                        ActionButton {
                            text: "Обновить";
                            icon: @image-url("../../assets/icons/rotate-ccw.svg");
                            clicked => { root.reload_plugins(); }
                        }
                    }
                }

                Text {
                    text: "Поддержка внешних расширений от сообщества или собственной разработки (плагины уведомлений на рабочем столе, фоновые скрипты, свои панели управления), работающих в безопасной песочнице";
                    font-size: 11px;
                    color: AppTheme.text_muted;
                }

                // Custom Plugin Cards
                VerticalLayout {
                    spacing: 8px;

                    for plugin[idx] in root.custom_plugins: CustomPluginCard {
                        item: plugin;
                        toggled => {
                            root.toggle_custom_plugin(plugin.id, !plugin.enabled);
                        }
                    }

                    if root.custom_plugins.length == 0: Rectangle {
                        height: 90px;
                        border-radius: 8px;
                        background: AppTheme.surface_card;
                        border-width: 1px;
                        border-color: AppTheme.border_subtle;

                        VerticalLayout {
                            alignment: center;
                            spacing: 6px;

                            Text {
                                text: "Активированные пользовательские пакеты расширений пока не обнаружены";
                                font-size: 12px;
                                font-weight: 600;
                                color: AppTheme.text_secondary;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Нажмите «Открыть каталог плагинов» выше, положите плагины и нажмите «Обновить» для загрузки";
                                font-size: 10px;
                                color: AppTheme.text_muted;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}
