                                        vertical-alignment: center;
                                    }
                                }
                                Text {
                                    text: "切断休眠 Wi-Fi，阻止系统后台联网唤醒";
                                    font-size: 8.5px;
                                    color: AppTheme.text_muted;
                                }
                            }

                            SwitchToggle {
