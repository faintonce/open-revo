                            padding-left: 9px;
                            padding-right: 9px;
                            alignment: space-between;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;
                                HorizontalLayout {
                                    spacing: 5px;
                                    Image {
                                        source: @image-url("../../assets/icons/snowflake.svg");
                                        width: 12px;
                                        height: 12px;
                                        colorize: #38bdf8;
                                        y: (parent.height - self.height) / 2;
                                    }
