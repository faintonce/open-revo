                        border-width: 1px;
                        border-color: root.sleep_block_away ? #f43f5e60 : AppTheme.border_subtle;

                        t_p2 := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.toggle_sleep_guard_option("block_away"); }
                        }

                        HorizontalLayout {
                            padding-left: 9px;
                            padding-right: 9px;
                            alignment: space-between;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;
                                HorizontalLayout {
                                    spacing: 5px;
                                    Image {
                                        source: @image-url("../../assets/icons/ban.svg");
                                        width: 12px;
                                        height: 12px;
                                        colorize: #f43f5e;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: "封杀离开模式伪睡眠";
                                        font-size: 10.5px;
                                        font-weight: 700;
                                        color: AppTheme.text_primary;
                                        vertical-alignment: center;
                                    }
                                }
