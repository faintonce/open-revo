import { AppTheme } from "../../theme.slint";

// Reusable animated switch toggle
component SwitchToggle inherits Rectangle {
    in-out property <bool> checked: false;
    in-out property <color> active_color: #10b981;
    callback toggled();

    width: 38px;
    height: 20px;
    horizontal-stretch: 0;
    vertical-stretch: 0;

    border-radius: 10px;
    background: checked ? active_color : AppTheme.surface_pill;
    border-width: 1px;
    border-color: checked ? active_color : AppTheme.border_medium;
    clip: true;

    TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }

    Rectangle {
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: #ffffff;
        x: root.checked ? (root.width - self.width - 3px) : 3px;
        y: (root.height - self.height) / 2;
        animate x { duration: 150ms; easing: ease-out; }
    }
}

export component DashboardPowerView inherits Rectangle {
    background: transparent;

    // Power & Battery State
    in-out property <int> battery_percent: 99;
    in-out property <bool> is_ac_online: true;
    in-out property <string> battery_mode: "station"; // "long_life" | "balance" | "station"
    in-out property <int> battery_limit: 60;          // 100 | 80 | 60

    // Hardware Power Options
    in-out property <bool> usb_charge_enabled: false;
    in-out property <bool> ac_recovery_enabled: false;
    in-out property <bool> high_perf_scheme: true;

    // Modern Standby & Sleep Guard Policies
    in-out property <bool> sleep_guard_enabled: false;
    in-out property <bool> sleep_disconnect_net: false;
    in-out property <bool> sleep_block_away: false;
    in-out property <bool> sleep_ignore_sysreq: false;
    in-out property <bool> sleep_disable_wake_timers: false;
    in-out property <bool> sleep_deep_sleep: false;
    in-out property <bool> sleep_hibernate_30m: false;
    in-out property <bool> sleep_auto_office: false;

    // Callbacks to Host
    callback toggle_sleep_auto_office();
    callback toggle_master_sleep_guard();
    callback toggle_sleep_guard_option(string);
    callback toggle_power_option(string);
    callback select_battery_mode(string);

    VerticalLayout {
        padding: 14px;
        spacing: 10px;
        alignment: start;

        // 1. Top Header Bar with Auto-Office on Sleep/Unplug Switch
        HorizontalLayout {
            alignment: space-between;
            height: 38px;

            HorizontalLayout {
                spacing: 10px;
                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 6px;
                    background: #38bdf818;
                    border-width: 1px;
                    border-color: #38bdf840;
                    y: (parent.height - self.height) / 2;

                    Image {
                        source: @image-url("../../assets/icons/zap.svg");
                        width: 16px;
                        height: 16px;
                        colorize: #38bdf8;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: "电源与电池管理 (Power & Battery Management)";
                        font-size: 13.5px;
                        font-weight: 700;
                        color: AppTheme.text_primary;
                    }
                    Text {
                        text: "主板硬件充放电控制 · 电池健康长寿模式 · 关机反向供电";
                        font-size: 10px;
                        color: AppTheme.text_muted;
                    }
                }
            }

            // Top Right Quick Card: 睡眠时自动进入办公模式
            Rectangle {
                border-radius: 6px;
                background: root.sleep_auto_office ? #38bdf814 : AppTheme.surface_card;
                border-width: 1px;
                border-color: root.sleep_auto_office ? #38bdf860 : AppTheme.border_subtle;
                height: 38px;
                y: (parent.height - self.height) / 2;

                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.toggle_sleep_auto_office(); }
                }

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 12px;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 1px;
                        Text {
                            text: "睡眠时自动进入办公模式";
                            font-size: 11px;
                            font-weight: 700;
                            color: AppTheme.text_primary;
                        }
                        Text {
                            text: "合盖前自动降频限功耗 · 防狂暴模式带热入睡";
                            font-size: 9px;
                            color: AppTheme.text_muted;
                        }
                    }

                    SwitchToggle {
                        checked: root.sleep_auto_office;
                        active_color: #38bdf8;
                        y: (parent.height - self.height) / 2;
                        toggled => { root.toggle_sleep_auto_office(); }
                    }
                }
            }
        }

        // 2. Section 1: 智能睡眠守护 / 背包防烫模式 (Anti-Overheat Sleep Guard)
        Rectangle {
            border-radius: 8px;
            background: #f43f5e08;
            border-width: 1px;
            border-color: root.sleep_guard_enabled ? #f43f5e80 : #f43f5e35;

            VerticalLayout {
                padding: 10px;
                spacing: 8px;

                // Master Banner Bar
                HorizontalLayout {
                    alignment: space-between;
                    height: 32px;

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.toggle_master_sleep_guard(); }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        y: (parent.height - self.height) / 2;

                        Rectangle {
                            width: 26px;
                            height: 26px;
                            border-radius: 5px;
                            background: #f43f5e20;
                            border-width: 1px;
                            border-color: #f43f5e50;

                            Image {
                                source: @image-url("../../assets/icons/shield.svg");
                                width: 14px;
                                height: 14px;
                                colorize: #f43f5e;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;

                            HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    text: "智能睡眠守护 / 背包防烫模式 (Anti-Overheat Sleep Guard)";
                                    font-size: 12px;
                                    font-weight: 800;
                                    color: AppTheme.text_primary;
                                    vertical-alignment: center;
                                }

                                // Badge
                                Rectangle {
                                    border-radius: 3px;
                                    background: #38bdf825;
                                    border-width: 1px;
                                    border-color: #38bdf850;
                                    height: 16px;
                                    y: (parent.height - self.height) / 2;

                                    HorizontalLayout {
                                        padding-left: 5px;
                                        padding-right: 5px;
                                        Text {
                                            text: "推荐全开";
                                            font-size: 9px;
                                            font-weight: 700;
                                            color: #38bdf8;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            Text {
                                text: "封杀 Windows 现代待机后台偷跑；杜绝密闭背包发烫、电池偷耗以及合盖睡死黑屏无法唤醒。";
                                font-size: 9px;
                                color: AppTheme.text_muted;
                            }
                        }
                    }

                    SwitchToggle {
                        checked: root.sleep_guard_enabled;
                        active_color: #f43f5e;
                        y: (parent.height - self.height) / 2;
                        toggled => { root.toggle_master_sleep_guard(); }
                    }
                }

                // Subtle Divider
                Rectangle {
                    height: 1px;
                    background: #f43f5e20;
                }

                // 6 Core Policies (2 Rows x 3 Columns)
                // Row 1
                HorizontalLayout {
                    spacing: 8px;

                    // Policy 1: 待机断开网络
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 48px;
                        border-radius: 6px;
