                HorizontalLayout {
                    spacing: 8px;

                    // Policy 4: 禁用 RTC 唤醒定时器
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 48px;
                        border-radius: 6px;
                        background: t_p4.has-hover ? AppTheme.surface_card_hover : AppTheme.surface_card;
                        border-width: 1px;
                        border-color: root.sleep_disable_wake_timers ? #6366f160 : AppTheme.border_subtle;

                        t_p4 := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.toggle_sleep_guard_option("disable_wake_timers"); }
                        }

                        HorizontalLayout {
                            padding-left: 9px;
                            padding-right: 9px;
                            alignment: space-between;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;
                                HorizontalLayout {
                                    spacing: 5px;
                                    Image {
                                        source: @image-url("../../assets/icons/clock.svg");
                                        width: 12px;
                                        height: 12px;
                                        colorize: #818cf8;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: "禁用 RTC 唤醒定时器";
                                        font-size: 10.5px;
                                        font-weight: 700;
                                        color: AppTheme.text_primary;
                                        vertical-alignment: center;
                                    }
                                }
                                Text {
                                    text: "阻止任务计划程序等利用定时器唤醒焖烧";
                                    font-size: 8.5px;
                                    color: AppTheme.text_muted;
                                }
                            }

                            SwitchToggle {
                                checked: root.sleep_disable_wake_timers;
                                active_color: #10b981;
                                y: (parent.height - self.height) / 2;
                                toggled => { root.toggle_sleep_guard_option("disable_wake_timers"); }
