                    // Policy 5: 启用 ACPI 深度睡眠
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 48px;
                        border-radius: 6px;
                        background: t_p5.has-hover ? AppTheme.surface_card_hover : AppTheme.surface_card;
                        border-width: 1px;
                        border-color: root.sleep_deep_sleep ? #a855f760 : AppTheme.border_subtle;

                        t_p5 := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.toggle_sleep_guard_option("deep_sleep"); }
                        }

                        HorizontalLayout {
                            padding-left: 9px;
                            padding-right: 9px;
                            alignment: space-between;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;
                                HorizontalLayout {
                                    spacing: 5px;
                                    Image {
                                        source: @image-url("../../assets/icons/moon.svg");
                                        width: 12px;
                                        height: 12px;
                                        colorize: #c084fc;
