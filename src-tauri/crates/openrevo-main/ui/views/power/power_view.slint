                        border-width: 1px;
                        border-color: root.sleep_disconnect_net ? #38bdf860 : AppTheme.border_subtle;

                        t_p1 := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.toggle_sleep_guard_option("disconnect_net"); }
                        }

                        HorizontalLayout {
                            padding-left: 9px;
                            padding-right: 9px;
                            alignment: space-between;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;
                                HorizontalLayout {
                                    spacing: 5px;
                                    Image {
                                        source: @image-url("../../assets/icons/globe.svg");
                                        width: 12px;
                                        height: 12px;
                                        colorize: #38bdf8;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: "待机断开网络连接";
                                        font-size: 10.5px;
