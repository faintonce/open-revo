{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenRevo",
  "version": "0.9.4",
  "identifier": "com.openrevo.controlcenter",
  "build": {
    "beforeDevCommand": "pnpm.cmd dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm.cmd build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenRevo",
        "label": "main",
        "width": 395,
        "height": 622,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "center": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
