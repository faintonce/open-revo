{
  "$schema": "https://openrevo.org/schemas/model-driver.v1.json",
  "id": "mechrevo_wujie_14_bld",
  "name": "MECHREVO Wujie 14 Pro (AMD Ryzen 7000 / Baolongda T140)",
  "version": "1.0.0",
  "author": "OpenRevo Core Team",
  "identity": {
    "form_factor": "thin_light",
    "ui_preset": "ultrabook_compact",
    "dmi_match": {
      "vendor": "MECHREVO",
      "board_products": ["WUJIE14 Series-PHX*", "T140*", "T140_PHX*"],
      "product_names": ["WUJIE14 PRO*", "WUJIE 14 PRO*"]
    }
  },
  "capabilities": {
    "discrete_gpu": false,
    "water_cooling": false,
    "fan_custom_curve": false,
    "battery_charge_limit": false,
    "power_modes": ["office", "balance", "turbo"],
    "power_mode_watts": {
      "office": 25,
      "balance": 35,
      "turbo": 54
    },
    "rgb_keyboard": {
      "supported": true,
      "type": "monochrome_stepped",
      "steps": [1, 2, 3],
      "hardware_autonomous": false,
      "hotkey_osd_only": false,
      "sleep_timeout_supported": false,
      "timeout_options_seconds": []
    },
    "osd_notifications": {
      "power_mode_switch": true,
      "backlight_level_change": true
    }
  },
  "channels": {
    "wmi_mailbox": {
      "type": "wmi_mailbox",
      "namespace": "root\\WMI",
      "class_name": "MICommonInterface",
      "method_name": "MiInterface",
      "buffer_sizes": {
        "in": 32,
        "out": 32
      }
    }
  },
  "actions": {
    "read_fan_rpm": {
      "channel": "wmi_mailbox",
      "input": [0, 250, 0, 13, 0],
      "parse": {
        "cpu_rpm": { "offset": 4, "type": "u16_le" },
        "gpu_rpm": { "offset": 6, "type": "u16_le" }
      }
    },
    "read_cpu_temp": {
      "channel": "wmi_mailbox",
      "input": [0, 250, 0, 22, 0],
      "parse": {
        "cpu_temp": { "offset": 4, "type": "u8" }
      }
    },
    "get_power_mode": {
      "channel": "wmi_mailbox",
      "input": [0, 250, 0, 8, 0],
      "parse": {
        "mode_code": { "offset": 4, "type": "u8" }
      },
      "mapping": {
        "2": "office",
        "1": "balance",
        "0": "turbo"
      }
    },
    "set_power_mode": {
      "office": [0, 251, 0, 8, 2],
      "balance": [0, 251, 0, 8, 1],
      "turbo": [0, 251, 0, 8, 0]
    },
    "set_keyboard_backlight": {
      "channel": "wmi_mailbox",
      "input": [0, 251, 0, 18, "{val}"]
    },
    "switch_touchpad_on": {
      "channel": "wmi_mailbox",
      "input": [0, 251, 0, 12, 0]
    },
    "switch_touchpad_off": {
      "channel": "wmi_mailbox",
      "input": [0, 251, 0, 12, 1]
    }
  },
  "guardrails": {
    "safe_commands_only": true,
    "pl1_watts_limit": {
      "min": 15,
      "max": 54
    }
  }
}
