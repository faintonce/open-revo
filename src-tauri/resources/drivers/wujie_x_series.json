{
  "$schema": "https://openrevo.org/schemas/model-driver.v1.json",
  "id": "mechrevo_wujie_x_series",
  "name": "MECHREVO Wujie 14X / 15X / 16X Series (AMD Platform)",
  "version": "1.0.0",
  "author": "OpenRevo Core Team",
  "identity": {
    "form_factor": "thin_light",
    "ui_preset": "ultrabook_compact",
    "dmi_match": {
      "vendor": "MECHREVO",
      "board_products": [
        "WUJIE14-GX*",
        "WUJIE Series-X5*",
        "WUJIE Series-X6*",
        "*GX4HRXL*",
        "*X5SP4NAG*",
        "*WUJIE*14X*",
        "*WUJIE*15X*",
        "*WUJIE*16X*"
      ],
      "product_names": [
        "WUJIE14X*",
        "WUJIE15X*",
        "WUJIE16X*",
        "WUJIE 14X*",
        "WUJIE 15X*",
        "WUJIE 16X*",
        "WUJIE Series*"
      ]
    }
  },
  "capabilities": {
    "discrete_gpu": false,
    "gpu_mux_type": null,
    "supported_gpu_modes": [],
    "water_cooling": false,
    "fan_custom_curve": true,
    "fan_independent_channels": false,
    "fan_ramp_rate": true,
    "fan_control_mode": "discrete_table_16",
    "fan_boost_mode": "hardware_toggle",
    "max_fan_rpm": 5800,
    "cpu_vendor": "amd",
    "cpu_tuning_type": "none",
    "cpu_supports_fppt": false,
    "gpu_power_tuning_mode": "none",
    "battery_charge_limit": true,
    "fn_lock": true,
    "power_modes": ["office", "balance", "turbo", "custom"],
    "power_mode_watts": {
      "office": 25,
      "balance": 45,
      "turbo": 65,
      "custom": 65
    },
    "rgb_keyboard": {
      "supported": true,
      "type": "monochrome_stepped",
      "steps": [1, 2, 3],
      "hardware_autonomous": false,
      "hotkey_osd_only": false,
      "sleep_timeout_supported": false,
      "timeout_options_seconds": []
    },
    "osd_notifications": {
      "power_mode_switch": true,
      "backlight_level_change": true
    }
  },
  "channels": {
    "acpi_driver": {
      "type": "acpi_ioctl",
      "device_path": "\\\\.\\ACPIDriver",
      "read_code": "0x222000",
      "write_code": "0x222004"
    }
  },
  "actions": {
    "set_power_mode": {
      "office": [25],
      "balance": [45],
      "turbo": [65],
      "custom": [65]
    }
  },
  "guardrails": {
    "safe_commands_only": true,
    "pl1_watts_limit": {
      "min": 15,
      "max": 65
    }
  }
}
