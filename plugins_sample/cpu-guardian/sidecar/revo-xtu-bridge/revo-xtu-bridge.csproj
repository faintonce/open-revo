<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>RevoXtuBridge</RootNamespace>
    <AssemblyName>revo-xtu-bridge</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="IntelOverclockingSDK">
      <HintPath>lib\IntelOverclockingSDK.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="ProfileHelperModel">
      <HintPath>lib\ProfileHelperModel.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="XtuCommon">
      <HintPath>lib\XtuCommon.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="PlatformDetection">
      <HintPath>lib\PlatformDetection.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="System.ServiceModel" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

</Project>
