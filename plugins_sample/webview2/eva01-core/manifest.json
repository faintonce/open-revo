{
  "id": "eva01-core",
  "name": "EVA-01 初号机 S2 能量核心",
  "version": "2.0.0",
  "author": "OpenRevo Official & Community",
  "description": "官方标杆级异形拟态机甲桌宠挂件，支持结温脉冲呼吸、风扇转速联动、离电倒计时、双态极简折叠与一键强冷暴走切换。",
  "plugin_type": "widget",
  "entry": "index.html",
  "min_host_version": "0.9.3",
  "window": {
    "width": 260,
    "height": 190,
    "transparent": true,
    "always_on_top": true,
    "resizable": false,
    "skip_taskbar": true
  },
  "telemetry": {
    "enabled": true,
    "desiredIntervalMs": 1500,
    "sensors": [
      "cpu_temp",
      "cpu_fan_rpm",
      "cpu_power_w",
      "power_mode",
      "fan_boost",
      "battery_level",
      "is_charging"
    ]
  },
  "permissions": [
    "telemetry:read",
    "fan:control",
    "power:control"
  ]
}