{
  "id": "battery-hardware-limit",
  "name": "电池充电上限守护者",
  "version": "2.5.1",
  "author": "OpenRevo Official & Community",
  "description": "官方演示插件：基于微内核硬件网关的多协议底层限充调控中心，支持同方门控持续钉住法(Pin & Keep-Alive)与传统脉冲存储法，自适应0x04/0x05硬件门控探测，自由设定 1~100% 充电阈值。",
  "type": "tab",
  "min_host_version": "0.9.8",
  "window": {
    "width": 960,
    "height": 680,
    "resizable": true,
    "decorations": true,
    "transparent": false,
    "always_on_top": false
  },
  "telemetry": {
    "enabled": true,
    "sensors": [
      "battery_level",
      "is_charging",
      "is_ac_online",
      "is_dc_online",
      "battery_limit"
    ]
  },
  "watchers": [
    {
      "id": "battery-limit-startup-guard",
      "name": "微内核开机与电源接入自愈守护 (声明式底层动作)",
      "enabled": true,
      "cooldown_ms": 1000,
      "when": {
        "type": "any",
        "conditions": [
          {
            "type": "startup"
          },
          {
            "type": "power_event",
            "event": "ac_connected"
          }
        ]
      },
      "actions": [
        {
          "action": "raw_ec_write",
          "address": "0x07B9",
          "value": 80
        },
        {
          "action": "raw_ec_write",
          "address": "0x07C3",
          "value": 4
        },
        {
          "action": "delay_ms",
          "duration": 200
        },
        {
          "action": "raw_ec_write",
          "address": "0x07B9",
          "value": 80
        }
      ]
    },
    {
      "id": "battery-limit-gate-keepalive",
      "name": "门控持续保持心跳 (Pin & Keep-Alive)",
      "enabled": true,
      "cooldown_ms": 0,
      "when": {
        "type": "interval",
        "every_ms": 4000
      },
      "actions": [
        {
          "action": "raw_ec_write",
          "address": "0x07B9",
          "value": 80
        },
        {
          "action": "raw_ec_write",
          "address": "0x07C3",
          "value": 4
        }
      ]
    }
  ],
  "permissions": [
    "telemetry:read",
    "raw_ec:write",
    "raw_ec:read"
  ],
  "config": {
    "default_mode": "pin",
    "strategies": {
      "tongfang_pin": {
        "name": "同方门控持续保持法 (Pin & Keep-Alive，现代机型推荐)",
        "protocol": "TongfangDirectEc",
        "limit_reg": 1977,
        "gate_reg": 1987,
        "probe_order": [
          4,
          5
        ],
        "keepalive_interval_ms": 4000,
        "status_reg": 1858,
        "status_bit": 2
      },
      "tongfang_pulse": {
        "name": "同方系脉冲触发存储法 (老款固件 NVRAM 兼容)",
        "protocol": "TongfangDirectEc",
        "limit_reg": 1977,
        "gate_reg": 1987,
        "pulse_val_gaming": 5,
        "pulse_val_thin": 4,
        "pulse_hold_ms": 2500,
        "gate_settle_ms": 7000,
        "status_reg": 1858,
        "status_bit": 2
      },
      "generic_wmi": {
        "name": "通用 ACPI-WMI MULONG 邮箱通道",
        "protocol": "GenericAcpiWmi",
        "limit_reg": 1977,
        "gate_reg": 1987,
        "storage_reg": 2175
      },
      "bld_mailbox": {
        "name": "宝龙达 WMI Mailbox 协议",
        "protocol": "BldWmiMailbox",
        "cmd_battery": 16,
        "subcmd_limit": 13,
        "subcmd_restore": 15
      }
    }
  }
}